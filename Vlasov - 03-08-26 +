Реализация на Python
Ниже — код, который:
•	извлекает слова,
•	считает для каждого слова, сколько каких букв нужно,
•	реализует функцию расчёта ожидаемой прибыли для заданного запаса букв,
•	применяет жадный алгоритм для подбора оптимального запаса,
•	выводит словарь запаса букв и ожидаемую прибыль.
python
ПереноситьСвернутьКопировать
from collections import Counter

# Четверостишие
text = """
Во глубине сибирских руд
Храните гордое терпенье
Не пропадет ваш скорбный труд
И дум высокое стремленье
"""

# Извлечение слов: оставляем только буквы, разбиваем по пробелам, приводим к нижнему регистру
import re
words = re.findall(r'[а-яё]+', text.lower())

# Для каждого слова — сколько каких букв нужно
word_counts = [Counter(w) for w in words]

# Уникальные буквы, которые вообще встречаются
all_letters = sorted(set(''.join(words)))

def expected_profit(stock):
    """
    stock: dict {letter: count}
    Возвращает ожидаемую дневную прибыль.
    """
    total_profit = 0
    n = len(words)
    
    for wc in word_counts:
        # Для данного слова проверяем, сколько букв не хватает
        missing = 0
        for letter, needed in wc.items():
            have = stock.get(letter, 0)
            if have < needed:
                missing += (needed - have)
        
        if missing == 0:
            profit = 40
        elif missing == 1:
            profit = 38  # 40 - 2 за экспресс-доставку
        else:
            profit = -10  # неустойка
        
        total_profit += profit
    
    # Вычитаем стоимость хранения: 1 рубль за каждую букву на складе
    storage_cost = sum(stock.values())
    
    return total_profit / n - storage_cost

# Жадный алгоритм подбора запаса
stock = {letter: 0 for letter in all_letters}

while True:
    best_gain = 0
    best_letter = None
    
    # Пробуем добавить +1 к каждой букве
    for letter in all_letters:
        stock[letter] += 1
        new_profit = expected_profit(stock)
        stock[letter] -= 1
        
        # Текущая прибыль без этой дополнительной буквы
        current_profit = expected_profit(stock)
        gain = new_profit - current_profit
        
        if gain > best_gain:
            best_gain = gain
            best_letter = letter
    
    if best_gain > 0 and best_letter is not None:
        stock[best_letter] += 1
    else:
        break

optimal_stock = stock
optimal_profit = expected_profit(optimal_stock)

print("Оптимальный запас букв на складе:")
print(optimal_stock)
print(f"Ожидаемая дневная прибыль: {optimal_profit:.2f} руб.")
________________________________________
Что вы получите на выходе
После запуска этого кода вы получите:
1.	Словарь вида { '<буква>': количество } — это и есть оптимальный набор букв на складе.
2.	Ожидаемую дневную прибыль при таком запасе.
Поскольку точный результат зависит от работы жадного алгоритма (и может слегка отличаться при разных реализациях), лучше запустить код локально. Но я могу также привести примерный результат, который получается при таком подходе.
