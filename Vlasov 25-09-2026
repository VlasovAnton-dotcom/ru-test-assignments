import org.junit.jupiter.api.Test;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class WithProblemsTests {

    @Test
    public void testSum() {
        List<Integer> numbers = Arrays.asList(1, 2, 3, 4, 5);
        int actualSum = numbers.stream().mapToInt(Integer::intValue).sum(); // Исправлено суммирование
        assertEquals(15, actualSum);
    }

    @Test
    public void testMax() {
        List<Integer> numbers = Arrays.asList(-1, 0, 1, 2, 3);
        int actualMax = numbers.stream().mapToInt(Integer::intValue).max().orElseThrow(); // Исправлено получение максимума
        assertEquals(3, actualMax);
    }

    @Test
    public void testMin() {
        List<Integer> numbers = Arrays.asList(-1, 0, 1, 2, 3);
        int actualMin = numbers.stream().mapToInt(Integer::intValue).min().orElseThrow(); // Исправлено получение минимума
        assertEquals(-1, actualMin);
    }

    @Test
    public void testFilterEvenNumbers() {
        List<Integer> numbers = Arrays.asList(1, 2, 3, 4, 5);
        List<Integer> filtered = numbers.stream().filter(num -> num % 2 == 0).toList(); // Исправлено фильтрование
        assertEquals(Arrays.asList(2, 4), filtered);
    }

    @Test
    public void testMapMultiplyTwo() {
        List<Integer> numbers = Arrays.asList(1, 2, 3, 4, 5);
        List<Integer> mapped = numbers.stream().map(num -> num * 2).toList(); // Исправлено умножение
        assertEquals(Arrays.asList(2, 4, 6, 8, 10), mapped);
    }
}
```

#### 2. Класс `ReadFileTests.java`

