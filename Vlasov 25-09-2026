import org.junit.jupiter.api.Test;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;

public class ReadFileTests {

    @Test
    public void checkSecondLineContainsWordAlloha() throws Exception {
        Path path = Paths.get(getClass().getResource("/ReadFileTests.txt").toURI());
        List<String> lines = Files.readAllLines(path);
        assertTrue(lines.size() >= 2, "Файл должен иметь минимум две строки");
        assertTrue(lines.get(1).contains("аллоха"), "Вторая строка должна содержать слово \"аллоха\"");
    }
}
```

#### 3. SQL-запрос для подсчета доли заказов с промокодами

```sql
-- resources/Task3.sql
WITH TotalOrders AS (
    SELECT COUNT(*) AS total_orders FROM orders
),
PromoOrders AS (
    SELECT COUNT(*) AS promo_orders FROM orders WHERE promocode_id IS NOT NULL
)
SELECT ROUND(CAST(promo_orders AS FLOAT)/total_orders * 100, 2) AS percentage
FROM TotalOrders, PromoOrders;
```

