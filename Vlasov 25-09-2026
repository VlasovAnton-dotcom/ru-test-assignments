#### 5*. Реализация иерархии классов с демонстрацией принципов ООП

```java
// Абстрактный класс Robot
abstract class Robot {
    private final EnergyType energyType;
    private double fuelLevel;

    public Robot(EnergyType energyType) {
        this.energyType = energyType;
        this.fuelLevel = 100.0; // начальный заряд
    }

    public abstract void work();

    public void refillFuel() {
        System.out.println("Заправляю робота...");
        energyType.refill(this);
    }

    public double getFuelLevel() {
        return fuelLevel;
    }

    public void setFuelLevel(double level) {
        this.fuelLevel = level;
    }
}

enum EnergyType {
    ATOMIC {
        @Override
        public void refill(Robot robot) {
            System.out.println("Заряжаю атомным реактором каждые 50 лет.");
            robot.setFuelLevel(100.0);
        }
    },
    INTERNAL_COMBUSTION {
        @Override
        public void refill(Robot robot) {
            System.out.println("Заправляю бензином/дизелем по мере опустошения бака.");
            robot.setFuelLevel(robot.getFuelLevel() + 50.0);
        }
    },
    ELECTRIC {
        @Override
        public void refill(Robot robot) {
            System.out.println("Заряжаюсь электричеством при уровне заряда ниже 20%.");
            robot.setFuelLevel(100.0);
        }
    };

    public abstract void refill(Robot robot);
}

// Конкретные виды роботов
class BattleRobot extends Robot {
    public BattleRobot(EnergyType energyType) {
        super(energyType);
    }

    @Override
    public void work() {
        System.out.println("Стреляю из оружия!");
    }
}

class WelderRobot extends Robot {
    public WelderRobot(EnergyType energyType) {
        super(energyType);
    }

    @Override
    public void work() {
        System.out.println("Свариваю деталь!");
    }
}

class CookingRobot extends Robot {
    public CookingRobot(EnergyType energyType) {
        super(energyType);
    }

    @Override
    public void work() {
        System.out.println("Готовлю еду!");
    }
}

// Демонстрация работы роботов
public class RobotsDemo {
    public static void main(String[] args) {
        Robot battleAtomic = new BattleRobot(EnergyType.ATOMIC);
        Robot welderElectric = new WelderRobot(EnergyType.ELECTRIC);
        Robot cookDiesel = new CookingRobot(EnergyType.INTERNAL_COMBUSTION);

        // Положительная проверка
        battleAtomic.work(); // Стрельба
        battleAtomic.refillFuel(); // Зарядка атомной энергией

        welderElectric.work(); // Сварка
        welderElectric.refillFuel(); // Электрозаправка

        cookDiesel.work(); // Готовка еды
        cookDiesel.refillFuel(); // Топливозаправка дизельным двигателем

        // Негативная проверка
        // Попытка заправить боевого робота электрическим способом
        battleAtomic.setEnergyType(EnergyType.ELECTRIC);
        battleAtomic.refillFuel(); // Должно вызвать неправильное действие
    }
}

