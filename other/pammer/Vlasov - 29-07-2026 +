class ElectricFuel implements Fuel {
    private double charge; // от 0 до 100

    public ElectricFuel(double charge) {
        this.charge = charge;
    }

    @Override
    public void consume() {
        charge -= 2.0; // условное потребление
        if (charge < 0) charge = 0;
    }

    @Override
    public boolean needsRefuel() {
        return charge <= 20.0;
    }

    @Override
    public void refuel() {
        if (!needsRefuel()) {
            throw new IllegalStateException("Заряд выше 20%, заправка не требуется");
        }
        charge = 100.0;
        System.out.println("Робот полностью заряжен.");
    }
}
