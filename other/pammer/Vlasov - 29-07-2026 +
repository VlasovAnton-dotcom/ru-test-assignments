abstract class Robot {
    protected final String name;
    protected final FuelType fuelType;
    protected Fuel fuel;

    protected Robot(String name, FuelType fuelType, Fuel fuel) {
        this.name = name;
        this.fuelType = fuelType;
        this.fuel = fuel;
    }

    // Абстрактное поведение работы
    public abstract void work();

    // Заправка: делегируем логику объекту Fuel
    public void requestRefuel() {
        if (fuel.needsRefuel()) {
            fuel.refuel();
        } else {
            System.out.println(name + ": заправка не требуется.");
        }
    }

    // Потребление энергии
    protected void consumeEnergy() {
        fuel.consume();
    }
}
