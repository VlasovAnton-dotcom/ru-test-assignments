class AtomicFuel implements Fuel {
    private int yearsSinceRefuel;

    public AtomicFuel() {
        this.yearsSinceRefuel = 0;
    }

    @Override
    public void consume() {
        yearsSinceRefuel++;
    }

    @Override
    public boolean needsRefuel() {
        return yearsSinceRefuel >= 50;
    }

    @Override
    public void refuel() {
        if (yearsSinceRefuel < 50) {
            throw new IllegalStateException("Атомный реактор не требует заправки раньше 50 лет");
        }
        yearsSinceRefuel = 0;
        System.out.println("Атомный реактор перезапущен.");
    }
}
