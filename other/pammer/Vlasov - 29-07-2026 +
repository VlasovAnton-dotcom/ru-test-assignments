class InternalCombustionFuel implements Fuel {
    private double capacity;
    private double current;

    public InternalCombustionFuel(double capacity) {
        this.capacity = capacity;
        this.current = capacity;
    }

    @Override
    public void consume() {
        current -= 0.5; // условное потребление
        if (current < 0) current = 0;
    }

    @Override
    public boolean needsRefuel() {
        return current <= 0.1 * capacity;
    }

    @Override
    public void refuel() {
        if (!needsRefuel()) {
            throw new IllegalStateException("Бак не пуст, заправка не требуется");
        }
        current = capacity;
        System.out.println("Бак заправлен топливом.");
    }
}
