public class Main {
    public static void main(String[] args) {
        Robot[] robots = new Robot[9];

        // Combat
        robots[0] = new CombatRobot("Combat-A", FuelType.ATOMIC, new AtomicFuel());
        robots[1] = new CombatRobot("Combat-IC", FuelType.INTERNAL_COMBUSTION, new InternalCombustionFuel(50.0));
        robots[2] = new CombatRobot("Combat-E", FuelType.ELECTRIC, new ElectricFuel(100.0));

        // Welding
        robots[3] = new WeldingRobot("Weld-A", FuelType.ATOMIC, new AtomicFuel());
        robots[4] = new WeldingRobot("Weld-IC", FuelType.INTERNAL_COMBUSTION, new InternalCombustionFuel(40.0));
        robots[5] = new WeldingRobot("Weld-E", FuelType.ELECTRIC, new ElectricFuel(80.0));

        // Cooking
        robots[6] = new CookingRobot("Cook-A", FuelType.ATOMIC, new AtomicFuel());
        robots[7] = new CookingRobot("Cook-IC", FuelType.INTERNAL_COMBUSTION, new InternalCombustionFuel(60.0));
        robots[8] = new CookingRobot("Cook-E", FuelType.ELECTRIC, new ElectricFuel(90.0));

        // Работа всех роботов
        for (Robot r : robots) {
            r.work();
        }

        // Имитация расхода и запрос заправки
        for (int i = 0; i < 60; i++) {
            for (Robot r : robots) {
                r.consumeEnergy(); // ускоряем расход для демонстрации
            }
        }

        System.out.println("--- Запрос заправки ---");
        for (Robot r : robots) {
            r.requestRefuel();
        }

        // Негативная проверка: попытка заправить, когда не нужно
        System.out.println("--- Негативная проверка (заправка без необходимости) ---");
        try {
            robots[0].requestRefuel(); // у атомного робота ещё не прошло 50 «лет»
        } catch (IllegalStateException e) {
            System.out.println("Поймано ожидаемое исключение: " + e.getMessage());
        }

        // Негативная проверка: «не по назначению» — просто вызов work() у робота,
        // но в рамках этой модели все роботы делают свою работу корректно.
        // Чтобы показать «не по назначению», можно добавить метод, который явно
        // нарушает назначение, например, боевой робот пытается сварить деталь.
        System.out.println("--- Демонстрация использования не по назначению ---");
        robots[0].work(); // боевой робот делает свою работу — это ОК
        // Для демонстрации «не по назначению» можно добавить отдельный метод,
        // например, combatRobot.weld(), который выбросит исключение.
    }
}
