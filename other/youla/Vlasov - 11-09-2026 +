Исправленный вариант
js
ПереноситьСвернутьКопировать
function checkDate(timestamp) {
  const date = new Date(timestamp * 1000);
  const now = new Date();

  const day = date.getDate();
  const month = date.getMonth();          // 0–11
  const year = date.getFullYear();

  const currentDay = now.getDate();
  const currentMonth = now.getMonth();    // тоже 0–11, без +1
  const currentYear = now.getFullYear();

  const isSameDate =
    year === currentYear &&
    month === currentMonth &&
    day === currentDay;

  const hour = date.getHours();
  const dayPeriod = hour >= 12 ? 'pm' : 'am';

  return {
    isSameDate,
    dayPeriod
  };
}
________________________________________
Важное уточнение про «одну дату»
Этот код сравнивает календарные даты (день, месяц, год), игнорируя время. То есть timestamp из 14:30 и timestamp из 23:59 одного и того же дня будут считаться «той же датой». Если это именно то, что нужно — всё ок.
Если же задача была в том, чтобы проверить, попадает ли момент времени в диапазон «сегодня» с учётом часовых поясов или начала/конца дня — логику придётся усложнить (например, сравнивать диапазоны от начала до конца текущих суток).

