Реализация основных компонентов
Модель задачи (models/Task.js)
Создадим модель задачи с использованием MobX:
javascriptКопировать
import { makeObservable, observable } from 'mobx';

class Task {
    id = Math.random().toString(36).substr(2, 9);
    title = '';
    description = '';
    isImportant = false;
    isCompleted = false;
    dueDate = new Date();

    constructor(title, description, isImportant, dueDate) {
        this.title = title;
        this.description = description;
        this.isImportant = isImportant;
        this.dueDate = dueDate;
        makeObservable(this, {
            title: observable,
            description: observable,
            isImportant: observable,
            isCompleted: observable,
            dueDate: observable,
        });
    }
}

export default Task;
Хранилище задач (store/TasksStore.js)
Реализуем хранилище задач с помощью MobX:
javascriptКопировать
import { makeAutoObservable } from "mobx";
import AsyncStorage from "@react-native-async-storage/async-storage";
import Task from "../models/Task";

class TasksStore {
    tasks = [];

    constructor() {
        makeAutoObservable(this);
        this.loadTasksFromStorage();
    }

    addTask(task) {
        this.tasks.push(task);
        this.saveTasksToStorage();
    }

    removeTask(id) {
        this.tasks = this.tasks.filter(t => t.id !== id);
        this.saveTasksToStorage();
    }

    updateTask(updatedTask) {
        const index = this.tasks.findIndex(t => t.id === updatedTask.id);
        if (index !== -1) {
            this.tasks[index] = updatedTask;
            this.saveTasksToStorage();
        }
    }

    toggleCompletion(id) {
        const task = this.tasks.find(t => t.id === id);
        if (task) {
            task.isCompleted = !task.isCompleted;
            this.saveTasksToStorage();
        }
    }

    loadTasksFromStorage = async () => {
        try {
            const jsonValue = await AsyncStorage.getItem('@tasks');
            if (jsonValue != null) {
                this.tasks = JSON.parse(jsonValue).map(
                    ({id, title, description, isImportant, isCompleted, dueDate}) =>
                        new Task(title, description, isImportant, new Date(dueDate))
                );
            }
        } catch(e) {
            console.error('Ошибка при загрузке задач:', e);
        }
    };

    saveTasksToStorage = async () => {
        try {
            const jsonValue = JSON.stringify(this.tasks.map(t => ({
                id: t.id,
                title: t.title,
                description: t.description,
                isImportant: t.isImportant,
                isCompleted: t.isCompleted,
                dueDate: t.dueDate.toISOString()
            })));
            await AsyncStorage.setItem('@tasks', jsonValue);
        } catch(e) {
            console.error('Ошибка при сохранении задач:', e);
        }
    };
}

const tasksStore = new TasksStore();
export default tasksStore;
