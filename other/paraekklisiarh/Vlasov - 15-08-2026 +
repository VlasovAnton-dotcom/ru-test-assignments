🔖 Пример реализации компонента списка задач:
typescriptКопировать
import { observer } from 'mobx-react-lite';
import { FlatList, Text, View } from 'react-native';
import { Card, Button, Checkbox } from 'react-native-paper';
import styled from 'styled-components/native';

const TaskItem = observer(({ task }) => (
  <Card style={task.dueDate && new Date() > task.dueDate ? styles.overdue : null}>
    <Card.Content>
      <Text>{task.title}</Text>
      <Checkbox status={task.completed ? 'checked' : 'unchecked'} onPress={() => toggleCompleted(task.id)} />
    </Card.Content>
  </Card>
));

const HomeScreen = () => {
  const tasksStore = useTasksStore();
  
  return (
    <View>
      <FlatList 
        data={tasksStore.filteredTasks}
        renderItem={({ item }) => <TaskItem task={item} />}
        keyExtractor={(item) => item.id}
      />
      
      {/* Добавление кнопки для перехода к добавлению новой задачи */}
      <Button icon="plus" mode="contained" onPress={() => navigation.navigate('AddTask')}>Добавить задачу</Button>
    </View>
  );
};

export default observer(HomeScreen);

// стили для выделения просроченных задач
const styles = StyleSheet.create({
  overdue: {
    backgroundColor: '#ffcccc', // светло-красный цвет фона для просроченных задач
  },
});
