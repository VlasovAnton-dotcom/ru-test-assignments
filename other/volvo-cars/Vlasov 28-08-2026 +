from flask import Flask, request, jsonify
app = Flask(__name__)

@app.route('/calculate_tax', methods=['POST'])
def calculate_tax():
    # Получаем даты въезда из запроса
    data = request.json.get('dates')
    
    # Вызываем функцию расчета налога
