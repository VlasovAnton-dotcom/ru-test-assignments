// app/javascript/controllers/equation_controller.js
import { Controller } from "@hotwired/stimulus"
import { patch } from "@rails/request.js"

export default class extends Controller {
  static targets = ["typeSelect"]

  connect() {
    this.renderForm()
  }

  toggleForm() {
    this.renderForm()
  }

  async renderForm() {
    const response = await fetch(`/solver/${this.typeSelectTarget.value}_form.html`)
    document.getElementById('form-container').innerHTML = await response.text()
  }

  async solve(event) {
    event.preventDefault()
    const form = event.target
    const url = form.action
    const method = form.method.toLowerCase()
    
    // Сбор параметров из кастомных атрибутов data-
    const payload = {}
    form.querySelectorAll('[data-coeff]').forEach(input => {
      payload[input.dataset.coeff] = input.value
    })

    try {
      const res = await patch(url, { 
        body: JSON.stringify({ type: this.typeSelectTarget.value, data: payload }),
        responseKind: 'json',
        headers: { 'Content-Type': 'application/json' }
      })
      
      if (res.status === 200) {
        this.displayResult(res.body)
      } else {
        this.displayError(res.body.message || 'Ошибка сети')
      }
    } catch (e) {
      this.displayError(e.message)
    }
  }

  displayResult(data) {
    // Дружественный вывод
    let html = '<h3>Результат:</h3>'
    if (data.data.roots && data.data.roots.length > 0) {
      html += `<p>Корни: ${data.data.roots.join(', ')}</p>`
    }
    if (data.data.discriminant) {
      html += `<p>Дискриминант: ${data.data.discriminant}</p>`
    }
    if (data.data.message) {
      html += `<p><em>${data.data.message}</em></p>`
    }
    document.getElementById('result-container').innerHTML = html
  }

  displayError(message) {
    document.getElementById('result-container').innerHTML = `<p style="color: red;">Ошибка: ${message}</p>`
  }
}
(Примечание: файлы частичных форм _linear_form.html.erb и _quadratic_form.html.erb содержат поля ввода с атрибутами data-coeff="a" и т.д.)
в) CSS
Рекомендуется использовать TailwindCSS (стандарт де-факто для новых проектов на Rails) или SCSS-модули. Страницы делятся на три состояния: [data-page="choice"], [data-page="input"], [data-page="result"].
г) Валидация на стороне клиента
Перед отправкой AJAX-запроса JavaScript проверяет:
•	Поля не пусты.
•	Значения проходят проверку регулярного выражения /^-?\d+(\.\d+)?$/.
•	Для квадратного уравнения коэффициент a≠0a \neq 0a=0. При ошибке валидации запрос на Бэкенд не уходит, пользователю подсвечивается конкретное поле.
4. Тестирование
•	Бэкенд (RSpec): Unit-тесты для каждого класса уравнения (проверка дискриминанта, нуля, комплексных чисел исключаются согласно логике), тесты фабрики, интеграционные тесты эндпоинтов (статус 200, 401 при отсутствии ключа, 422 при неверном формате).
•	Фронтенд (RSpec + Capybara + Cucumber): Feature specs для прохождения полного цикла выбора типа -> заполнения формы -> получения ответа. Проверка отображения ошибок 500 от Бэкенда. Cucumber-сценарии для описания пользовательских путей (BDD).
•	Сквозное (E2E): При необходимости можно добавить Playwright для проверки взаимодействия двух запущенных приложений.
5. Обработка исключительных ситуаций
•	Неверный тип аргументов (буквы вместо цифр): Валидируется Regex на фронте. На бэкенде попытка преобразования к Float выбросит ArgumentError, который перехватывается общим rescue и отдается фронту со статусом 422.
•	Недостаточное количество параметров: Проверяется в каждом классе уравнения через вычитание массивов ключей. Ошибка 422.
•	Логические ошибки (a=0a=0a=0 для квадратного): Специфическая ошибка бизнес-логики, статус 422.
•	Падение Бэкенда (500): Rescue-блок на Бэкенде ловит непредвиденные ошибки, залогирует их (например, в Sentry) и возвращает фронтэнду заглушку {"status": "error", "message": "..."}. Фронтенд должен уметь отличать ошибку валидации (поле красное) от системной ошибки (баннер вверху страницы).
6. Развертывание (Deployment)
•	Приложения упаковываются в Docker-образы.
•	Nginx работает как обратный прокси (Reverse Proxy), маршрутизируя запросы с /api/* на порт Бэкенда (Sinatra), а все остальные — на порт Фронтенда (Rails/Puma).
•	Рекомендуется использование PostgreSQL для хранения сессий Frontend-приложения и Redis для фоновых задач, если они появятся.

