# app/models/equation_factory.rb
class EquationFactory
  def self.build(type:, params:)
    case type
    when 'linear'
      LinearEquation.new(params)
    when 'quadratic'
      QuadraticEquation.new(params)
    else
      raise ArgumentError, "Unknown equation type"
    end
  end
end

# app/models/equation.rb (базовый контракт)
class Equation
  attr_reader :params
  
  def initialize(params)
    @params = params.transform_keys(&:to_s)
    validate_params!
  end

  def solve
    raise NotImplementedError
  end

  protected
  def validate_params!
    # Базовая проверка наличия ключей реализуется в наследниках
  end
end

# app/models/linear_equation.rb
class LinearEquation < Equation
  REQUIRED_KEYS = %w[a b].freeze

  def validate_params!
    missing = REQUIRED_KEYS - params.keys
    raise ArgumentError, "Missing keys: #{missing.join(', ')}" unless missing.empty?
    
    check_numeric!(params['a'], 'a')
    check_numeric!(params['b'], 'b')
    raise ArgumentError, 'Coefficient a cannot be zero' if params['a'].to_f.zero?
  end

  def solve
    { root: (-params['b'].to_f / params['a'].to_f).round(4) }
  end

  private
  def check_numeric!(value, name)
    Float(value)
  rescue ArgumentError, TypeError
    raise ArgumentError, "Parameter '#{name}' must be numeric"
  end
end

# app/models/quadratic_equation.rb
class QuadraticEquation < Equation
  REQUIRED_KEYS = %w[a b c].freeze

  def validate_params!
    missing = REQUIRED_KEYS - params.keys
    raise ArgumentError, "Missing keys: #{missing.join(', ')}" unless missing.empty?
    
    REQUIRED_KEYS.each { |k| check_numeric!(params[k], k) }
    raise ArgumentError, 'Coefficient a cannot be zero' if params['a'].to_f.zero?
  end

  def solve
    a, b, c = params.values_at('a', 'b', 'c').map(&:to_f)
    d = b**2 - 4 * a * c
    
    if d < 0
      { roots: [], discriminant: d.round(4), message: 'No real roots' }
    elsif d.zero
      { roots: [(-b / (2 * a)).round(4)], discriminant: d.round(4) }
    else
      sqrt_d = Math.sqrt(d)
      x1 = ((-b + sqrt_d) / (2 * a)).round(4)
      x2 = ((-b - sqrt_d) / (2 * a)).round(4)
      { roots: [x1, x2].sort, discriminant: d.round(4) }
    end
  end
end
б) Точка входа (Grape DSL предпочтительнее чистого Sinatra для масштабируемости)
rubyКопировать
# app/api/v1/root.rb
module V1
  class Root < Grape::API
    format :json
    prefix :api
    version :v1
    
    helpers do
      def authenticate!
        error!('Unauthorized', 401) unless request.headers['X-Api-Key'] == ENV['MATH_API_KEY']
      end
    end

    before { authenticate! }

    resource :equations do
      post do
        begin
          factory = EquationFactory.build(type: permitted_params[:type], params: permitted_params[:data])
          result = factory.solve
          { status: 'success', data: result }
        rescue ArgumentError => e
          error_response(422, e.message)
        rescue StandardError => e
          # Логирование ошибки здесь обязательно
          error_response(500, 'Internal server error during calculation')
        end
      end
    end

    private

    def permitted_params
      declared(params, include_missing: false).symbolize_keys
    end

    def error_response(code, message)
      status code
      { status: 'error', message: message }
    end
  end
end
в) Аутентификация
Простая схема на базе заголовка X-Api-Key. Ключ хранится в переменных окружения сервера (ENV['MATH_API_KEY']). В будущем может быть заменена на JWT-токены.
3. Фронтенд сервер (Ruby on Rails)
Приложение разворачивается отдельно от Бэкенда.
а) Контроллер и маршруты
routes.rb: get '/solver', to: 'solver#index' Контроллер содержит только один экшен index, который отдает HTML-шаблон. Вся логика живет во вьюхе и JS.
б) Форма и AJAX-взаимодействие (StimulusJS как стандарт RoR)
Использование встроенного в Rails 7 фреймворка Stimulus позволяет избежать «спагетти-кода» на чистом JS и сохранить прогрессивное улучшение.
