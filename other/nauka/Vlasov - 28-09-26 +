3. Репозиторий для работы с базой данных (Data/EmployeeRepository.cs)
Класс инкапсулирует все SQL-запросы. Использует асинхронные методы для отзывчивости интерфейса.
csharp
using Microsoft.Data.Sqlite;
using EmployeeManager.Models;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace EmployeeManager.Data
{
    public class EmployeeRepository
    {
        private readonly string _connectionString;

        public EmployeeRepository(string connectionString)
        {
            _connectionString = connectionString;
            InitializeDatabase().Wait(); // Инициализируем БД при создании репозитория
        }

        // Создает таблицу Employees, если её еще нет
        private async Task InitializeDatabase()
        {
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            var command = connection.CreateCommand();
            command.CommandText = @"
                CREATE TABLE IF NOT EXISTS Employees (
                    Id INTEGER PRIMARY KEY AUTOINCREMENT,
                    FirstName TEXT NOT NULL,
                    LastName TEXT NOT NULL,
                    Patronymic TEXT,
                    BirthDate TEXT NOT NULL,
                    Address TEXT,
                    Department TEXT,
                    About TEXT
                );";
            await command.ExecuteNonQueryAsync();
        }

        public async Task<List<Employee>> GetAllAsync()
        {
            var employees = new List<Employee>();
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            using var command = new SqliteCommand("SELECT * FROM Employees ORDER BY LastName", connection);
            using var reader = await command.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                employees.Add(MapToEmployee(reader));
            }
            return employees;
        }

        public async Task<Employee> GetByIdAsync(int id)
        {
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            using var command = new SqliteCommand("SELECT * FROM Employees WHERE Id = $id", connection);
            command.Parameters.AddWithValue("$id", id);
            using var reader = await command.ExecuteReaderAsync();
            if (await reader.ReadAsync())
            {
                return MapToEmployee(reader);
            }
            return null;
        }

        public async Task<int> CreateAsync(Employee employee)
        {
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            using var command = new SqliteCommand(@"
                INSERT INTO Employees (FirstName, LastName, Patronymic, BirthDate, Address, Department, About) 
                VALUES ($fn, $ln, $pt, $bd, $ad, $dep, $ab);", connection);
            
            AddParameters(command, employee);
            await command.ExecuteNonQueryAsync();
            
            // Возвращаем ID последней вставленной записи
            long lastRowId = connection.LastInsertRowId;
            return (int)lastRowId;
        }

        public async Task UpdateAsync(Employee employee)
        {
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            using var command = new SqliteCommand(@"
                UPDATE Employees 
                SET FirstName=$fn, LastName=$ln, Patronymic=$pt, BirthDate=$bd, Address=$ad, Department=$dep, About=$ab
                WHERE Id=$id;", connection);
            
            AddParameters(command, employee);
            command.Parameters.AddWithValue("$id", employee.Id);
            await command.ExecuteNonQueryAsync();
        }

        public async Task DeleteAsync(int id)
        {
            using var connection = new SqliteConnection(_connectionString);
            await connection.OpenAsync();
            using var command = new SqliteCommand("DELETE FROM Employees WHERE Id = $id", connection);
            command.Parameters.AddWithValue("$id", id);
            await command.ExecuteNonQueryAsync();
        }

        private static Employee MapToEmployee(SqliteDataReader reader)
        {
            return new Employee
            {
                Id = reader.GetInt32(0),
                FirstName = reader.GetString(1),
                LastName = reader.GetString(2),
                Patronymic = reader.IsDBNull(3) ? "" : reader.GetString(3),
                BirthDate = DateTime.Parse(reader.GetString(4)),
                Address = reader.IsDBNull(5) ? "" : reader.GetString(5),
                Department = reader.IsDBNull(6) ? "" : reader.GetString(6),
                About = reader.IsDBNull(7) ? "" : reader.GetString(7)
            };
        }

        private static void AddParameters(SqliteCommand command, Employee emp)
        {
            command.Parameters.AddWithValue("$fn", emp.FirstName ?? "");
            command.Parameters.AddWithValue("$ln", emp.LastName ?? "");
            command.Parameters.AddWithValue("$pt", emp.Patronymic ?? "");
            command.Parameters.AddWithValue("$bd", emp.BirthDate.ToString("yyyy-MM-dd"));
            command.Parameters.AddWithValue("$ad", emp.Address ?? "");
            command.Parameters.AddWithValue("$dep", emp.Department ?? "");
            command.Parameters.AddWithValue("$ab", emp.About ?? "");
        }
    }
}
4. Главная форма (Forms/MainForm.cs)
