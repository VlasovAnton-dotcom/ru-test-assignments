using EmployeeManager.Data;
using EmployeeManager.Models;
using System.Configuration;

namespace EmployeeManager.Forms
{
    public partial class MainForm : Form
    {
        private readonly EmployeeRepository _repository;
        private List<Employee> _employees;

        public MainForm()
        {
            InitializeComponent();
            // Читаем строку подключения из App.config
            var connStr = ConfigurationManager.ConnectionStrings["Default"].ConnectionString;
            _repository = new EmployeeRepository(connStr);
            ConfigureListView();
        }

        private void ConfigureListView()
        {
            listViewEmployees.View = View.Details;
            listViewEmployees.FullRowSelect = true;
            listViewEmployees.Columns.Add("ФИО", 200);
            listViewEmployees.Columns.Add("Дата рождения", 100);
            listViewEmployees.Columns.Add("Отдел", 120);
        }

        private async void MainForm_Load(object sender, EventArgs e)
        {
            await LoadEmployeesAsync();
        }

        private async Task LoadEmployeesAsync()
        {
            _employees = await _repository.GetAllAsync();
            listViewEmployees.Items.Clear();
            foreach (var emp in _employees)
            {
                var item = new ListViewItem($"{emp.LastName} {emp.FirstName} {emp.Patronymic}");
                item.SubItems.Add(emp.BirthDate.ToShortDateString());
                item.SubItems.Add(emp.Department);
                item.Tag = emp.Id; // Сохраняем ID во внутренний тег строки
                listViewEmployees.Items.Add(item);
            }
        }

        private void btnAdd_Click(object sender, EventArgs e)
        {
            var form = new EmployeeForm();
            if (form.ShowDialog() == DialogResult.OK)
            {
                _ = LoadEmployeesAsync(); // Обновляем список после добавления
            }
        }

        private void btnEdit_Click(object sender, EventArgs e)
        {
            if (listViewEmployees.SelectedItems.Count == 0) return;
            int id = (int)listViewEmployees.SelectedItems[0].Tag;
            EditEmployee(id);
        }

        private async void btnDelete_Click(object sender, EventArgs e)
        {
            if (listViewEmployees.SelectedItems.Count == 0) return;
            if (MessageBox.Show("Удалить выбранного сотрудника?", "Подтверждение", MessageBoxButtons.YesNo) != DialogResult.Yes) return;

            int id = (int)listViewEmployees.SelectedItems[0].Tag;
            await _repository.DeleteAsync(id);
            await LoadEmployeesAsync();
        }

        private void listViewEmployees_DoubleClick(object sender, EventArgs e)
        {
            if (listViewEmployees.SelectedItems.Count > 0)
            {
                int id = (int)listViewEmployees.SelectedItems[0].Tag;
                EditEmployee(id);
            }
        }

        private void EditEmployee(int id)
        {
            var employee = _employees.Find(x => x.Id == id);
            if (employee == null) return;

            var form = new EmployeeForm(employee);
            if (form.ShowDialog() == DialogResult.OK)
            {
                _ = LoadEmployeesAsync();
            }
        }
    }
}
Примечание к коду формы: В дизайнере WinForms необходимо создать элементы listViewEmployees, а также кнопки btnAdd, btnEdit, btnDelete и привязать их события (Load, Click, DoubleClick) к указанным выше методам.
