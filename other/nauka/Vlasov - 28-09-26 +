using EmployeeManager.Models;
using System;
using System.Windows.Forms;

namespace EmployeeManager.Forms
{
    public partial class EmployeeForm : Form
    {
        private Employee _employee;

        // Конструктор для создания нового сотрудника
        public EmployeeForm()
        {
            InitializeComponent();
            Text = "Новый сотрудник";
            _employee = new Employee { BirthDate = DateTime.Now.AddYears(-25) };
        }

        // Конструктор для редактирования существующего
        public EmployeeForm(Employee employee) : this()
        {
            Text = "Редактирование сотрудника";
            _employee = employee;
            textBoxFirstName.Text = _employee.FirstName;
            textBoxLastName.Text = _employee.LastName;
            textBoxPatronymic.Text = _employee.Patronymic;
            dateTimePickerBirth.Value = _employee.BirthDate;
            textBoxAddress.Text = _employee.Address;
            textBoxDepartment.Text = _employee.Department;
            textBoxAbout.Text = _employee.About;
        }

        private void btnSave_Click(object sender, EventArgs e)
        {
            // Базовая проверка обязательных полей
            if (string.IsNullOrWhiteSpace(textBoxFirstName.Text) || 
                string.IsNullOrWhiteSpace(textBoxLastName.Text))
            {
                MessageBox.Show("Укажите имя и фамилию.");
                return;
            }

            _employee.FirstName = textBoxFirstName.Text.Trim();
            _employee.LastName = textBoxLastName.Text.Trim();
            _employee.Patronymic = textBoxPatronymic.Text.Trim();
            _employee.BirthDate = dateTimePickerBirth.Value.Date;
            _employee.Address = textBoxAddress.Text.Trim();
            _employee.Department = textBoxDepartment.Text.Trim();
            _employee.About = textBoxAbout.Text.Trim();

            DialogResult = DialogResult.OK;
            Close();
        }

        private void btnCancel_Click(object sender, EventArgs e)
        {
            DialogResult = DialogResult.Cancel;
            Close();
        }
    }
}
Примечание к коду формы: В дизайнере создаются текстовые поля (textBoxFirstName, textBoxLastName и т.д.), dateTimePickerBirth и кнопки btnSave, btnCancel.
