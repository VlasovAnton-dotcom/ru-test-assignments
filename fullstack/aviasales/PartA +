jsx
import React, { useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { fetchDashboardRequest } from './store/actions';

const App = () => {
  const dispatch = useDispatch();
  const { data, loading, error } = useSelector((state) => state.dashboard);

  useEffect(() => {
    dispatch(fetchDashboardRequest());
  }, [dispatch]);

  if (loading) return <div className="flex justify-center items-center h-screen text-lg">Загрузка данных...</div>;
  if (error) return <div className="p-4 bg-red-100 text-red-700">Ошибка загрузки: {error}</div>;

  const { errors, metrics, filters } = data;

  return (
    <div className="bg-gray-100 min-h-screen p-6 font-sans">
      <h1 className="text-2xl font-bold mb-6 text-gray-800">Backoffice – Dashboard</h1>
      
      {/* Фильтры времени */}
      <div className="flex gap-2 mb-6 overflow-x-auto">
        {filters.map((filter, idx) => (
          <button 
            key={idx}
            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors \${
              idx === 2 ? 'bg-blue-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-200'
            }`}
          >
            {filter}
          </button>
        ))}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Блок ошибок */}
        <div className="col-span-1 lg:col-span-3 bg-white p-6 rounded-xl shadow-sm border border-gray-200">
          <h2 className="text-lg font-semibold mb-4 text-gray-800">Errors Overview</h2>
          <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
              <p className="text-sm text-gray-500">Errors</p>
              <p className="text-2xl font-bold text-green-600">{errors.totalPercent}%</p>
              <p className="text-xs text-gray-400">Average: 0.11%</p>
            </div>
            <div>
              <p className="text-sm text-gray-500">Zeroes</p>
              <p className="text-2xl font-bold text-green-600">{errors.zeroesPercent}%</p>
              <p className="text-xs text-gray-400">Average: 0.11%</p>
            </div>
            <div>
              <p className="text-sm text-gray-500">Timeouts</p>
              <p className="text-2xl font-bold text-green-600">{errors.timeoutsPercent}%</p>
              <p className="text-xs text-gray-400">Average: 0.11%</p>
            </div>
            
            {/* Breakdown Bar */}
            <div className="w-full mt-4">
              <div className="flex gap-2 text-xs text-gray-500">
                <span>500: {errors.breakdown['500']}</span>
                <span>501: {errors.breakdown['501']}</span>
                <span>502: {errors.breakdown['502']}</span>
                <span>Other: {errors.breakdown['other']}</span>
              </div>
              <div className="w-full h-2 bg-gray-200 rounded-full mt-1">
                <div className="h-2 bg-yellow-500 rounded-full" style={{ width: '40%' }}></div>
                <div className="h-2 bg-blue-500 rounded-full" style={{ width: '25%', marginLeft: '40%' }}></div>
                <div className="h-2 bg-purple-500 rounded-full" style={{ width: '20%', marginLeft: '25%' }}></div>
                <div className="h-2 bg-gray-400 rounded-full" style={{ width: '15%', marginLeft: '20%' }}></div>
              </div>
            </div>
          </div>
        </div>

        {/* Карточки метрик */}
        {[
          { title: "Searches", value: metrics.searches.current, prev: metrics.searches.previous, icon: "🔍" },
          { title: "Clicks", value: metrics.clicks.current, prev: metrics.clicks.previous, extra: `CTR: \${metrics.clicks.ctr}%`, icon: "🖱️" },
          { title: "Bookings", value: metrics.bookings.current, prev: metrics.bookings.previous, extra: `STR: \${metrics.bookings.str}%`, icon: "🛒" }
        ].map((item, idx) => (
          <div key={idx} className="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-800">{item.title}</h3>
              <div className="p-2 bg-blue-50 rounded-lg text-blue-600">{item.icon}</div>
            </div>
            <div className="flex items-baseline gap-2">
              <span className="text-3xl font-bold text-gray-900">{item.value}</span>
              {item.prev && (
                <span className={`text-sm font-medium \${item.value >= item.prev ? 'text-green-600' : 'text-red-600'}`}>
                  {item.value >= item.prev ? `+${((item.value - item.prev) / item.prev * 100).toFixed(1)}%` : `-${((item.prev - item.value) / item.prev * 100).toFixed(1)}%`}
                </span>
              )}
            </div>
            {item.extra && (
              <p className="text-sm text-gray-500 mt-2">{item.extra}</p>
            )}
            <p className="text-xs text-gray-400 mt-4">Yesterday / Last Friday</p>
          </div>
        ))}
      </div>
    </div>
  );
};

export default App;
