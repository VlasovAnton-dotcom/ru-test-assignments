from flask import Flask, jsonify, send_from_directory
import os

app = Flask(__name__)

@app.route('/api/dashboard')
def get_dashboard():
    # В реальном проекте здесь будет запрос к PostgreSQL
    with open(os.path.join(os.path.dirname(__file__), 'dashboard_data.json'), 'r', encoding='utf-8') as f:
        import json
        data = json.load(f)
    return jsonify(data)

# Опционально: раздача статики, если фронтенд не на отдельном сервере
@app.route('/', defaults={'path': 'index.html'})
@app.route('/<path:path>')
def serve_static(path):
    return send_from_directory('../frontend/build', path)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8000)
Запустить: python app.py. Эндпоинт: http://localhost:8000/api/dashboard.
