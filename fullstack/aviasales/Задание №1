App.jsx + подключение Redux
jsx
import React, { useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { FETCH_DASHBOARD_REQUEST } from './store/reducers/dashboardReducer';
import DashboardSummary from './components/DashboardSummary';
import RecentOrdersTable from './components/RecentOrdersTable';
import TrendChart from './components/TrendChart';

function App() {
  const dispatch = useDispatch();
  const { data, loading, error } = useSelector((state) => state.dashboard);

  useEffect(() => {
    dispatch({ type: FETCH_DASHBOARD_REQUEST });
  }, [dispatch]);

  if (loading) return <div>Загрузка дашборда...</div>;
  if (error) return <div style={{ color: 'red' }}>Ошибка: {error}</div>;

  return (
    <main style={{ padding: '24px' }}>
      <h1>Личный кабинет партнёра</h1>
      <DashboardSummary summary={data?.summary} />
      <h2>Последние заказы</h2>
      <RecentOrdersTable orders={data?.recentOrders} />
      <TrendChart trend={data?.trend} />
    </main>
  );
}

export default App;
