Saga (src/store/sagas/dashboardSaga.js)
js

import { call, put, takeLatest } from 'redux-saga/effects';
import axios from 'axios';
import {
  FETCH_DASHBOARD_REQUEST,
  FETCH_DASHBOARD_SUCCESS,
  FETCH_DASHBOARD_FAILURE
} from '../reducers/dashboardReducer';

function* fetchDashboard() {
  try {
    const response = yield call(axios.get, 'http://localhost:8000/api/dashboard');
    yield put({ type: FETCH_DASHBOARD_SUCCESS, payload: response.data });
  } catch (error) {
    yield put({ type: FETCH_DASHBOARD_FAILURE, payload: error.message });
  }
}

export function* watchDashboard() {
  yield takeLatest(FETCH_DASHBOARD_REQUEST, fetchDashboard);
}
