typescriptКопировать
import React from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { RootState, AppDispatch } from '../store';
import { setEmail, submitEmail } from '../store/marketingSlice';

export const SubscriptionBlock: React.FC = () => {
  const dispatch = useDispatch<AppDispatch>();
  const { email, isEmailValid, serverError, blockDisabled } = useSelector((state: RootState) => state.marketing);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (isEmailValid) {
      dispatch(submitEmail(email));
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      <input
        type="email"
        value={email}
        disabled={blockDisabled}
        placeholder="Введите ваш E-mail"
        onChange={(e) => dispatch(setEmail(e.target.value))}
      />
      {!isEmailValid && email.length > 0 && <span style={{ color: 'red' }}>Неверный формат почты</span>}
      {serverError === 'ALREADY_EXISTS' && <span style={{ color: 'red' }}>Этот адрес уже зарегистрирован</span>}
      {serverError === 'SERVER_ERROR' && <span style={{ color: 'red' }}>Ошибка сервера</span>}
      <button type="submit" disabled={!isEmailValid || blockDisabled}>Подписаться</button>
    </form>
  );
};
