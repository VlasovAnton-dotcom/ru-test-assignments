import React from 'react';
import { Provider } from 'react-redux';
import { store } from './store';
import { SubscriptionBlock } from './components/SubscriptionBlock';
import { ShareButtons } from './components/ShareButtons';
import { FinalScreen } from './components/FinalScreen';

function App() {
  const userId = useSelector((state: RootState) => state.marketing.finalUserId);

  return (
    <Provider store={store}>
      {userId ? (
        <FinalScreen />
      ) : (
        <>
          <SubscriptionBlock />
          <ShareButtons />
        </>
      )}
    </Provider>
  );
}

export default App;
3. Инструкция по запуску
Сервер:
1.	Убедитесь, что у вас установлены Node.js и PostgreSQL.
2.	Создайте базу данных и таблицу:
sqlКопировать
CREATE DATABASE marketing_block;
\c marketing_block
CREATE TABLE users(id SERIAL PRIMARY KEY, email TEXT UNIQUE NOT NULL);
3.	Скопируйте код серверной части в папку server.
4.	В корне папки server выполните команды:
bashКопировать
npm install
# Создайте файл .env с переменной DATABASE_URL=postgresql://user:pass@localhost:5432/marketing_block
npm run dev
Сервер запустится на порту 4000.
Клиент:
1.	Скопируйте код клиентской части в папку (например, client).
2.	Выполните установку зависимостей:
bashКопировать
npm install
3.	Так как CORS настроен широко, а API-запросы идут на /api/..., локальный дев-сервер React должен проксировать запросы на бэкенд. Добавьте в package.json клиента строку: "proxy": "http://localhost:4000"
4.	Запустите фронтенд:
bashКопировать
npm start
Деплой:
•	Бэкенд: Легко деплоится на Railway, Render или Fly.io. Потребуется связать его с работающим инстансом PostgreSQL.
•	Фронтенд: Статика собирается командой npm run build и выкладывается на Vercel, Netlify или GitHub Pages. Если домены фронта и бэка разные, убедитесь, что заголовки CORS на сервере разрешают нужный Origin.
