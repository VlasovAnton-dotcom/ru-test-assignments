// Простая таблица для примера. В реальности нужен уникальный индекс по email.
export async function findUserByEmail(email: string) {
  const { rows } = await import('./client').then(m => m.pool.query('SELECT id FROM users WHERE email = $1', [email]));
  return rows[0];
}

export async function createUser(email: string) {
  const { rows } = await import('./client').then(m => m.pool.query('INSERT INTO users(email) VALUES($1) RETURNING id', [email]));
  return rows[0].id;
}
Примечание: перед запуском создайте таблицу в БД: CREATE TABLE users(id SERIAL PRIMARY KEY, email TEXT UNIQUE NOT NULL);
