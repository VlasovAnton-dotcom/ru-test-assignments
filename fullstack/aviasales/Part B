typescriptКопировать
import { createSlice, PayloadAction, createAsyncThunk } from '@reduxjs/toolkit';

interface MarketingState {
  email: string;
  isEmailValid: boolean;
  serverError: null | 'INVALID_FORMAT' | 'ALREADY_EXISTS' | 'SERVER_ERROR';
  blockDisabled: boolean;
  
  sharingInProgress: boolean;
  sharedSuccessfully: boolean;
  manualShareClaim: boolean;
  shareError: null | 'NOT_SHARED' | 'SERVER_ERROR';
  
  finalUserId: string | null;
}

const initialState: MarketingState = {
  email: '',
  isEmailValid: false,
  serverError: null,
  blockDisabled: false,
  
  sharingInProgress: false,
  sharedSuccessfully: false,
  manualShareClaim: false,
  shareError: null,
  
  finalUserId: null,
};

export const submitEmail = createAsyncThunk(
  'marketing/submitEmail',
  async (email: string, { rejectWithValue }) => {
    const response = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });

    if (!response.ok) {
      const data = await response.json();
      return rejectWithValue(data.error || 'SERVER_ERROR');
    }
    const data = await response.json();
    return data.userId;
  }
);

export const registerShare = createAsyncThunk(
  'marketing/registerShare',
  async (_, { rejectWithValue }) => {
    const response = await fetch('/api/share', {
      method: 'POST',
    });
    if (!response.ok) {
      return rejectWithValue('SERVER_ERROR');
    }
    return true;
  }
);

const slice = createSlice({
  name: 'marketing',
  initialState,
  reducers: {
    setEmail(state, action: PayloadAction<string>) {
      state.email = action.payload;
      state.isEmailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(action.payload);
      state.serverError = null;
    },
    claimManualShare(state) {
      state.manualShareClaim = true;
    },
    resetForm() {
      return initialState;
    },
  },
  extraReducers: builder => {
    builder
      .addCase(submitEmail.pending, state => {
        state.blockDisabled = true;
      })
      .addCase(submitEmail.fulfilled, (state, action) => {
        state.blockDisabled = true;
        state.finalUserId = action.payload;
      })
      .addCase(submitEmail.rejected, (state, action) => {
        state.blockDisabled = false;
        state.serverError = action.payload as string;
      })
      
      .addCase(registerShare.pending, state => {
        state.sharingInProgress = true;
        state.shareError = null;
      })
      .addCase(registerShare.fulfilled, state => {
        state.sharingInProgress = false;
        state.sharedSuccessfully = true;
        state.shareError = null;
      })
      .addCase(registerShare.rejected, (state, action) => {
        state.sharingInProgress = false;
        state.shareError = action.payload as string;
      });
  },
});

export const { setEmail, claimManualShare, resetForm } = slice.actions;
export default slice.reducer;
