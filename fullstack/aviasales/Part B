typescriptКопировать
import React from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { RootState, AppDispatch } from '../store';
import { registerShare } from '../store/marketingSlice';
import { claimManualShare } from '../store/marketingSlice';

const socialNetworks = [
  { name: 'VK', url: 'https://vk.com/share.php?url=' },
  { name: 'Telegram', url: 'https://t.me/share/url?url=' },
  { name: 'Twitter', url: 'https://twitter.com/intent/tweet?url=' },
] as const;

export const ShareButtons: React.FC = () => {
  const dispatch = useDispatch<AppDispatch>();
  const { sharedSuccessfully, sharingInProgress, shareError, manualShareClaim } = useSelector((state: RootState) => state.marketing);

  const currentUrl = encodeURIComponent(window.location.href);

  const handleShareClick = (networkUrl: string) => {
    window.open(networkUrl + currentUrl, '_blank');
    // Оптимистичное обновление состояния можно добавить при необходимости
  };

  if (sharedSuccessfully) {
    return null; // Кнопки скрываются после успешного шеринга
  }

  return (
    <div>
      {shareError === 'SERVER_ERROR' && <span style={{ color: 'red' }}>Ошибка сохранения шеринг-статуса</span>}
      {manualShareClaim && !sharedSuccessfully && shareError !== 'SERVER_ERROR' && (
        <span style={{ color: 'red' }}>Сначала нажмите кнопку соцсети, чтобы поделиться.</span>
      )}
      
      <div>
        {socialNetworks.map(net => (
          <button key={net.name} onClick={() => handleShareClick(net.url)} disabled={sharingInProgress}>
            Поделиться в {net.name}
          </button>
        ))}
      </div>
      
      <button onClick={() => dispatch(claimManualShare())} disabled={sharingInProgress}>
        Я поделился
      </button>
      
      <button 
        onClick={() => dispatch(registerShare())} 
        disabled={sharingInProgress || !manualShareClaim}
      >
        Продолжить
      </button>
    </div>
  );
};
