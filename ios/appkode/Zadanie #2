import re

def parse_value(value_str: str, visitor_data: dict):
    """
    Преобразует строку значения в число.
    Если значение ссылается на другой параметр (одна буква), возвращает его текущее значение у посетителя.
    """
    if len(value_str) == 1 and value_str.isalpha():
        return visitor_data.get(value_str, -1)
    return int(value_str)

def check_visitor(rules_line: str, visitor_line: str) -> bool:
    # Словари диапазонов для валидации вводимых данных
    ranges = {
        'L': (1, 200), 'B': (0, 100), 'W': (0, 10), 
        'G': (0, 10), 'H': (0, 10), 'E': (0, 10), 'A': (0, 300)
    }
    
    rules = {}
    for part in rules_line.split():
        key = part[0]
        
        # Проверка формата X:N
        if ':' in part and '-' not in part:
            val = part.split(':')[1]
            min_val = parse_value(val, {})
            max_val = None
            
            # Валидация границ
            r_min, r_max = ranges[key]
            if isinstance(min_val, int):
                if not (r_min <= min_val <= r_max):
                    return False
            rules[key] = ('ge', min_val)
            
        # Проверка формата X:N-M
        elif ':' in part and '-' in part:
            left, right = part.split(':')[1].split('-')
            min_val = parse_value(left, {})
            max_val = parse_value(right, {})
            
            # Валидация границ
            r_min, r_max = ranges[key]
            vals_to_check = [v for v in [min_val, max_val] if isinstance(v, int)]
            if vals_to_check:
                if not all(r_min <= v <= r_max for v in vals_to_check):
                    return False
                    
            rules[key] = ('range', min_val, max_val)

    # Собираем данные о посетителе
    visitor_data = {}
    for part in visitor_line.split():
        k, v = part.split(':')
        visitor_data[k] = int(v)
        
        # Базовая валидация данных посетителя
        if k in ranges:
            r_min, r_max = ranges[k]
            if not (r_min <= visitor_data[k] <= r_max):
                return False

    # Применяем правила к данным посетителя
    for param, rule in rules.items():
        if param not in visitor_data:
            return False
            
        current_val = visitor_data[param]
        
        if rule[0] == 'ge':
            threshold = rule[1]
            actual_threshold = parse_value(threshold, visitor_data)
            if current_val < actual_threshold:
                return False
                
        elif rule[0] == 'range':
            min_rule, max_rule = rule[1], rule[2]
            actual_min = parse_value(min_rule, visitor_data)
            actual_max = parse_value(max_rule, visitor_data)
            
            # Если границы заданы числами, просто сравниваем
            if isinstance(actual_min, int) and isinstance(actual_max, int):
                if not (actual_min <= current_val <= actual_max):
                    return False
            # Если одна из границ — ссылка на другой параметр
            else:
                lower_bound = actual_min if isinstance(actual_min, int) else visitor_data[actual_min]
                upper_bound = actual_max if isinstance(actual_max, int) else visitor_data[actual_max]
                if not (lower_bound <= current_val <= upper_bound):
                    return False
                    
    return True


# Чтение входных данных (по два токена на строке)
try:
    line1 = input().strip()
    line2 = input().strip()
except EOFError:
    exit()

if check_visitor(line1, line2):
    print("true")
else:
    print("false")
