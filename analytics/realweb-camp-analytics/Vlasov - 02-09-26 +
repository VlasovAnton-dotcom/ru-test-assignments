Нужно выделить два периода времени (до/после), далее разбить пользователей на группы по признаку использования промокода и рассчитать средние чеки.

python
Копировать
# Предположим, дата ограничения известна заранее
cutoff_date = '2020-03-01'
before_covid = df[df['date'] < cutoff_date]
after_covid = df[df['date'] >= cutoff_date]

def avg_check(group):
    return group['revenue'].mean()

print("Средний чек до COVID:")
print(before_covid.groupby('promo_activated').apply(avg_check))
print("\nСредний чек после COVID:")
print(after_covid.groupby('promo_activated').apply(avg_check))
