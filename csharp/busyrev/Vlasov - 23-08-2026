using System.Collections.Generic;

public class Solution
{
    public void FindElementsForSum(List<uint> list, ulong sum, out int start, out int end)
    {
        // Инициализация результата согласно условию (если ничего не найдем)
        start = 0;
        end = 0;

        if (list == null || list.Count == 0) return;

        ulong currentSum = 0;
        int left = 0;

        for (int right = 0; right < list.Count; right++)
        {
            currentSum += list[right];

            // Сдвигаем левую границу вправо, пока сумма больше целевой
            // Так как uint >= 0, текущая сумма никогда не станет меньше нуля,
            // поэтому цикл while безопасен и гарантированно завершится.
            while (currentSum > sum && left <= right)
            {
                currentSum -= list[left];
                left++;
            }

            // Проверяем на точное равенство
            if (currentSum == sum)
            {
                start = left;
                end = right + 1; // end не включительно
                return; // Нашли наименьший индекс начала, выходим немедленно
            }
        }
    }
}
