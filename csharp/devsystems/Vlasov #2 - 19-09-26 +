using System;
using System.Drawing;

namespace ds.test.impl
{
    /// <summary>
    /// Закрытый базовый класс. Содержит общую логику проверок 
    /// и свойств, доступную только внутри DLL.
    /// </summary>
    internal abstract class PluginBase : IPlugin
    {
        private readonly Lazy<Image> _image;

        protected PluginBase()
        {
            _image = new Lazy<Image>(GenerateDefaultImage);
        }

        public abstract string PluginName { get; }
        public virtual string Version => "1.0.0";
        public abstract string Description { get; }
        public Image Image => _image.Value;

        /// <summary>
        /// Генерирует простую заглушку изображения (цветной квадрат).
        /// Позволяет библиотеке работать без внешних графических ассетов.
        /// </summary>
        private Image GenerateDefaultImage()
        {
            var bitmap = new Bitmap(64, 64);
            using (var g = Graphics.FromImage(bitmap))
            {
                // Цвет зависит от хеша имени плагина для уникальности
                int hash = Math.Abs(PluginName.GetHashCode());
                Color color = Color.FromArgb(
                    (hash & 0xFF0000) >> 16,
                    (hash & 0x00FF00) >> 8,
                    hash & 0x0000FF);
                
                g.Clear(color);
                g.DrawRectangle(Pens.Black, 0, 0, 63, 63);
            }
            return bitmap;
        }

        /// <summary>
        /// Проверяет входные данные на базовые аномалии перед расчетом.
        /// Выбрасывает исключение, если данные критически некорректны.
        /// </summary>
        protected void ValidateInputs(int input1, int input2)
        {
            if (input1 == 0 && input2 == 0)
            {
                throw new ArgumentException("Both inputs cannot be zero for this operation.");
            }
        }

        public abstract int Run(int input1, int input2);
    }
}

