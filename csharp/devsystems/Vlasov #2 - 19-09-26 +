using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;

namespace ds.test.impl
{
    /// <summary>
    /// Точка входа для потребителя библиотеки. 
    /// Автоматически сканирует сборку и регистрирует все плагины.
    /// </summary>
    public static class Plugins : IPluginFactory
    {
        private static readonly Dictionary<string, Type> _pluginRegistry;

        static Plugins()
        {
            _pluginRegistry = new Dictionary<string, Type>(StringComparer.OrdinalIgnoreCase);
            RegisterInternalPlugins();
        }

        private static void RegisterInternalPlugins()
        {
            var currentAssembly = Assembly.GetExecutingAssembly();
            
            foreach (var type in currentAssembly.GetTypes())
            {
                if (typeof(IPlugin).IsAssignableFrom(type) && !type.IsInterface && !type.IsAbstract)
                {
                    try
                    {
                        var instance = (IPlugin)Activator.CreateInstance(type)!;
                        _pluginRegistry[instance.PluginName] = type;
                    }
                    catch
                    {
                        // Игнорируем плагины, которые не смогли создаться
                    }
                }
            }
        }

        public static int PluginsCount => _pluginRegistry.Count;

        public static string[] GetPluginNames => _pluginRegistry.Keys.ToArray();

        public static IPlugin GetPlugin(string pluginName)
        {
            if (_pluginRegistry.TryGetValue(pluginName, out var type))
            {
                return (IPlugin)Activator.CreateInstance(type)!;
            }
            throw new KeyNotFoundException($"Plugin '{pluginName}' not found.");
        }

        // Явная реализация интерфейса для строгой инкапсуляции
        int IPluginFactory.PluginsCount => PluginsCount;
        string[] IPluginFactory.GetPluginNames => GetPluginNames;
        IPlugin IPluginFactory.GetPlugin(string pluginName) => GetPlugin(pluginName);
    }
}

