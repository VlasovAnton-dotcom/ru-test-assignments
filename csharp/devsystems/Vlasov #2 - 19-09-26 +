namespace ds.test.impl
{
    /// <summary>
    /// Плагин для сложения двух целых чисел с защитой от переполнения.
    /// </summary>
    public sealed class AdderPlugin : PluginBase
    {
        public override string PluginName => "Сложение";
        public override string Description => "Вычисляет сумму двух целых чисел (a + b).";

        public override int Run(int input1, int input2)
        {
            ValidateInputs(input1, input2);
            try
            {
                checked
                {
                    return input1 + input2;
                }
            }
            catch (OverflowException)
            {
                throw new OverflowException($"Переполнение при сложении чисел {input1} и {input2}.");
            }
        }
    }
}

