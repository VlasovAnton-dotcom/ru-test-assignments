namespace ds.test.impl
{
    /// <summary>
    /// Плагин для деления нацело. Демонстрирует обработку специфической ошибки.
    /// </summary>
    public sealed class DividerPlugin : PluginBase
    {
        public override string PluginName => "Деление";
        public override string Description => "Выполняет целочисленное деление первого числа на второе (a / b).";

        public override int Run(int input1, int input2)
        {
            ValidateInputs(input1, input2);
            if (input2 == 0)
            {
                throw new DivideByZeroException("Делитель не может быть равен нулю.");
            }
            return input1 / input2;
        }
    }
}
