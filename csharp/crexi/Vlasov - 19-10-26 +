import unittest
import time
from rate_limiter.storage import InMemoryStorage
from rate_limiter.core import ResourceRateLimiter
from rate_limiter.rules import FixedWindowRule, IntervalSinceLastRule, GeoRegionRule

class TestRateLimiter(unittest.TestCase):
    def setUp(self):
        self.storage = InMemoryStorage()

    def test_fixed_window_rule(self):
        rule = FixedWindowRule(self.storage, limit=2, period_seconds=2)
        limiter = ResourceRateLimiter("resource_A", [rule])
        
        self.assertTrue(limiter.allow_request("client_1", {}))
        self.assertTrue(limiter.allow_request("client_1", {}))
        self.assertFalse(limiter.allow_request("client_1", {}))
        
        # Ждем обнуления окна
        time.sleep(2.1)
        self.assertTrue(limiter.allow_request("client_1", {}))

    def test_interval_since_last_rule(self):
        rule = IntervalSinceLastRule(self.storage, interval_seconds=1)
        limiter = ResourceRateLimiter("resource_B", [rule])
        
        self.assertTrue(limiter.allow_request("client_2", {}))
        self.assertFalse(limiter.allow_request("client_2", {}))
        
        time.sleep(1.1)
        self.assertTrue(limiter.allow_request("client_2", {}))

    def test_combined_rules(self):
        # Ресурс требует: не чаще 1 раза в 5 секунд И не чаще 1 раза в окно 10 секунд
        rule_a = FixedWindowRule(self.storage, limit=1, period_seconds=10)
        rule_b = IntervalSinceLastRule(self.storage, interval_seconds=5)
        limiter = ResourceRateLimiter("resource_C", [rule_a, rule_b])
        
        self.assertTrue(limiter.allow_request("client_3", {}))
        self.assertFalse(limiter.allow_request("client_3", {})) # Сломает правило B
        
        time.sleep(3)
        self.assertFalse(limiter.allow_request("client_3", {})) # Все еще сломано правилом B
        
        time.sleep(3) # Прошло 6 секунд, правило B пройдено
        self.assertFalse(limiter.allow_request("client_3", {})) # Теперь сломает правило A (окно 10 сек еще идет)
        
        time.sleep(5) # Прошло 11 секунд, окно A обновилось
        self.assertTrue(limiter.allow_request("client_3", {}))

    def test_geo_region_rule(self):
        us_rule = FixedWindowRule(self.storage, limit=1, period_seconds=10)
        eu_rule = IntervalSinceLastRule(self.storage, interval_seconds=2)
        
        geo_rule = GeoRegionRule(
            self.storage, 
            region_context_key="region", 
            rules_by_region={"US": us_rule, "EU": eu_rule}
        )
        
        limiter_us = ResourceRateLimiter("resource_D", [geo_rule])
        limiter_eu = ResourceRateLimiter("resource_D", [geo_rule])

        # Проверка для US (правило фиксированного окна)
        self.assertTrue(limiter_us.allow_request("client_4", {"region": "US"}))
        self.assertFalse(limiter_us.allow_request("client_4", {"region": "US"}))
        time.sleep(0.5)
        self.assertFalse(limiter_us.allow_request("client_4", {"region": "US"})) # Окно 10 сек не истекло

        # Проверка для EU (правило интервала)
        self.assertTrue(limiter_eu.allow_request("client_5", {"region": "EU"}))
        self.assertFalse(limiter_eu.allow_request("client_5", {"region": "EU"}))
        time.sleep(2.1)
        self.assertTrue(limiter_eu.allow_request("client_5", {"region": "EU"}))

if __name__ == '__main__':
    unittest.main()
Как это работает и архитектурные решения

Разделение ответственности (SRP):

InMemoryStorage отвечает только за хранение и извлечение данных.
RateLimitRule (и его наследники) отвечают только за логику проверки и обновления состояния.
ResourceRateLimiter выступает в роли оркестратора: он собирает результаты всех правил и обновляет состояние только если все они пройдены.

Комбинация правил: Любой ресурс инициализируется со списком правил. В методе allow_request реализована строгая последовательность: сначала проверяются все правила. Если хотя бы одно возвращает False, метод немедленно возвращает отказ и не вызывает update_state. Это предотвращает частичное обновление счетчиков. Если все проверки пройдены, состояние обновляется для каждого правила. Это позволяет комбинировать их в любой последовательности и количестве.

Расширяемость: Чтобы добавить новое правило (например, по весу запроса или типу HTTP-метода), достаточно создать новый класс, наследующий RateLimitRule, и передать его экземпляр в ResourceRateLimiter. Никакой другой код менять не нужно.

Гибкость контекста: В методы check и update_state передается словарь context. Это позволяет правилам читать дополнительные данные (как в примере с GeoRegionRule, который смотрит на context["region"]), не меняя сигнатуру интерфейса.

Покрытие тестами: Тесты проверяют не только базовую работу каждого правила, но и критически важный сценарий — комбинацию правил, где одно блокирует запрос, пока не истекло время другого.

