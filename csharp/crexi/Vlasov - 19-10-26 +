from typing import Dict, Any
import threading

class InMemoryStorage:
    """
    Потокобезопасное хранилище состояния клиентов в оперативной памяти.
    Ключ: идентификатор клиента (токен).
    Значение: словарь с произвольными данными (счетчики, таймстампы).
    """
    def __init__(self):
        self._store: Dict[str, Dict[str, Any]] = {}
        self._lock = threading.Lock()

    def get(self, client_id: str) -> Dict[str, Any]:
        with self._lock:
            return self._store.get(client_id, {})

    def set(self, client_id: str, data: Dict[str, Any]):
        with self._lock:
            self._store[client_id] = data

    def delete(self, client_id: str):
        with self._lock:
            if client_id in self._store:
                del self._store[client_id]

