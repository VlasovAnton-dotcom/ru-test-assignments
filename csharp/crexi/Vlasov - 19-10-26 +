from typing import Dict, Any
from .core import RateLimitRule
import time

class FixedWindowRule(RateLimitRule):
    """
    Правило A: X запросов за определенный период времени (скользящее окно фиксированного размера).
    """
    def __init__(self, storage: InMemoryStorage, limit: int, period_seconds: int):
        super().__init__(storage)
        self.limit = limit
        self.period = period_seconds

    def check(self, client_id: str, resource: str, context: Dict[str, Any]) -> bool:
        data = self.storage.get(client_id)
        current_time = int(time.time())
        window_start = current_time - (current_time % self.period)
        key = f"{resource}:fixed:{window_start}"
        
        count = data.get(key, 0)
        return count < self.limit

    def update_state(self, client_id: str, resource: str, context: Dict[str, Any]):
        data = self.storage.get(client_id)
        current_time = int(time.time())
        window_start = current_time - (current_time % self.period)
        key = f"{resource}:fixed:{window_start}"
        
        data[key] = data.get(key, 0) + 1
        self.storage.set(client_id, data)

class IntervalSinceLastRule(RateLimitRule):
    """
    Правило B: С момента последнего обращения прошло определенное время.
    """
    def __init__(self, storage: InMemoryStorage, interval_seconds: int):
        super().__init__(storage)
        self.interval = interval_seconds

    def check(self, client_id: str, resource: str, context: Dict[str, Any]) -> bool:
        data = self.storage.get(client_id)
        key = f"{resource}:last_request"
        
        last_request = data.get(key, 0)
        return (time.time() - last_request) >= self.interval

    def update_state(self, client_id: str, resource: str, context: Dict[str, Any]):
        data = self.storage.get(client_id)
        key = f"{resource}:last_request"
        
        data[key] = time.time()
        self.storage.set(client_id, data)

class GeoRegionRule(RateLimitRule):
    """
    Прокси-правило для выбора стратегии в зависимости от региона токена.
    Не обновляет состояние само, делегирует это вложенному правилу.
    """
    def __init__(self, storage: InMemoryStorage, region_context_key: str, rules_by_region: Dict[str, RateLimitRule]):
        super().__init__(storage)
        self.region_context_key = region_context_key
        self.rules_by_region = rules_by_region

    def _get_rule(self, context: Dict[str, Any]) -> RateLimitRule:
        region = context.get(self.region_context_key, 'DEFAULT')
        return self.rules_by_region.get(region, self.rules_by_region.get('DEFAULT'))

    def check(self, client_id: str, resource: str, context: Dict[str, Any]) -> bool:
        rule = self._get_rule(context)
        return rule.check(client_id, resource, context)

    def update_state(self, client_id: str, resource: str, context: Dict[str, Any]):
        rule = self._get_rule(context)
        rule.update_state(client_id, resource, context)
