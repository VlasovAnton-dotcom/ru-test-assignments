from abc import ABC, abstractmethod
from typing import Dict, Any
from .storage import InMemoryStorage
import time

class RateLimitRule(ABC):
    """
    Абстрактный базовый класс для всех правил ограничения.
    """
    def __init__(self, storage: InMemoryStorage):
        self.storage = storage

    @abstractmethod
    def check(self, client_id: str, resource: str, context: Dict[str, Any]) -> bool:
        """
        Проверяет, разрешен ли запрос.
        Возвращает True, если лимит не превышен.
        Возвращает False, если доступ должен быть ограничен.
        """
        pass

    @abstractmethod
    def update_state(self, client_id: str, resource: str, context: Dict[str, Any]):
        """
        Обновляет состояние клиента в хранилище после успешного запроса.
        """
        pass

class ResourceRateLimiter:
    """
    Менеджер лимитов для конкретного ресурса API.
    Может содержать любое количество правил (комбинация через AND).
    """
    def __init__(self, resource_name: str, rules: list[RateLimitRule]):
        self.resource_name = resource_name
        self.rules = rules

    def allow_request(self, client_id: str, context: Dict[str, Any]) -> bool:
        """
        Принимает решение на основе всех правил.
        Если хотя бы одно правило возвращает False — запрос отклоняется.
        """
        # Сначала проверяем все правила. Это гарантирует атомарность решения:
        # мы не обновим состояние, если одно правило уже запретило запрос.
        for rule in self.rules:
            if not rule.check(client_id, self.resource_name, context):
                return False

        # Если все проверки пройдены, обновляем состояние для каждого правила.
        for rule in self.rules:
            rule.update_state(client_id, self.resource_name, context)

        return True

