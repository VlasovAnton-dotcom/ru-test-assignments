<?php
namespace App\Model;

use App\Core\Database;
use PDO;

class Comment
{
    public static function add(string $username, string $text): bool
    {
        $sql = "INSERT INTO comments (username, text, created_at) VALUES (:username, :text, NOW())";
        $stmt = Database::getInstance()->getConnection()->prepare($sql);
        return $stmt->execute(['username' => $username, 'text' => $text]);
    }

    public static function getAll(int $page = 1, int $perPage = 10): array
    {
        $offset = ($page - 1) * $perPage;
        $sql = "SELECT id, username, text, created_at FROM comments ORDER BY created_at DESC LIMIT :limit OFFSET :offset";
        $stmt = Database::getInstance()->getConnection()->prepare($sql);
        $stmt->bindValue(':limit', $perPage, PDO::PARAM_INT);
        $stmt->bindValue(':offset', $offset, PDO::PARAM_INT);
        $stmt->execute();
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
    
    public static function getTotalCount(): int
    {
        $sql = "SELECT COUNT(id) as count FROM comments";
        $stmt = Database::getInstance()->getConnection()->query($sql);
        return (int)$stmt->fetchColumn();
    }
}

