interface DataProviderInterface {
    public function provideData(): string;
}

class ConcreteDataProvider implements DataProviderInterface {
    public function provideData(): string {
        return "Concrete data";
    }
}

class HighLevelModule {
    private DataProviderInterface $dataProvider;
    
    public function __construct(DataProviderInterface $provider) {
        $this->dataProvider = $provider;
    }
    
    public function processData(): void {
        echo $this->dataProvider->provideData();
    }
}
