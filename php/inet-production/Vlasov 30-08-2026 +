Задача №5: Товары со всеми возможными тегами
sql
Копировать
SELECT g.id, g.name 
FROM goods g
JOIN (
    SELECT gt.goods_id
    FROM goods_tags gt
    GROUP BY gt.goods_id
    HAVING COUNT(*) = (SELECT COUNT(*) FROM tags)
) AS all_tagged_goods ON g.id = all_tagged_goods.goods_id;
