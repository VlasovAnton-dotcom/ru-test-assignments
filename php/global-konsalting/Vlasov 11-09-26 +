2. Миграция таблицы «products»
Выполните команду php artisan make:migration create_products_table.
php
// database/migrations/xxxx_xx_xx_create_products_table.php
use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;

class CreateProductsTable extends Migration
{
    public function up(): void
    {
        Schema::create('products', function (Blueprint $table) {
            $table->id();
            $table->string('article')->unique();
            $table->string('name');
            $table->string('status')->default('available'); // available | unavailable
            $table->jsonb('data'); // Для Color, Size и т.д.
            $table->softDeletes(); // soft deletes
            $table->timestamps();
        });
    }

    public function down(): void
    {
        Schema::dropIfExists('products');
    }
}
После создания выполните php artisan migrate.
3. Eloquent-модель «Product» и Local Scope
Выполните php artisan make:model Product.
php
// app/Models/Product.php
namespace App\Models;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\SoftDeletes;

class Product extends Model
{
    use SoftDeletes;

    protected $fillable = [
        'article',
        'name',
        'status',
        'data',
    ];

    protected $casts = [
        'data' => 'array', // Удобная работа с jsonb как с массивом
    ];

    // Local Scope для доступных продуктов
    public function scopeAvailable(Builder $query): Builder
    {
        return $query->where('status', 'available');
    }

    // Глобальная проверка уникальности артикула при обновлении
    public static function boot()
    {
        parent::boot();

        static::saving(function ($product) {
            if ($product->isDirty('article')) {
                $exists = self::where('article', $product->article)
                    ->whereNot('id', $product->id)
                    ->exists();
                
                if ($exists) {
                    throw new \Illuminate\Validation\ValidationException(
                        validator([], [], ['article.unique' => __('validation.unique')])
                    )->errors()->add('article', 'Артикул уже занят.');
                }
            }
        });
    }
}
