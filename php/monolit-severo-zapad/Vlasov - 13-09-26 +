3. JavaScript – menu.js
javascript
document.addEventListener('DOMContentLoaded', () => {
  const toggle = document.getElementById('menuToggle');
  const closeBtn = document.getElementById('menuClose');
  const overlay = document.getElementById('menuOverlay');
  const menu = document.getElementById('mobileMenu');
  const root = document.getElementById('menuRoot');

  // Открыть / закрыть меню
  function openMenu() {
    menu.classList.add('open');
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu.classList.remove('open');
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);

  // Escape закрывает меню
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
  });

  // ----------------- Построение меню -----------------
  async function loadMenu() {
    try {
      const response = await fetch('/api/getMenu');
      if (!response.ok) throw new Error('Ошибка загрузки');
      const data = await response.json();
      renderMenu(data, root);
    } catch (err) {
      console.error(err);
      root.innerHTML = '<li class="menu-item"><span class="menu-link">Не удалось загрузить меню</span></li>';
    }
  }

  // Рекурсивная отрисовка
  function renderMenu(items, parentElement) {
    items.forEach(item => {
      const li = document.createElement('li');
      li.className = 'menu-item';

      const link = document.createElement('a');
      link.className = 'menu-link';
      link.href = item.url;
      link.innerHTML = `<span>${escapeHtml(item.title)}</span><span class="menu-arrow">${item.children ? '▶' : ''}</span>`;

      // Если есть дети – блокируем переход и добавляем обработчик
      if (item.children && item.children.length) {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const submenu = link.nextElementSibling; // <ul class="submenu">
          if (submenu) {
            const isOpen = submenu.classList.contains('open');
            // Закрываем все открытые подменю на этом уровне (опционально)
            const parent = li.parentElement;
            parent.querySelectorAll('.submenu.open').forEach(s => s.classList.remove('open'));
            // Раскрываем текущее
            if (!isOpen) submenu.classList.add('open');
          }
        });

        // Создаём вложенный список
        const subUl = document.createElement('ul');
        subUl.className = 'submenu';
        renderMenu(item.children, subUl);
        li.appendChild(link);
        li.appendChild(subUl);
      } else {
        // Обычная ссылка – оставляем переход
        link.addEventListener('click', () => closeMenu());
        li.appendChild(link);
      }

      parentElement.appendChild(li);
    });
  }

  // Простейшая защита от XSS
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Инициализация
  loadMenu();
});
4. Как это работает
1.	При загрузке страницы menu.js делает fetch('/api/getMenu').
2.	Получает JSON и рекурсивно строит дерево <ul> / <li>.
3.	Если у пункта есть children – добавляется стрелка, клик отменяет переход и переключает класс open у вложенного <ul>.
4.	CSS анимация max-height 0.4s создаёт плавное раскрытие подменю.
5.	Главное меню выезжает/прячется через right + оверлей.
6.	При клике на ссылку без детей меню закрывается (и происходит переход).
5. Улучшения (опционально)
•	Анимация фона – менять прозрачность оверлея.
•	Жесты свайпа – добавить touch события.
•	Сохранение состояния (localStorage) – какое подменю открыто.
•	Адаптив – медиа запрос для десктопа (превратить в горизонтальное).

