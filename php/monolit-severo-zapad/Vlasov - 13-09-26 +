Задание 1. Список новостей (MODx + pdoTools + Fenom)
Логика решения
•	Создаём сниппет getNews.php, который через pdoTools получает опубликованные дочерние ресурсы новости.
•	Обрезаем content до 200 символов (чистый текст), форматируем дату.
•	Возвращает JSON массив (можно использовать плейсхолдер).
•	В шаблоне «Список новостей» (Fenom) вызываем сниппет, разбираем JSON и в цикле выводим карточки.
1. Сниппет getNews.php
php
<?php
/**
 * getNews.php – возвращает список новостей для текущего контейнера
 * Параметры (через [[!getNews? &parent=`54`]]):
 *   &parent  – ID родителя (по умолчанию 54)
 *   &limit   – лимит (0 = без ограничения)
 *   &sortby  – поле сортировки (publishedon)
 *   &sortdir – направление (DESC)
 */

if (!$modx->loadClass('pdopage', MODX_CORE_PATH . 'components/pdotools/model/pdotools/', false, true)) {
    $modx->log(modX::LOG_LEVEL_ERROR, 'pdoTools not found');
    return;
}

$pdo = $modx->getService('pdoTools');

$parent = (int) $modx->getOption('parent', $scriptProperties, 54);
$limit  = (int) $modx->getOption('limit', $scriptProperties, 0);
$sortby = $modx->getOption('sortby', $scriptProperties, 'publishedon');
$sortdir = $modx->getOption('sortdir', $scriptProperties, 'DESC');

$where = [
    'parent'   => $parent,
    'deleted'  => 0,
    'published'=> 1,
];

$options = [
    'loadModels' => 'modResource',
    'select'     => 'id,pagetitle,publishedon,preview_image,content',
    'where'      => json_encode($where, JSON_NUMERIC_CHECK),
    'sortby'     => $sortby,
    'sortdir'    => $sortdir,
    'limit'      => $limit ?: 0,
];

$collection = $pdo->getCollection('modResource', $options);

// Обработка каждой новости
foreach ($collection as &$item) {
    // Чистый текст, обрезанный до 200 символов
    $text = strip_tags($item['content']);
    $text = $modx->stripTags($text); // удаляем возможные оставшиеся теги
    if (mb_strlen($text) > 200) {
        $text = mb_substr($text, 0, 200) . '…';
    }
    $item['content_short'] = $text;

    // Дата в читаемом формате (можно настроить)
    $item['pubdate'] = strftime('%d %B %Y', (int) $item['publishedon']);
}
unset($item);

// Возвращаем как JSON – для безопасной передачи в Fenom
return json_encode($collection, JSON_UNESCAPED_UNICODE | JSON_NUMERIC_CHECK);
