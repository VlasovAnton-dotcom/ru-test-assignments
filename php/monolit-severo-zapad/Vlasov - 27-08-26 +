### JavaScript (menu.js):

```javascript
document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menuToggle');
    const menuClose = document.getElementById('menuClose');
    const mobileMenu = document.getElementById('mobileMenu');
    const menuOverlay = document.getElementById('menuOverlay');
    const menuList = document.getElementById('menuList');
    
    // Открытие/закрытие меню
    function toggleMenu() {
        mobileMenu.classList.toggle('active');
        menuOverlay.classList.toggle('active');
        menuToggle.classList.toggle('active');
    }
    
    menuToggle.addEventListener('click', toggleMenu);
    menuClose.addEventListener('click', toggleMenu);
    menuOverlay.addEventListener('click', toggleMenu);
    
    // Загрузка меню с сервера
    async function loadMenu() {
        try {
            const response = await fetch('/api/getMenu');
            const menuData = await response.json();
            renderMenu(menuData, menuList);
        } catch (error) {
            console.error('Ошибка загрузки меню:', error);
            menuList.innerHTML = '<li class="menu-item">Ошибка загрузки меню</li>';
        }
    }
    
    // Рекурсивная отрисовка меню
    function renderMenu(items, container) {
        items.forEach(item => {
            const li = document.createElement('li');
            li.className = 'menu-item';
            
            const hasChildren = item.children && item.children.length > 0;
            
            // Создаём ссылку
            const link = document.createElement('a');
            link.className = 'menu-link';
            link.href = item.url;
            link.textContent = item.title;
            
            // Если есть дети, добавляем стрелку и обработчик
            if (hasChildren) {
                link.href = 'javascript:void(0)';
                
                const arrow = document.createElement('span');
                arrow.className = 'menu-arrow';
                link.appendChild(arrow);
                
                li.appendChild(link);
                
                // Создаём подменю
                const submenu = document.createElement('ul');
                submenu.className = 'submenu';
                renderMenu(item.children, submenu);
                li.appendChild(submenu);
                
                // Обработчик клика для раскрытия
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    submenu.classList.toggle('active');
                    arrow.classList.toggle('rotate');
                });
            } else {
                li.appendChild(link);
            }
            
            container.appendChild(li);
        });
    }
    
    // Загружаем меню
    loadMenu();
});
```

