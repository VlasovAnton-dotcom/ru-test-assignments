3. Пакет pkg/storage/memory_storage.go
package storage

import (
	"sync"
	"github.
com/myorg/catalog-api/internal/models"
)

var (
	mu sync.RWMutex
	categories []*models.Category
	items      []*models.Item
	users      []*models.User
)

func init() {
	categories = make([]*models.Category, 0)
	items = make([]*models.Item, 0)
	users = make([]*models.User, 0)
}

func CreateCategory(category *models.Category) error {
	mu.Lock()
	defer mu.Unlock()
	category.ID = uint(len(categories) + 1)
	categories = append(categories, category)
	return nil
}

func GetAllCategories() ([]*models.Category, error) {
	mu.RLock()
	defer mu.RUnlock()
	return categories, nil
}

func DeleteCategory(id uint) error {
	mu.Lock()
	defer mu.Unlock()
	for i, cat := range categories {
		if cat.ID == id {
			categories = append(categories[:i], categories[i+1:]...)
			return nil
		}
	}
	return ErrNotFound
}
4. Пакет cmd/server.go
package main

import (
	"log"
	"net/http"
	"github.
com/gorilla/mux"
	"github.
com/myorg/catalog-api/internal/handlers"
)

func main() {
	router := mux.NewRouter()

	// Роуты для категорий
	router.HandleFunc("/categories", handlers.ListCategoriesHandler).Methods(http.MethodGet)
	router.HandleFunc("/category/{id}", handlers.GetCategoryHandler).Methods(http.MethodGet)
	router.HandleFunc("/category", handlers.CreateCategoryHandler).Methods(http.MethodPost)
	router.HandleFunc("/category/{id}", handlers.UpdateCategoryHandler).Methods(http.MethodPut)
	router.HandleFunc("/category/{id}", handlers.DeleteCategoryHandler).Methods(http.MethodDelete)

	log.Fatal(http.ListenAndServe(":8080", router))
}
5. Пакет internal/handlers/category_handlers.go
package handlers

import (
	"encoding/json"
	"fmt"
	"io/ioutil"
	"net/http"
	"strconv"
	"github.
com/myorg/catalog-api/internal/models"
	"github.
com/myorg/catalog-api/internal/services"
)

func ListCategoriesHandler(w http.ResponseWriter, r *http.Request) {
	cats, err := services.GetAllCategories()
	if err != nil {
		http.Error(w, fmt.Sprintf("Failed to retrieve categories: %v", err), http.StatusInternalServerError)
		return
	}
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(cats)
}

func CreateCategoryHandler(w http.ResponseWriter, r *http.Request) {
	body, err := ioutil.ReadAll(r.Body)
	if err != nil {
		http.Error(w, "Could not read body", http.StatusBadRequest)
		return
	}
	var cat models.Category
	err = json.Unmarshal(body, &cat)
	if err != nil {
		http.Error(w, "Invalid JSON", http.StatusBadRequest)
		return
	}
	createdCat, err := services.CreateCategory(cat.Name)
	if err != nil {
		http.Error(w, fmt.Sprintf("Failed to create category: %v", err), http.StatusInternalServerError)
		return
	}
	w.WriteHeader(http.StatusCreated)
	json.NewEncoder(w).Encode(createdCat)
}

