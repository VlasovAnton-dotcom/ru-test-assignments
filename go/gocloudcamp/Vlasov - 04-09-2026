from __future__ import annotations
from dataclasses import dataclass
from typing import Optional
import asyncio

@dataclass
class Song:
    title: str
    artist: str
    duration: float  # Длительность в секундах

class PlaylistNode:
    def __init__(self, song: Song):
        self.song = song
        self.prev: Optional[PlaylistNode] = None
        self.next: Optional[PlaylistNode] = None

class IPlaylistManager:
    async def play(self) -> None: ...
    async def pause(self) -> None: ...
    async def add_song(self, song: Song) -> None: ...
    async def next(self) -> None: ...
    async def prev(self) -> None: ...
Реализация двусвязного списка и управления воспроизведением
Ключевые требования — неблокирующее воспроизведение и потокобезопасность — решаются через комбинацию asyncio.Lock (для защиты структуры списка) и фоновой корутины-эмулятора плеера.
pythonКопировать
import uuid

class AsyncDoublyLinkedPlaylist(IPlaylistManager):
    def __init__(self):
        self.head: Optional[PlaylistNode] = None
        self.tail: Optional[PlaylistNode] = None
        self.current_node: Optional[PlaylistNode] = None
        
        self._playback_task: Optional[asyncio.Task] = None
        self._is_paused = False
        self._current_position = 0.0
        
        # Лок для конкурентного доступа к структуре списка
        self._list_lock = asyncio.Lock()
        # Событие для синхронизации паузы/продолжения
        self._play_event = asyncio.Event()
        self._play_event.set() # Изначально разрешаем воспроизведение

    async def _emulate_playback(self, node: PlaylistNode):
        """Фоновая задача эмуляции воспроизведения."""
        try:
            remaining_time = node.song.duration - self._current_position
            start_time = asyncio.get_event_loop().time()
            
            while remaining_time > 0:
                if self._is_paused:
                    await self._play_event.wait()
                
                # Проверка времени с учетом возможной паузы
                elapsed = asyncio.get_event_loop().time() - start_time
                actual_elapsed = elapsed - sum(pause_durations) # Упрощенно: считаем чистое время
                
                if actual_elapsed >= node.song.duration:
                    break
                    
                await asyncio.sleep(0.1)
                remaining_time = node.song.duration - actual_elapsed

            # Автоматический переход к следующей песне
            await self.next()
        except asyncio.CancelledError:
            pass

    async def play(self) -> None:
        async with self._list_lock:
            if not self.current_node and self.head:
                self.current_node = self.head
                self._current_position = 0.0

            if self.current_node and not self._playback_task:
                self._is_paused = False
                self._play_event.set()
                self._playback_task = asyncio.create_task(
                    self._emulate_playback(self.current_node)
                )
            elif self._is_paused:
                self._is_paused = False
                self._play_event.set()

    async def pause(self) -> None:
        async with self._list_lock:
            if self._playback_task and not self._is_paused:
                self._is_paused = True
                self._play_event.clear()

    async def add_song(self, song: Song) -> None:
        new_node = PlaylistNode(song)
        async with self._list_lock:
            if not self.head:
                self.head = self.tail = new_node
            else:
                assert self.tail is not None
                self.tail.next = new_node
                new_node.prev = self.tail
                self.tail = new_node

    async def next(self) -> None:
        async with self._list_lock:
            if self._playback_task:
                self._playback_task.cancel()
            
            if self.current_node and self.current_node.next:
                self.current_node = self.current_node.next
            elif self.head:
                self.current_node = self.head # Зацикливание
            else:
                self.current_node = None
                return

            self._current_position = 0.0
            self._is_paused = False
            self._play_event.set()
            if self.current_node:
                self._playback_task = asyncio.create_task(
                    self._emulate_playback(self.current_node)
                )

    async def prev(self) -> None:
        async with self._list_lock:
            if self._playback_task:
                self._playback_task.cancel()

            if self.current_node and self.current_node.prev:
                self.current_node = self.current_node.prev
            elif self.tail:
                self.current_node = self.tail # Зацикливание назад
            else:
                self.current_node = None
                return

            self._current_position = 0.0
            self._is_paused = False
            self._play_event.set()
            if self.current_node:
                self._playback_task = asyncio.create_task(
                    self._emulate_playback(self.current_node)
                )
Оптимизация производительности: Все операции изменения указателей (prev, next) обернуты в asyncio.Lock. Это исключает состояние гонки (race condition), когда один поток пытается добавить песню в конец, пока другой переключает трек. Использование легковесных потоков ОС (корутин) позволяет методам управления мгновенно возвращать управление, не блокируя CPU ожиданием завершения трека.
Unit-тестирование (пример): Тест должен проверять автоматический переход и работу паузы без реального ожидания длительности песни (через мокинг asyncio.sleep).
