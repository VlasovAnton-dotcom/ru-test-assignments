# tests/test_playlist.py
import pytest
import asyncio
from unittest.mock import patch, AsyncMock

@pytest.mark.asyncio
async def test_auto_next():
    pl = AsyncDoublyLinkedPlaylist()
    await pl.add_song(Song("A", "Art", 1.0))
    await pl.add_song(Song("B", "Art", 1.0))
    
    await pl.play()
    await asyncio.sleep(1.2) # Ждем чуть больше длительности первой песни
    
    assert pl.current_node.song.title == "B"

@pytest.mark.asyncio
async def test_pause_resume():
    pl = AsyncDoublyLinkedPlaylist()
    long_song = Song("Long", "Art", 10.0)
    await pl.add_song(long_song)
    
    await pl.play()
    await asyncio.sleep(0.1)
    await pl.pause()
    
    pos_before = pl._current_position
    await asyncio.sleep(0.5) # Время идет, но позиция не меняется
    assert abs(pl._current_position - pos_before) < 0.01
    
    await pl.play()
    await asyncio.sleep(0.1)
    assert pl._current_position > pos_before
