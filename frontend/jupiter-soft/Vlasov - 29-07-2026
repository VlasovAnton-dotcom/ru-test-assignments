## `Gallery.jsx`

```jsx
import React, { useState } from 'react';
import styles from './Gallery.module.css';
import { initialImages, categories } from '../data';

const Gallery = () => {
  const [images, setImages] = useState(initialImages);
  const [category, setCategory] = useState('Show all');
  const [selectedId, setSelectedId] = useState(null); // для подсветки и удаления

  // Фильтрация
  const filtered =
    category === 'Show all'
      ? images
      : images.filter((img) => img.category === category);

  // Load more: добавляем «новые» картинки (те же, но с суффиксом)
  const handleLoadMore = () => {
    const currentLength = images.length;
    const nextBatch = [];
    for (let i = 0; i < 9; i++) {
      const original = images[(currentLength + i) % images.length];
      nextBatch.push({
        ...original,
        id: Date.now() + i, // уникальный ID
        title: `${original.title} (copy ${i + 1})`,
        src: `${original.src}&t=${Date.now()}`, // чтобы не кэшировалось
      });
    }
    setImages((prev) => [...prev, ...nextBatch]);
  };

  const handleSelect = (id) => {
    setSelectedId((prev) => (prev === id ? null : id));
  };

  const handleDelete = () => {
    if (selectedId === null) return;
    setImages((prev) => prev.filter((img) => img.id !== selectedId));
    setSelectedId(null);
  };

  return (
    <div className={styles.galleryContainer}>
      <div className={styles.controls}>
        <div className={styles.filters}>
          {categories.map((cat) => (
            <button
              key={cat}
              className={`${styles.filterBtn} ${category === cat ? styles.active : ''}`}
              onClick={() => setCategory(cat)}
            >
              {cat}
            </button>
          ))}
        </div>
        <button className={styles.loadMoreBtn} onClick={handleLoadMore}>
          Load more
        </button>
        {selectedId !== null && (
          <button className={styles.deleteBtn} onClick={handleDelete}>
            Del
          </button>
        )}
      </div>

      <div className={styles.grid}>
        {filtered.length === 0 ? (
          <p className={styles.noResults}>No images for this category</p>
        ) : (
          filtered.map((img) => (
            <div
              key={img.id}
              className={`${styles.card} ${selectedId === img.id ? styles.selected : ''}`}
              onClick={() => handleSelect(img.id)}
            >
              <img src={img.src} alt={img.title} className={styles.image} />
              <div className={styles.overlay}>
                <span className={styles.categoryTag} onClick={(e) => {
                  e.stopPropagation();
                  setCategory(img.category);
                }}>
                  {img.category}
                </span>
                <span className={styles.title}>{img.title}</span>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  );
};

export default Gallery;
```

