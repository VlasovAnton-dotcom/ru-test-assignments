import React, { useMemo } from 'react';
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceArea,
  Dot
} from 'recharts';

// Генерация тестовых данных (аналогично примеру SimpleLineChart)
const generateData = (count = 30) => {
  const data = [];
  for (let i = 0; i < count; i++) {
    data.push({
      name: `P${i + 1}`,
      uv: Math.round(Math.random() * 300 + 100)
    });
  }
  return data;
};

// Функция расчета Z-score согласно справке (Standard Score)
const calculateZScores = (data, key) => {
  const values = data.map(item => item[key]);
  const mean = values.reduce((a, b) => a + b, 0) / values.length;
  const stdDev = Math.sqrt(
    values.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / values.length
  );

  // Защита от деления на ноль
  if (stdDev === 0) return data.map(() => 0);

  return data.map(item => ({
    ...item,
    zScore: (item[key] - mean) / stdDev
  }));
};

const SimpleLineChart = () => {
  const rawData = useMemo(() => generateData(), []);
  
  // Вычисляем Z-score один раз при монтировании
  const dataWithZ = useMemo(() => calculateZScores(rawData, 'uv'), [rawData]);

  // Находим индексы всех точек, удовлетворяющих условию
  const highZIndices = dataWithZ
    .map((item, index) => (item.zScore > 1 ? index : -1))
    .filter(index => index !== -1);

  // Группируем индексы в непрерывные области для ReferenceArea
  const referenceAreas = [];
  if (highZIndices.length > 0) {
    let start = highZIndices[0];
    let prev = highZIndices[0];

    for (let i = 1; i < highZIndices.length; i++) {
      if (highZIndices[i] === prev + 1) {
        prev = highZIndices[i];
      } else {
        referenceAreas.push({ start, end: prev });
        start = highZIndices[i];
        prev = highZIndices[i];
      }
    }
    referenceAreas.push({ start, end: prev });
  }

  return (
    <ResponsiveContainer width="100%" height={300}>
      <LineChart data={dataWithZ} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>
        <CartesianGrid strokeDasharray="3 3" />
        <XAxis dataKey="name" />
        <YAxis />
        <Tooltip />
        
        {/* Красные области фона */}
        {referenceAreas.map((area, idx) => (
          <ReferenceArea
            key={`red-${idx}`}
            x1={dataWithZ[area.start].name}
            x2={dataWithZ[area.end].name}
            y1={0}
            y2={400}
            fill="red"
            fillOpacity={0.1}
          />
        ))}

        {/* Линия графика */}
        <Line
          type="monotone"
          dataKey="uv"
          stroke="#8884d8"
          strokeWidth={2}
          dot={false} 
          activeDot={{ r: 6, stroke: '#8884d8', strokeWidth: 2 }}
        >
          {/* Кастомные точки, цвет которых зависит от Z-score */}
          {dataWithZ.map((entry, index) => (
            <Dot
              key={`dot-${index}`}
              cx={entry.name}
              cy={entry.uv}
              r={6}
              fill={entry.zScore > 1 ? 'red' : '#8884d8'}
              stroke={entry.zScore > 1 ? 'darkred' : '#8884d8'}
              strokeWidth={2}
            />
          ))}
        </Line>
      </LineChart>
    </ResponsiveContainer>
  );
};

export default SimpleLineChart;
