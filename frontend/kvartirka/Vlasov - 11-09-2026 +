Ключевые реализации
1. Работа с API NASA (lib/nasaApi.ts)

API NeoWs требует ключ. Бесплатный ключ DEMO_KEY имеет жесткие лимиты. В коде предусмотрена обработка ошибок лимитов (код 429).
Для получения всех сближений конкретного астероида по его nasa_jpl_url используется эндпоинт /neo/{asteroid_id}.

typescript
Копировать
// lib/nasaApi.ts
const API_URL = 'https://api.nasa.gov/neo/rest/v1';
const API_KEY = process.env.NASA_API_KEY || 'DEMO_KEY';

export async function fetchAsteroids(startDate: string, endDate: string) {
  const res = await fetch(`${API_URL}/feed?start_date=${startDate}&end_date=${endDate}&api_key=${API_KEY}`);
  if (!res.ok) throw new Error('Failed to fetch asteroids');
  return res.json();
}

export async function fetchAsteroidDetails(asteroidId: string) {
  const res = await fetch(`${API_URL}/neo/${asteroidId}?api_key=${API_KEY}`);
  if (!res.ok) throw new Error('Failed to fetch asteroid details');
  return res.json();
}
2. Бесконечный скролл (app/page.tsx + hooks/useAsteroids.ts)

Вместо тяжелых библиотек типа react-infinite-scroll-component используется нативный Intersection Observer. 

На главной странице отображаются только те астероиды, чей close_approach_data[0].close_approach_date_full больше или равен текущей дате.
При приближении последнего элемента списка к низу экрана хук запрашивает следующую неделю данных.
typescript
Копировать
// hooks/useAsteroids.ts
import { useState, useEffect, useCallback, useRef } from 'react';
import { fetchAsteroids } from '../lib/nasaApi';
import { format, addDays, parseISO } from 'date-fns';

export function useAsteroids() {
  const [items, setItems] = useState<any[]>([]);
  const [pageDate, setPageDate] = useState(format(new Date(), 'yyyy-MM-dd'));
  const loaderRef = useRef(null);

  const loadMore = useCallback(async () => {
    // Запрашиваем окно в 7 дней
    const data = await fetchAsteroids(pageDate, format(addDays(parseISO(pageDate), 6), 'yyyy-MM-dd'));
    
    const neoArray = Object.values(data.near_earth_objects).flat();
    // Фильтруем будущие подлеты
    const futureNeo = neoArray.filter((a) => 
      a.close_approach_data.some(d => d.close_approach_date_full >= new Date().toISOString())
    );

    setItems(prev => Array.from(new Map([...prev, ...futureNeo].map(item => [item.id, item])).values()));
    setPageDate(format(addDays(parseISO(pageDate), 7), 'yyyy-MM-dd'));
  }, [pageDate]);

  useEffect(() => {
    loadMore();
  }, []);

  useEffect(() => {
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) loadMore();
    });
    if (loaderRef.current) observer.observe(loaderRef.current);
    return () => observer.disconnect();
  }, [loadMore]);

  return { items, loaderRef };
}
3. Управление корзиной (context/CartContext.ts)

Используется React.createContext. Контекст провайдера оборачивает корневой лейаут. Это позволяет вызывать добавление в корзину из любой глубины дерева компонентов без пропс-дриллинга.

typescript
Копировать
// context/CartContext.tsx
interface CartContextType {
  items: any[];
  addToCart: (asteroid: any, approach: any) => void;
  removeFromCart: (id: string) => void;
}

export const CartContext = createContext<CartContextType | null>(null);

export function CartProvider({ children }) {
  const [items, setItems] = useState([]);
  
  const addToCart = (asteroid, approach) => {
    setItems(prev => [...prev, { id: crypto.randomUUID(), asteroid, approach }]);
  };

  const removeFromCart = (id) => {
    setItems(prev => prev.filter(i => i.id !== id));
  };

  return (
    <CartContext.Provider value={{ items, addToCart, removeFromCart }}>
      {children}
    </CartContext.Provider>
  );
}
4. Конвертер расстояний (lib/utils.ts)

Пользователь может переключать единицы измерения. По умолчанию — километры.

typescript
Копировать
// lib/utils.ts
const MOON_DISTANCE_KM = 384400;

export function convertDistance(km: number, unit: 'km' | 'moon'): string {
  if (unit === 'moon') {
    return `${(km / MOON_DISTANCE_KM).toFixed(2)} LD`;
  }
  return km.toLocaleString() + ' km';
}
