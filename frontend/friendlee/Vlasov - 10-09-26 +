class LeasingCalculator {
    constructor() {
        // DOM Elements
        this.costInput = document.querySelector('#cost');
        this.costRange = document.querySelector('#cost-range');
        
        this.downPaymentInput = document.querySelector('#down-payment');
        this.downPaymentPercent = document.querySelector('#down-payment-percent');
        this.downPaymentRange = document.querySelector('#down-payment-range');
        
        this.termInput = document.querySelector('#term');
        this.termRange = document.querySelector('#term-range');

        this.totalAmount = document.querySelector('#total-amount');
        this.monthlyPayment = document.querySelector('#monthly-payment');
        this.submitBtn = document.querySelector('#submit-btn');

        // Constants
        this.MIN_COST = 1500000;
        this.MAX_COST = 10000000;
        this.MIN_TERM = 6;
        this.MAX_TERM = 120;
        this.RATE = 0.05; // 5% per month as per formula

        if (this.costInput && this.submitBtn) {
            this.init();
        }
    }

    // Ограничение значения рамками [min, max]
    clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
    }

    // Форматирование чисел (пробел как разделитель тысяч)
    formatCurrency(n) {
        return new Intl.NumberFormat('ru-RU').format(Math.round(n));
    }

    updateCostFromSlider() {
        const value = parseInt(this.costRange.value);
        this.costInput.value = this.formatCurrency(value);
        this.updateDownPaymentBoundaries();
        this.calculate();
    }

    updateCostFromInput(e) {
        let value = parseInt(e.target.value.replace(/\s/g, '')) || this.MIN_COST;
        value = this.clamp(value, this.MIN_COST, this.MAX_COST);
        
        // Если ввели некорректное число, сбрасываем к ближайшей границе
        if (e.target.value.replace(/\s/g, '') != value) {
            e.target.value = this.formatCurrency(value);
        }
        
        this.costRange.value = value;
        this.updateDownPaymentBoundaries();
        this.calculate();
    }

    updateDownPaymentBoundaries() {
        const cost = parseInt(this.costRange.value);
        const minDp = Math.round(cost * 0.10);
        const maxDp = Math.round(cost * 0.60);

        this.downPaymentRange.min = minDp;
        this.downPaymentRange.max = maxDp;
        
        // Корректируем текущее значение взноса, если вышли за границы
        const currentDp = parseInt(this.downPaymentRange.value);
        if (currentDp < minDp) this.downPaymentRange.value = minDp;
        if (currentDp > maxDp) this.downPaymentRange.value = maxDp;

        this.downPaymentInput.min = minDp;
        this.downPaymentInput.max = maxDp;
    }

    updateDownPaymentFromSlider() {
        const value = parseInt(this.downPaymentRange.value);
        this.downPaymentInput.value = this.formatCurrency(value);
        this.updateDownPaymentPercent();
        this.calculate();
    }

    updateDownPaymentFromInput(e) {
        const cost = parseInt(this.costRange.value);
        let value = parseInt(e.target.value.replace(/\s/g, '')) || this.downPaymentRange.min;
        value = this.clamp(value, this.downPaymentRange.min, this.downPaymentRange.max);

        if (e.target.value.replace(/\s/g, '') != value) {
            e.target.value = this.formatCurrency(value);
        }

        this.downPaymentRange.value = value;
        this.updateDownPaymentPercent();
        this.calculate();
    }

    updateDownPaymentPercent() {
        const cost = parseInt(this.costRange.value);
        const dp = parseInt(this.downPaymentRange.value);
        const percent = Math.round((dp / cost) * 100);
        this.downPaymentPercent.textContent = `${percent}%`;
    }

    updateTermFromSlider() {
        this.termInput.value = this.termRange.value;
        this.calculate();
    }

    updateTermFromInput(e) {
        let value = parseInt(e.target.value) || this.MIN_TERM;
        value = this.clamp(value, this.MIN_TERM, this.MAX_TERM);
        
        if (e.target.value != value) {
            e.target.value = value;
        }
        this.termRange.value = value;
        this.calculate();
    }

    calculateMonthlyPayment(principal, term) {
        if (term === 0) return 0;
        const pow = Math.pow((1 + this.RATE), term);
        return principal * (this.RATE * pow / (pow - 1));
    }

    calculate() {
        const cost = parseInt(this.costRange.value);
        const downPayment = parseInt(this.downPaymentRange.value);
        const term = parseInt(this.termRange.value);

        const principal = cost - downPayment;
        const monthlyPaymentValue = this.calculateMonthlyPayment(principal, term);
        const totalAmountValue = downPayment + (monthlyPaymentValue * term);

        this.monthlyPayment.textContent = this.formatCurrency(monthlyPaymentValue);
        this.totalAmount.textContent = this.formatCurrency(totalAmountValue);
    }

    handleSubmit() {
        const data = {
            car_cost: parseInt(this.costRange.value),
            down_payment: parseInt(this.downPaymentRange.value),
            lease_term_months: parseInt(this.termRange.value),
            calculated: {
                monthly_payment: parseFloat(this.monthlyPayment.textContent.replace(/\s/g, '').replace(',', '.')),
                total_amount: parseFloat(this.totalAmount.textContent.replace(/\s/g, '').replace(',', '.'))
            }
        };
        
        this.submitBtn.disabled = true;
        this.submitBtn.textContent = 'Отправляем...';

        alert(JSON.stringify(data, null, 2));

        // Эмуляция задержки сервера
        setTimeout(() => {
            this.submitBtn.disabled = false;
            this.submitBtn.textContent = 'Оформить заявку';
        }, 2000);
    }

    init() {
        // Устанавливаем начальные значения из Фигмы (примерные, замените на свои)
        this.costRange.value = 5000000;
        this.costInput.value = this.formatCurrency(5000000);

        this.updateDownPaymentBoundaries();
        
        this.downPaymentRange.value = 1000000; // 20%
        this.downPaymentInput.value = this.formatCurrency(1000000);
        this.updateDownPaymentPercent();

        this.termRange.value = 36;
        this.termInput.value = 36;

        // Слушатели событий (для динамики во время движения ползунка)
        this.costRange.addEventListener('input', () => this.updateCostFromSlider());
        this.costInput.addEventListener('change', (e) => this.updateCostFromInput(e));

        this.downPaymentRange.addEventListener('input', () => this.updateDownPaymentFromSlider());
        this.downPaymentInput.addEventListener('change', (e) => this.updateDownPaymentFromInput(e));

        this.termRange.addEventListener('input', () => this.updateTermFromSlider());
        this.termInput.addEventListener('change', (e) => this.updateTermFromInput(e));

        this.submitBtn.addEventListener('click', () => this.handleSubmit());

        this.calculate(); // Первичный расчет при загрузке
    }
}

document.addEventListener('DOMContentLoaded', () => {
    new LeasingCalculator();
});
