// src/js/components/calculator.js (упрощенный фрагмент)
class Calculator {
    constructor(config) {
        this.state = { 
            carCost: config.carCost, 
            downPayment: config.downPayment, 
            term: config.term,
            rate: 0.05 // Жестко задано в формуле из ТЗ
        };
        this.bindUI();
        this.updateAll();
    }

    bindUI() {
        // Привязка событий input к полям и слайдерам
        document.querySelector('.calculator__input[name="cost"]').addEventListener('input', (e) => {
            const val = Math.max(1500000, Math.min(10000000, Number(e.target.value.replace(/\D/g, ''))));
            this.state.carCost = val;
            e.target.value = this.formatNumber(val);
            this.recalcDownPaymentPercent(); // Пересчет % при изменении стоимости
            this.updateAll();
        });
        
        // Аналогично для других полей и 'input' event от ползунков (range)
    }

    calculateMonthlyPayment() {
        const principal = this.state.carCost - this.state.downPayment;
        const n = this.state.term;
        const r = this.state.rate;
        if (n === 0) return 0;
        // Формула из ТЗ
        return principal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    recalcDownPaymentPercent() {
        // Обновляет скрытое поле или визуальное отображение "%"
        const percent = Math.round((this.state.downPayment / this.state.carCost) * 100);
        // ... обновление UI
    }
    
    formatNumber(num) {
        return new Intl.NumberFormat('ru-RU').format(num);
    }
}

Ползунки (Range Input):
Для кроссбраузерности стилизации стандартный <input type="range"> оборачивается в кастомный блок .slider. В JavaScript отслеживается событие input (а не change), чтобы значения обновлялись мгновенно во время движения пальца/курсора.

Ограничения ввода:
При событии blur или keydown (Enter) значение поля проверяется. Если оно меньше минимума — устанавливается минимум. Если больше максимума — максимум. При вводе с клавиатуры символы фильтруются через regex /[^0-9]/g.

