2. CSS-стили (styles.css)
Гексагон создается через свойство clip-path. Плавные анимации заданы через transition. Позиционирование элементов происходит за счет смены классов flex-контейнером.
cssКопировать
:root {
    --primary-color: #0d47a1;
    --accent-color: #ff9800;
    --text-light: #f0f0f0;
    --bg-dark: #121212;
    --transition-speed: 0.5s;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-light);
    overflow-x: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* --- ШАПКА --- */
.main-header {
    width: 100%;
    background-color: rgba(18, 18, 18, 0.9);
    backdrop-filter: blur(10px);
    position: fixed;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.header-content {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--accent-color);
    text-decoration: none;
    transition: color var(--transition-speed) ease;
}
.logo:hover {
    color: #ffb74d;
}

.nav-links a {
    margin-left: 30px;
    color: var(--text-light);
    text-decoration: none;
    position: relative;
    transition: color var(--transition-speed) ease;
}
.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-color);
    transition: width var(--transition-speed) ease;
}
.nav-links a:hover {
    color: var(--accent-color);
}
.nav-links a:hover::after {
    width: 100%;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* --- ОСНОВНОЙ КОНТЕНТ --- */
.main-content {
    flex-grow: 1;
    margin-top: 120px; /* Отступ под фиксированную шапку */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding-bottom: 100px;
}

.hexagon-track {
    perspective: 1000px;
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
}

#hexagon-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: -30px; /* Наложение гексагонов друг на друга */
    transform-style: preserve-3d;
    position: relative;
    z-index: 10;
}

.hexagon-item {
    width: 200px;
    height: 230px;
    background: linear-gradient(145deg, #1e1e1e, #161616);
    border: 1px solid #333;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
    position: relative;
    transition: all calc(var(--transition-speed) * 1.2) cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.6;
    filter: brightness(0.8);
    transform: scale(0.9) rotateX(15deg);
}

/* Эффект объема */
.hexagon-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    clip-path: inherit;
    transform: translateZ(-10px);
    opacity: 0.3;
    border: none;
}

/* Центральное состояние */
.hexagon-item.center {
    width: 280px;
    height: 320px;
    background: linear-gradient(145deg, #1a2a6c, #b21f1f, #fdbb2d);
    border: 2px solid var(--accent-color);
    opacity: 1;
    filter: brightness(1);
    transform: scale(1.1) rotateX(0deg) translateZ(50px);
    z-index: 50;
    pointer-events: auto;
}

/* Содержимое внутри гексагона */
.hexagon-content {
    text-align: center;
    transition: opacity var(--transition-speed) ease;
}

.date-label {
    font-size: 1.2rem;
    font-weight: bold;
    display: block;
    margin-bottom: 10px;
}

.details-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all var(--transition-speed) ease;
    line-height: 1.6;
}

.hexagon-item.center .date-label {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
}

.hexagon-item.center .details-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

/* Индикаторы границ скролла */
.scroll-indicators {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 15px;
    z-index: 20;
}
.indicator {
    width: 12px;
    height: 12px;
    border: solid var(--text-light);
    border-width: 0 2px 2px 0;
    padding: 3px;
    opacity: 0.3;
    transition: opacity 0.3s ease;
}
.up { transform: rotate(-135deg); }
.down { transform: rotate(45deg); }

/* Изменяем прозрачность индикаторов при достижении краев */
.hexagon-track.at-top .up,
.hexagon-track.at-bottom .down {
    opacity: 0.1;
    pointer-events: none;
}

/* Тень для центрального элемента */
.hexagon-item.center::after {
    content: '';
    position: absolute;
    inset: -40px;
    background: radial-gradient(circle at center, rgba(255, 152, 0, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(20px);
    pointer-events: none;
    animation: pulse-glow 3s infinite alternate;
}

@keyframes pulse-glow {
    from { opacity: 0.4; }
    to { opacity: 0.6; }
}

/* Адаптивность */
@media (max-width: 768px) {
    .hexagon-item {
        width: 160px;
        height: 185px;
    }
    .hexagon-item.center {
        width: 220px;
        height: 255px;
    }
    .header-content {
        height: 60px;
    }
    .main-content {
        margin-top: 100px;
    }
}
3. Логика на JavaScript (script.js)
Скрипт перехватывает события колеса мыши (wheel) и клика. Он управляет массивом данных о матчах, циклически сдвигает его и применяет соответствующие классы к DOM-элементам. Чтобы анимация не ломалась при быстрой прокрутке, используется флаг блокировки (isAnimating).
javascriptКопировать
document.addEventListener('DOMContentLoaded', () => {
    const hexList = document.getElementById('hexagon-list');
    const items = Array.from(document.querySelectorAll('.hexagon-item'));
    const track = document.querySelector('.hexagon-track');
    
    // Данные матчей (в реальности могут подгружаться с сервера)
    const matchesData = [
        { date: "10 ИЮНЯ", title: "Тренировочный сбор", details: ["Закрытое мероприятие"] },
        { date: "17 ИЮНЯ", title: "Товарищеский матч", details: ["Соперник: Сборная Италии", "Билеты: от 1500 ₽"] },
        { date: "26 ИЮНЯ", title: "Матч открытия", details: ["Соперник: Сборная Бразилии", "Стадион: Газпром Арена"] },
        { date: "16 ИЮЛЯ", title: "Полуфинал", details: ["Соперник: Сборная Германии", "Начало: 21:00"] },
        { date: "30 СЕНТЯБРЯ", title: "Финал Лиги Чемпионов", details: ["Стадион: Лужники", "Билеты: Продано"] }
    ];

    let currentIndex = 2; // Индекс текущего центрального элемента в массиве matchesData
    let isAnimating = false;

    function updateHexagons() {
        isAnimating = true;
        
        // Обновляем данные в DOM
        items.forEach((item, i) => {
            // Вычисляем индекс данных относительно центра (i=2 это центр из 5 элементов)
            const dataIndex = (currentIndex + (i - 2) + matchesData.length) % matchesData.length;
            const match = matchesData[dataIndex];
            
            item.querySelector('.date-label').textContent = match.date;
            item.querySelector('h2').textContent = match.title;
            
            const detailsContainer = item.querySelector('.details-panel');
            detailsContainer.innerHTML = '<h2>' + match.title + '</h2>';
            match.details.forEach(detail => {
                const p = document.createElement('p');
                p.textContent = detail;
                detailsContainer.appendChild(p);
            });

            // Назначаем позиции
            if (i === 2) {
                item.className = 'hexagon-item center';
            } else if (i === 1) {
                item.className = 'hexagon-item left-inner';
            } else if (i === 0) {
                item.className = 'hexagon-item left-outer';
            } else if (i === 3) {
                item.className = 'hexagon-item right-inner';
            } else if (i === 4) {
                item.className = 'hexagon-item right-outer';
            }
        });

        // Проверка границ для стрелок
        checkBoundaries();

        setTimeout(() => {
            isAnimating = false;
        }, 600); // Время должно быть чуть больше или равно длительности transition в CSS
    }

    function scrollDown() {
        if (isAnimating) return;
        currentIndex = (currentIndex + 1) % matchesData.length;
        updateHexagons();
    }

    function scrollUp() {
        if (isAnimating) return;
        currentIndex = (currentIndex - 1 + matchesData.length) % matchesData.length;
        updateHexagons();
    }

    // Клик по любому гексагону перемещает его в центр
    items.forEach(item => {
        item.addEventListener('click', () => {
            if (isAnimating || item.classList.contains('center')) return;
            
            const clickedIndex = parseInt(item.dataset.index);
            // Разница между текущим центром и кликнутым элементом
            const diff = (clickedIndex - currentIndex + matchesData.length) % matchesData.length;

            if (diff <= 2) {
                // Кликаем на левый блок -> крутим вверх
                for(let i=0; i<diff; i++) scrollUp();
            } else {
                // Кликаем на правый блок -> крутим вниз
                for(let i=0; i<matchesData.length-diff; i++) scrollDown();
            }
        });
    });

    // Скролл колесом мыши
    track.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (isAnimating) return;

        if (e.deltaY > 0) {
            scrollDown();
        } else {
            scrollUp();
        }
    });

    function checkBoundaries() {
        // Если центральный элемент совпадает с первым или последним в списке доступных переходов
        // В данной кольцевой логике края бесконечны, поэтому просто пример управления UI
        // Если бы логика была линейной, здесь были бы условия:
        // track.classList.toggle('at-top', currentIndex === 0);
        // track.classList.toggle('at-bottom', currentIndex === matchesData.length - 1);
        
        // Для демонстрации оставим индикаторы полупрозрачными всегда, так как скролл кольцевой
        track.classList.remove('at-top', 'at-bottom');
    }

    // Инициализация
    updateHexagons();
});
Как подключить файлы:
1.	Создайте папку проекта.
2.	Сохраните разметку в файл index.html.
3.	Создайте рядом папку css и сохраните туда стили как styles.css.
4.	Создайте папку js и сохраните туда скрипт как script.js.
5.	Откройте index.html в браузере.
Важные детали реализации:
•	Анимация перемещения: достигается за счет одновременного изменения размеров (width, height), фона, тени (transform: translateZ, scale) и поворота (rotateX) у всех пяти блоков. Свойство gap: -30px во флекс-контейнере создает эффект наложения, а плавность обеспечивается transition в CSS.
•	Кольцевая структура: алгоритм использует остаток от деления %, что позволяет бесконечно крутить карусель в обе стороны без ошибок индексации.
•	Синхронизация контента: смена даты на панель с деталями управляется простым переключением видимости (opacity, visibility) двух дочерних блоков .date-label и .details-panel в зависимости от класса center.
•	Производительность: использование transform и opacity выносит анимацию на композитный слой GPU, обеспечивая стабильные 60 FPS даже на слабых устройствах.

