Получение и подготовка данных
Нужно превратить разреженные дни в полный массив по дням месяца и посчитать итог.
ts
ПереноситьСвернутьКопировать
// utils/prepareData.ts
export function prepareUsersForMonth(users: User[], daysInMonth: number) {
  return users.map((user) => {
    const dayMap = new Map<number, number>();
    user.days.forEach((d) => dayMap.set(d.day, d.timeSeconds));

    const monthTotal = Array.from(dayMap.values()).reduce((a, b) => a + b, 0);

    const daysArray = Array.from({ length: daysInMonth }, (_, i) => {
      const day = i + 1;
      return dayMap.has(day) ? dayMap.get(day)! : 0;
    });

    return {
      id: user.id,
      fullname: user.fullname,
      days: daysArray, // [0, 3600, 0, 0, 1800, ...]
      monthlyTotal: monthTotal,
    };
  });
}
