2. Роутинг и боковое меню (App.tsx)

Реализуйте сайдбар со ссылкой «Клиенты -> Список клиентов». Для имитации авторизации можно использовать простую проверку токена или оставить публичный доступ.

typescript
Копировать
// src/App.tsx
import { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';
import SidebarLayout from './layouts/SidebarLayout';
import UserList from './pages/clients/UserList';
import UserEdit from './pages/clients/UserEdit';

function App() {
  return (
    <Router>
      <Routes>
        {/* Основной лейаут админки */}
        <Route element={<SidebarLayout />}>
          <Route path="/" element={<Navigate to="/clients" replace />} />
          <Route path="/clients" element={<UserList />} />
          <Route path="/clients/:id/edit" element={<UserEdit />} />
        </Route>
      </Routes>
    </Router>
  );
}

export default App;

