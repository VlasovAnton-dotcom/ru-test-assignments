2. Логика доски (Drag and Drop + Canvas-like контейнер)

Используем абсолютное позиционирование внутри контейнера.

typescript
Копировать
// src/pages/Planner.tsx
import { useRef, useState } from 'react';
import { furnitureCatalog } from '../data/furniture';

interface PlacedItem {
  catalogId: string;
  x: number;
  y: number;
}

const Planner = () => {
  const boardRef = useRef<HTMLDivElement>(null);
  const [items, setItems] = useState<PlacedItem[]>([]);
  const [catalog] = useState(furnitureCatalog);
  const [draggingId, setDraggingId] = useState<string | null>(null);

  // Берем объект из каталога при начале перетаскивания
  const handleDragStart = (e: React.DragEvent, id: string) => {
    setDraggingId(id);
    e.dataTransfer.setData('text/plain', id); // Обязательно для Firefox
    e.dataTransfer.effectAllowed = 'move';
  };

  const handleDrop = (e: React.DragEvent) => {
    e.preventDefault();
    if (!draggingId || !boardRef.current) return;
    
    const rect = boardRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    setItems(prev => [...prev, { catalogId: draggingId, x, y }]);
    setDraggingId(null);
  };

  const handleDragOver = (e: React.DragEvent) => {
    e.preventDefault(); // Обязательное условие для срабатывания drop
  };

  const findObjectById = (id: string) => catalog.find(obj => obj.id === id);

  const saveLayout = () => {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(items));
    const downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href", dataStr);
    downloadAnchorNode.setAttribute("download", "layout.json");
    document.body.appendChild(downloadAnchorNode);
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
  };

  const loadLayout = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const parsed = JSON.parse(e.target?.result as string);
        setItems(parsed);
      } catch {}
    };
    reader.readAsText(file);
  };

  return (
    <div>
      <h2>2D Планировщик</hdiv>
      
      {/* Панель выбора объектов */}
      <div style={{ marginBottom: 20 }}>
        {catalog.map(obj => (
          <div 
            key={obj.id} 
            draggable 
            onDragStart={(e) => handleDragStart(e, obj.id)}
            style={{ cursor: 'grab', display: 'inline-block', marginRight: 15 }}
          >
            <img src={obj.url} alt={obj.name} width={obj.width / 2} height={obj.height / 2} /><br/>
            <small>{obj.name}</small>
          </div>
        ))}
      </div>

      {/* Кнопки сохранения/загрузки */}
      <div style={{ marginBottom: 10 }}>
        <button onClick={saveLayout}>Сохранить расстановку</button>
        <input type="file" accept=".json" onChange={loadLayout} style={{ marginLeft: 10 }} />
      </div>

      {/* Доска */}
      <div 
        ref={boardRef}
        onDrop={handleDrop}
        onDragOver={handleDragOver}
        style={{
          position: 'relative',
          width: '100%',
          height: '500px',
          border: '2px dashed #ccc'
        }}
      >
        {items.map((item, index) => {
          const obj = findObjectById(item.catalogId);
          if (!obj) return null;
          return (
            <img
              key={index}
              src={obj.url}
              alt=""
              draggable // Позволяем двигать уже поставленные объекты
              onDragStart={(e) => {
                // Можно добавить логику перемещения существующих объектов
                // Пока просто запрещаем перенос их обратно в каталог
                e.dataTransfer.setData('text/plain', 'temp'); 
              }}
              style={{
                position: 'absolute',
                left: item.x,
                top: item.y,
                width: obj.width,
                height: obj.height,
                userSelect: 'none'
              }}
            />
          );
        })}
      </div>
    </div>
  );
};

export default Planner;

Примечание: Полноценная реализация перемещения уже добавленных объектов требует отслеживания координат мыши внутри самой картинки и изменения состояния x, y объекта в массиве items. Приведенный выше код реализует базовую постановку объектов на доску.

Как интегрировать это в ваш проект:
Скопируйте зависимости из нового package.json (убедитесь, что версии совпадают с вашим стартер-китом).
Перенесите компоненты роутинга в вашу систему управления состоянием (если она есть в boilerplate).
Если в вашем starter-kit используется Redux Toolkit или Zustand вместо локального useState, перенесите стейт-менеджмент туда. Лоадеры в таком случае лучше брать из библиотеки UI-компонентов вашего стартапа (например, Mantine, Ant Design или Chakra UI), если они там подключены.
