// src/pages/clients/UserList.tsx
import { useEffect, useState } from 'react';
import axios from 'axios';
import { Link } from 'react-router-dom';
import Loader from '../../components/Loader';

interface User {
  id: number;
  name: string;
  username: string;
  email: string;
}

const UserList = () => {
  const [users, setUsers] = useState<User[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    axios.get('https://jsonplaceholder.typicode.com/users')
      .then(res => {
        setUsers(res.data);
        setLoading(false);
      })
      .catch(() => setLoading(false));
  }, []);

  if (loading) return <Loader />;

  return (
    <div>
      <h2>Список клиентов</h2>
      <table border={1} cellPadding={10} style={{ width: '100%', borderCollapse: 'collapse' }}>
        <thead>
          <tr>
            <th>Имя</th>
            <th>Логин</th>
            <th>Email</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          {users.map(u => (
            <tr key={u.id}>
              <td>{u.name}</td>
              <td>{u.username}</td>
              <td>{u.email}</td>
              <td><Link to={`/clients/${u.id}/edit`}>Редактировать</Link></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

export default UserList;
4. Редактирование профиля (UserEdit.tsx)

Страница имитирует сохранение. При нажатии на кнопку состояние блокируется, показывается спиннер на 1 секунду, затем происходит редирект назад.

typescript
Копировать
// src/pages/clients/UserEdit.tsx
import { useParams, useNavigate } from 'react-router-dom';
import { useEffect, useState } from 'react';
import axios from 'axios';
import Loader from '../../components/Loader';

const UserEdit = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [user, setUser] = useState<any>(null);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    // В реальном проекте здесь должен быть вызов api/user/{id}
    // Используем заглушку из того же jsonplaceholder
    axios.get(`https://jsonplaceholder.typicode.com/users/${id}`)
      .then(res => setUser(res.data));
  }, [id]);

  const handleSave = async () => {
    setSaving(true);
    // Имитация запроса на сервер
    await new Promise(resolve => setTimeout(resolve, 1000)); 
    setSaving(false);
    navigate('/clients');
  };

  if (!user) return <Loader />;

  return (
    <div>
      <h2>Редактирование профиля: {user.name}</h2>
      <form onSubmit={(e) => { e.preventDefault(); handleSave(); }}>
        <div style={{ marginBottom: 15 }}>
          <label>Имя:</label><br/>
          <input type="text" value={user.name} disabled={saving} style={{ width: '100%' }} />
        </div>
        <div style={{ marginBottom: 15 }}>
          <label>Username:</label><br/>
          <input type="text" value={user.username} disabled={saving} style={{ width: '100%' }} />
        </div>
        <div style={{ marginBottom: 15 }}>
          <label>Email:</label><br/>
          <input type="email" value={user.email} disabled={saving} style={{ width: '100%' }} />
        </div>
        <button type="submit" disabled={saving}>
          {saving ? 'Сохранение...' : 'Save Changes'}
        </button>
      </form>
    </div>
  );
};

export default UserEdit;
