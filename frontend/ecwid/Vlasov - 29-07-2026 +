import axios from 'axios';
import { BASE_URL, TOKEN, DEFAULT_LANG } from './config';

const client = axios.create({
  baseURL: BASE_URL,
});

// Функция-обертка для добавления общих параметров запроса
const apiRequest = async <T>(endpoint: string, params: Record<string, string | number> = {}) => {
  try {
    const response = await client.get<T>(endpoint, {
      params: {
        token: TOKEN,
        lang: DEFAULT_LANG,
        ...params,
      },
    });
    return response.data;
  } catch (error) {
    console.error('Ecwid API Error:', error);
    throw error;
  }
};

export const getCategories = () => apiRequest<{ items: Category[] }>('/categories');
export const getProducts = (categoryId?: number, searchQuery?: string) => {
  // Если указан categoryId, ищем товары внутри категории. Иначе — все товары магазина.
  const endpoint = categoryId ? `/products?category=${categoryId}` : '/products';
  return apiRequest<{ items: Product[] }>(endpoint, searchQuery ? { q: searchQuery } : {});
};
export const getProductDetails = (productId: number) => apiRequest<Product>(`/products/${productId}`);
Типы Category и Product следует описать согласно структуре ответа Ecwid.
3. Управление состоянием (Pinia)
Корзина должна сохраняться в localStorage между перезагрузками страницы.
src/stores/cart.ts
typescriptКопировать
import { defineStore } from 'pinia';
import { ref } from 'vue';
import { usePersistedStatePlugin } from '@pinia/plugin-persistedstate';

interface CartItem {
  id: number;
  name: string;
  price: number;
  quantity: number;
  imageUrl?: string;
}

export const useCartStore = defineStore('cart', () => {
  const items = ref<CartItem[]>([]);

  const addToCart = (product: Omit<CartItem, 'quantity'>) => {
    const existing = items.value.find(i => i.id === product.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      items.value.push({ ...product, quantity: 1 });
    }
  };

  const removeFromCart = (id: number) => {
    items.value = items.value.filter(item => item.id !== id);
  };

  const increment = (id: number) => {
    const item = items.value.find(i => i.id === id);
    if (item) item.quantity++;
  };

  const decrement = (id: number) => {
    const item = items.value.find(i => i.id === id);
    if (item && item.quantity > 1) {
      item.quantity--;
    }
  };

  const totalItems = computed(() => items.value.reduce((sum, item) => sum + item.quantity, 0));
  const totalPrice = computed(() => items.value.reduce((sum, item) => sum + item.price * item.quantity, 0).toFixed(2));
  
  const clearCart = () => {
    items.value = [];
  };

  return { items, addToCart, removeFromCart, increment, decrement, totalItems, totalPrice, clearCart };
}, {
  persist: true // Включает плагин сохранения состояния
});
