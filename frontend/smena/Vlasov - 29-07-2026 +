describe('Registration and Login flow', () => {
  it('should register a new user and redirect to home', () => {
    cy.visit('/register');
    cy.get('input[label="Имя пользователя"]').type('cypress_user');
    cy.get('input[label="Пароль"]').type('StrongPass123');
    cy.contains('Зарегистрироваться').click();
    
    cy.url().should('include', '/');
    cy.contains('cypress_user').should('be.visible');
  });

  it('should not allow duplicate registration', () => {
    cy.visit('/register');
    cy.get('input[label="Имя пользователя"]').type('existing_user'); // имя admin или user из seed бэкенда
    cy.get('input[label="Пароль"]').type('123');
    cy.contains('Зарегистрироваться').click();
    cy.contains('Пользователь с таким именем уже зарегистрирован').should('be.visible');
  });
});
