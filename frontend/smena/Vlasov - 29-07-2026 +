6. Тестирование
Юнит-тесты (Jest): Пример теста для компонента формы (проверка блокировки кнопки при невалидных данных):
javascriptКопировать
// Пример для LoginView.spec.js
import { mount } from '@vue/test-utils';
import LoginView from '@/views/LoginView.vue';
import { createTestingPinia } from '@pinia/testing';
import { afterEach, describe, expect, test, vi } from 'vitest';
import { setActivePinia } from 'pinia';

describe('LoginView', () => {
  let wrapper;
  const mockPush = vi.fn();

  beforeEach(() => {
    setActivePinia(createTestingPinia());
    wrapper = mount(LoginView, {
      global: {
        mocks: {
          $router: { push: mockPush }
        }
      }
    });
  });

  afterEach(() => {
    wrapper.unmount();
  });

  test('кнопка "Войти" должна быть disabled без заполнения полей', async () => {
    const button = wrapper.find('[type="submit"]');
    expect(button.attributes('disabled')).toBeDefined();
    
    await wrapper.find('input[label="Имя пользователя"]').setValue('test');
    await wrapper.find('input[label="Пароль"]').setValue('pass');
    await wrapper.vm.$nextTick();
    
    expect(button.attributes('disabled')).toBeUndefined();
  });
});
