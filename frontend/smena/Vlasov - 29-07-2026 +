2. Ядро приложения (API и хранилище)
src/api/auth.js Настройка базового URL и автоматического добавления JWT-токена в заголовки.
javascriptКопировать
import axios from 'axios';
import { useUserStore } from '@/store/user';

const instance = axios.create({
  baseURL: 'http://localhost:8080',
});

// Перехватчик запросов: добавляет Bearer токен
instance.interceptors.request.use((config) => {
  const userStore = useUserStore();
  if (userStore.token) {
    config.headers.Authorization = `Bearer ${userStore.token}`;
  }
  return config;
});

export default instance;
src/store/user.js (Замена Vuex на Pinia)
javascriptКопировать
import { defineStore } from 'pinia';
import api from '@/api/auth';

export const useUserStore = defineStore('user', {
  state: () => ({
    token: localStorage.getItem('jwt_token') || null,
    profile: JSON.parse(localStorage.getItem('user_profile')) || null,
    isLoading: false,
    error: null,
  }),
  getters: {
    isAuthenticated: (state) => !!state.token,
  },
  actions: {
    async login(credentials) {
      this.isLoading = true;
      this.error = null;
      try {
        const response = await api.post('/login/', credentials);
        this.token = response.data.token;
        localStorage.setItem('jwt_token', this.token);
        // После логина сразу запрашиваем профиль
        await this.fetchProfile();
      } catch (err) {
        this.error = err.response?.data?.error || 'Ошибка сети';
        throw err;
      } finally {
        this.isLoading = false;
      }
    },
    async register(data) {
      this.isLoading = true;
      this.error = null;
      try {
        await api.post('/register/', data);
      } catch (err) {
        this.error = err.response?.data?.message || 'Ошибка сети';
        throw err;
      } finally {
        this.isLoading = false;
      }
    },
    async fetchProfile() {
      if (!this.token) return;
      try {
        const response = await api.get('/about/');
        this.profile = response.data;
        localStorage.setItem('user_profile', JSON.stringify(this.profile));
      } catch (err) {
        this.profile = null;
        localStorage.removeItem('user_profile');
        if (err.response?.status === 401) {
          this.logout();
        }
      }
    },
    logout() {
      this.token = null;
      this.profile = null;
      localStorage.removeItem('jwt_token');
      localStorage.removeItem('user_profile');
    },
  },
});
3. Роутинг (Vue Router)
src/router/index.js
javascriptКопировать
import { createRouter, createWebHistory } from 'vue-router';
import HomeView from '@/views/HomeView.vue';
import LoginView from '@/views/LoginView.vue';
import RegisterView from '@/views/RegisterView.vue';
import { useUserStore } from '@/store/user';

const routes = [
  { path: '/', name: 'home', component: HomeView, meta: { requiresAuth: true } },
  { path: '/login', name: 'login', component: LoginView },
  { path: '/register', name: 'register', component: RegisterView },
];

const router = createRouter({
  history: createWebHistory(import.meta.env.BASE_URL),
  routes,
});

router.beforeEach((to, from, next) => {
  const userStore = useUserStore();
  if (to.meta.requiresAuth && !userStore.isAuthenticated) {
    next({ name: 'login' });
  } else if ((to.name === 'login' || to.name === 'register') && userStore.isAuthenticated) {
    next({ name: 'home' });
  } else {
    next();
  }
});

export default router;
