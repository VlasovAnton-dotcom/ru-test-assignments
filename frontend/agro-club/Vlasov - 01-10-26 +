import React from 'react';

const CATEGORY_ICONS = {
  Canola: '🟡',
  Corn: '🌽',
  Oats: '🌾',
  Wheat: '🌾',
  Soybeans: '🫘',
  Barley: '🌾'
};

export const Filters = ({ categories, filters, onFilterChange, onSearchChange, onReset }) => (
  <div className="filters">
    <div className="search-box">
      <input
        type="text"
        placeholder="Search among products"
        value={filters.search}
        onChange={onSearchChange}
      />
    </div>
    <div className="filter-group">
      <button
        className={filters.category === null ? 'active' : ''}
        onClick={() => onFilterChange('category', null)}
      >
        All
      </button>
      {categories.map(cat => (
        <button
          key={cat.id}
          className={filters.category === cat.id ? 'active' : ''}
          onClick={() => onFilterChange('category', cat.id)}
        >
          {CATEGORY_ICONS[cat.name] || ''} {cat.name}
        </button>
      ))}
    </div>
    <div className="status-filters">
      <label>
        <input
          type="checkbox"
          checked={filters.isLimited}
          onChange={e => onFilterChange('isLimited', e.target.checked)}
        />
        Limited
      </label>
      <label>
        <input
          type="checkbox"
          checked={filters.isNew}
          onChange={e => onFilterChange('isNew', e.target.checked)}
        />
        New
      </label>
    </div>
    <button onClick={onReset}>Reset</button>
  </div>
);
