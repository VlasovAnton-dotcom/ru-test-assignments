const API_BASE = 'http://localhost:4000/api';

export const fetchCategories = async () => {
  const res = await fetch(`\${API_BASE}/category`);
  if (!res.ok) throw new Error('Failed to fetch categories');
  return res.json();
};

export const fetchProducts = async ({ category, isNew, isLimited, search }) => {
  const params = new URLSearchParams();
  if (category) params.append('category', category);
  if (isNew !== undefined) params.append('isNew', isNew);
  if (isLimited !== undefined) params.append('isLimited', isLimited);
  if (search) params.append('search', search);

  const res = await fetch(`${API_BASE}/product?${params.toString()}`);
  if (!res.ok) throw new Error('Failed to fetch products');
  return res.json();
};
