import React from 'react';

const CATEGORY_IMG_MAP = {
  Canola: '/img/canola.jpg',
  Corn: '/img/corn.jpg',
  Oats: '/img/oats.jpg',
  Wheat: '/img/wheat.jpg',
  Soybeans: '/img/soybeans.jpg',
  Barley: '/img/barley.jpg'
};

export const ProductCard = ({ product }) => {
  const imgSrc = CATEGORY_IMG_MAP[product.categoryName] || '/img/default.jpg';
  const discountText = product.discount ? `Discount $${product.discount} per bag` : '';
  const statuses = [];
  if (product.isLimited) statuses.push('Limited');
  if (product.isNew) statuses.push('New');

  return (
    <div className="product-card">
      <img src={imgSrc} alt={product.categoryName} />
      <div className="product-info">
        <span className="category">{product.categoryName}</span>
        {statuses.length > 0 && (
          <div className="status-badges">
            {statuses.map(s => <span key={s} className="badge">{s}</span>)}
          </div>
        )}
        <h3>{product.name}</h3>
        <p>{product.description}</p>
        <div className="price-block">
          <span className="price">\${product.price.toFixed(2)}</span>
          {discountText && <span className="discount">{discountText}</span>}
        </div>
      </div>
    </div>
  );
};
