import java.lang.reflect.Array;
import java.lang.reflect.Field;
import java.lang.reflect.Modifier;
import java.util.Collection;
import java.util.IdentityHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

public class DeepCopyDemo {

    public static class CopyUtils {

        @SuppressWarnings("unchecked")
        public static <T> T deepCopy(T object) {
            IdentityHashMap<Object, Object> visited = new IdentityHashMap<>();
            return (T) doCopy(object, visited);
        }

        private static Object doCopy(Object object, IdentityHashMap<Object, Object> visited) {
            if (object == null) {
                return null;
            }

            // 1. Immutable primitives, wrappers, String, Class, Enum
            if (object instanceof String || object instanceof Enum || object instanceof Class || 
                object instanceof Number || object instanceof Boolean || object instanceof Character) {
                return object;
            }

            // 2. Handle circular references
            if (visited.containsKey(object)) {
                return visited.get(object);
            }

            Class<?> clazz = object.getClass();

            // 3. Arrays
            if (clazz.isArray()) {
                int length = Array.getLength(object);
                Object newArray = Array.newInstance(clazz.getComponentType(), length);
                visited.put(object, newArray);
                for (int i = 0; i < length; i++) {
                    Array.set(newArray, i, doCopy(Array.get(object, i), visited));
                }
                return newArray;
            }

            // 4. Collections
            if (object instanceof Collection<?>) {
                Collection<Object> original = (Collection<Object>) object;
                Collection<Object> copy;
                try {
                    copy = (Collection<Object>) clazz.getDeclaredConstructor().newInstance();
                } catch (Exception e) {
                    throw new RuntimeException("Failed to instantiate collection: " + clazz.getName(), e);
                }
                visited.put(object, copy);
                for (Object item : original) {
                    copy.add(doCopy(item, visited));
                }
                return copy;
            }

            // 5. Maps
            if (object instanceof Map<?, ?>) {
                Map<Object, Object> original = (Map<Object, Object>) object;
                Map<Object, Object> copy;
                try {
                    copy = (Map<Object, Object>) clazz.getDeclaredConstructor().newInstance();
                } catch (Exception e) {
                    throw new RuntimeException("Failed to instantiate map: " + clazz.getName(), e);
                }
                visited.put(object, copy);
                for (Map.Entry<Object, Object> entry : original.entrySet()) {
                    copy.put(doCopy(entry.getKey(), visited), doCopy(entry.getValue(), visited));
                }
                return copy;
            }

            // 6. Arbitrary objects
            Object copy;
            try {
                copy = clazz.getDeclaredConstructor().newInstance();
            } catch (Exception e) {
                throw new RuntimeException("Failed to instantiate object: " + clazz.getName() + 
                    ". Does it have a no-arg constructor?", e);
            }
            visited.put(object, copy);

            // Копируем поля текущего класса и всех родительских
            for (Class<?> c = clazz; c != null; c = c.getSuperclass()) {
                Field[] fields = c.getDeclaredFields();
                for (Field field : fields) {
                    // Пропускаем статические поля
                    if (Modifier.isStatic(field.getModifiers())) {
                        continue;
                    }
                    
                    // Final поля копируем только один раз (при создании объекта). 
                    // Повторная запись через рефлексию в Java 21 может быть запрещена.
                    if (Modifier.isFinal(field.getModifiers())) {
                        continue;
                    }

                    field.setAccessible(true);
                    try {
                        Object value = field.get(object);
                        Object copiedValue = doCopy(value, visited);
                        field.set(copy, copiedValue);
                    } catch (IllegalAccessException e) {
                        throw new RuntimeException("Failed to access field: " + field.getName(), e);
                    }
                }
            }

            return copy;
        }
    }

    // Тестовый класс из задания
    public static class Man {
        private String name;
        private int age;
        private List<String> favoriteBooks;

        public Man() {} // Нужен для рефлексии

        public Man(String name, int age, List<String> favoriteBooks) {
            this.name = name;
            this.age = age;
            this.favoriteBooks = favoriteBooks;
        }

        public String getName() { return name; }
        public void setName(String name) { this.name = name; }
        public int getAge() { return age; }
        public void setAge(int age) { this.age = age; }
        public List<String> getFavoriteBooks() { return favoriteBooks; }
        public void setFavoriteBooks(List<String> favoriteBooks) { this.favoriteBooks = favoriteBooks; }

        @Override
        public String toString() {
            return "Man{name='" + name + '\'' + ", age=" + age + ", favoriteBooks=" + favoriteBooks + '}';
        }
    }

    // Сложный класс для демонстрации рекурсии, массивов и циклических ссылок
    public static class Node {
        private String id;
        private int[] data;
        private List<Node> children;
        private Node parent; // Циклическая ссылка

        public Node() {} // Нужен для рефлексии

        public Node(String id) {
            this.id = id;
            this.data = new int[]{1, 2, 3};
            this.children = new java.util.ArrayList<>();
        }

        public void addChild(Node child) {
            child.parent = this;
            this.children.add(child);
        }

        @Override
        public String toString() {
            return "Node{id='" + id + '\'' + '}';
        }
    }

    public static void main(String[] args) {
        System.out.println("--- Testing with Man class ---");
        Man originalMan = new Man("John", 30, List.of("1984", "Fahrenheit 451"));
        
        Man copiedMan = CopyUtils.deepCopy(originalMan);

        System.out.println("Original: " + originalMan);
        System.out.println("Copy:     " + copiedMan);
        System.out.println("Same object? " + (originalMan == copiedMan));
        System.out.println("Same list? " + (originalMan.getFavoriteBooks() == copiedMan.getFavoriteBooks()));

        // Проверка изоляции
        copiedMan.setName("Jane");
        copiedMan.getFavoriteBooks().add("Brave New World");
        System.out.println("\nAfter modifying copy:");
        System.out.println("Original: " + originalMan);
        System.out.println("Copy:     " + copiedMan);

        System.out.println("\n--- Testing complex recursive structures ---");
        Node root = new Node("root");
        Node child1 = new Node("child1");
        Node child2 = new Node("child2");
        
        root.addChild(child1);
        root.addChild(child2);
        // Создаем цикл: child1 ссылается назад на root через общего родителя
        child1.addChild(root); 

        Node copiedRoot = CopyUtils.deepCopy(root);

        System.out.println("Original root: " + root);
        System.out.println("Copied root:   " + copiedRoot);
        System.out.println("Same object? " + (root == copiedRoot));
        
        // Проверяем, что циклическая ссылка в копии ведет на саму копию, а не на оригинал
        Node copiedChild1 = copiedRoot.children.get(0);
        Node copiedGrandChild = copiedChild1.children.get(0);
        
        System.out.println("Original root == copied grandchild (cycle)? " + (root == copiedGrandChild));
        System.out.println("Copied root == copied grandchild (cycle)? " + (copiedRoot == copiedGrandChild));

        // Проверяем копирование массива примитивов
        System.out.println("\nOriginal data array: " + java.util.Arrays.toString(root.data));
        System.out.println("Copied data array:   " + java.util.Arrays.toString(copiedRoot.data));
        System.out.println("Same array? " + (root.data == copiedRoot.data));
    }
}
