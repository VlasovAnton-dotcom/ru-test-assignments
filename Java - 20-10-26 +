package ru.citystats.parser;

import ru.citystats.model.Building;
import ru.citystats.model.City;

import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.ParserConfigurationException;
import java.io.File;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.SAXException;

// Предполагается структура XML:
// <cities>
//   <city name="Moscow">
//     <building floors="5"/>
//     <building floors="2"/>
//   </city>
// </cities>
public class XmlCityParser implements CityParser {

    @Override
    public List<City> parse(String filePath) throws IOException {
        List<City> cities = new ArrayList<>();
        try {
            File inputFile = new File(filePath);
            DocumentBuilderFactory dbFactory = DocumentBuilderFactory.newInstance();
            DocumentBuilder dBuilder = dbFactory.newDocumentBuilder();
            Document doc = dBuilder.parse(inputFile);
            doc.getDocumentElement().normalize();

            NodeList cityNodes = doc.getElementsByTagName("city");
            for (int temp = 0; temp < cityNodes.getLength(); temp++) {
                Node node = cityNodes.item(temp);
                if (node.getNodeType() == Node.ELEMENT_NODE) {
                    Element element = (Element) node;
                    String cityName = element.getAttribute("name");
                    City city = findOrCreateCity(cities, cityName);

                    NodeList buildingNodes = element.getElementsByTagName("building");
                    for (int b = 0; b < buildingNodes.getLength(); b++) {
                        Node bNode = buildingNodes.item(b);
                        if (bNode.getNodeType() == Node.ELEMENT_NODE) {
                            Element bElement = (Element) bNode;
                            int floors = Integer.parseInt(bElement.getAttribute("floors"));
                            city.addBuilding(new Building(floors));
                        }
                    }
                }
            }
        } catch (ParserConfigurationException | SAXException e) {
            throw new IOException("Ошибка парсинга XML", e);
        }
        return cities;
    }

    private City findOrCreateCity(List<City> cities, String name) {
        for (City city : cities) {
            if (city.getName().equalsIgnoreCase(name)) {
                return city;
            }
        }
        City newCity = new City(name);
        cities.add(newCity);
        return newCity;
    }
}
