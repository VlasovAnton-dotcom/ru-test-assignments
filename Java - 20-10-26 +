package ru.citystats.parser;

import ru.citystats.model.Building;
import ru.citystats.model.City;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

// Предполагается, что CSV имеет заголовок и структуру: city_name;floor_count
// Например: Moscow;5
public class CsvCityParser implements CityParser {

    @Override
    public List<City> parse(String filePath) throws IOException {
        List<City> cities = new ArrayList<>();
        try (BufferedReader br = new BufferedReader(new FileReader(filePath))) {
            String line;
            // Пропускаем заголовок
            br.readLine(); 
            while ((line = br.readLine()) != null) {
                String[] parts = line.split(";");
                if (parts.length == 2) {
                    String cityName = parts[0].trim();
                    int floors;
                    try {
                        floors = Integer.parseInt(parts[1].trim());
                    } catch (NumberFormatException e) {
                        // Пропускаем некорректные строки, чтобы приложение не падало
                        continue; 
                    }
                    
                    City city = findOrCreateCity(cities, cityName);
                    city.addBuilding(new Building(floors));
                }
            }
        }
        return cities;
    }

    private City findOrCreateCity(List<City> cities, String name) {
        for (City city : cities) {
            if (city.getName().equalsIgnoreCase(name)) {
                return city;
            }
        }
        City newCity = new City(name);
        cities.add(newCity);
        return newCity;
    }
}
