package ru.citystats;

import org.junit.Before;
import org.junit.Test;
import ru.citystats.model.Building;
import ru.citystats.model.City;
import ru.citystats.stats.StatisticsService;

import java.util.ArrayList;
import java.util.List;

import static org.junit.Assert.*;

public class StatisticsServiceTest {

    private StatisticsService service;
    private List<City> testCities;

    @Before
    public void setUp() {
        service = new StatisticsService();
        testCities = new ArrayList<>();

        City moscow1 = new City("Moscow");
        moscow1.addBuilding(new Building(5));
        moscow1.addBuilding(new Building(2));

        City moscow2 = new City("Moscow"); // Дубль
        moscow2.addBuilding(new Building(1));

        City spb = new City("Saint-Petersburg");
        spb.addBuilding(new Building(3));
        spb.addBuilding(new Building(3));
        spb.addBuilding(new Building(10)); // Игнорируется, так как > 5

        testCities.add(moscow1);
        testCities.add(moscow2);
        testCities.add(spb);
    }

    @Test
    public void testFindDuplicateCities() {
        var duplicates = service.findDuplicateCities(testCities);
        assertEquals(1, duplicates.size());
        assertTrue(duplicates.containsKey("moscow"));
        assertEquals(2, (int) duplicates.get("moscow"));
    }

    @Test
    public void testCountBuildingsByFloors() {
        var stats = service.countBuildingsByFloors(testCities);
        
        int[] moscowData = stats.get("Moscow");
        assertEquals(1, moscowData[1]);
        assertEquals(1, moscowData[2]);
        assertEquals(0, moscowData[3]);
        assertEquals(0, moscowData[4]);
        assertEquals(1, moscowData[5]);

        int[] spbData = stats.get("Saint-Petersburg");
        assertEquals(1, spbData[1]);
        assertEquals(0, spbData[2]);
        assertEquals(2, spbData[3]);
        assertEquals(0, spbData[4]);
        assertEquals(0, spbData[5]);
    }
}
Дальнейшие шаги
1.	Адаптация парсеров. Реальные структуры XML и CSV почти наверняка отличаются от примеров в коде. Вам нужно будет изменить методы parse в XmlCityParser и CsvCityParser, чтобы они доставали названия городов и количество этажей из нужных тегов/столбцов.
2.	Сборка. В консоли выполните gradle build. Готовый исполняемый JAR-файл появится в папке build/libs/.
3.	Запуск. java -jar build/libs/ваше_имя_проекта.jar.
4.	Улучшение команды выхода. Сейчас используется команда exit. Если требуется именно комбинация клавиш (например, Ctrl+C), стандартный Scanner может некорректно её обрабатывать, обрывая поток ввода. В таком случае консольный ввод лучше обернуть в отдельный поток, который отлавливает java.io.InterruptedIOException, или использовать Console.readPassword(), но это усложнит логику. Для большинства задач команда exit является надежным и достаточным решением.

