package ru.citystats;

import ru.citystats.parser.*;
import ru.citystats.stats.StatisticsService;

import java.io.IOException;
import java.util.List;
import java.util.Map;
import java.util.Scanner;

public class Main {
    private static final String EXIT_COMMAND = "exit";

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        StatisticsService statsService = new StatisticsService();

        System.out.println("Приложение запущено. Введите путь к файлу (XML или CSV) или команду 'exit' для выхода.");

        while (true) {
            System.out.print("> ");
            String input = scanner.nextLine().trim();

            if (EXIT_COMMAND.equalsIgnoreCase(input)) {
                System.out.println("Завершение работы.");
                break;
            }

            if (input.isEmpty()) {
                continue;
            }

            try {
                CityParser parser;
                if (input.toLowerCase().endsWith(".csv")) {
                    parser = new CsvCityParser();
                } else if (input.toLowerCase().endsWith(".xml")) {
                    parser = new XmlCityParser();
                } else {
                    System.out.println("Неизвестный формат файла. Поддерживаются только .xml и .csv");
                    continue;
                }

                List<City> cities = parser.parse(input);
                if (cities.isEmpty()) {
                    System.out.println("Файл прочитан, но данных не обнаружено.");
                    continue;
                }

                // 1. Дубликаты городов
                Map<String, Integer> duplicates = statsService.findDuplicateCities(cities);
                System.out.println("\n--- Дублирующиеся записи городов ---");
                if (duplicates.isEmpty()) {
                    System.out.println("Дубликаты не найдены.");
                } else {
                    for (Map.Entry<String, Integer> entry : duplicates.entrySet()) {
                        System.out.printf("Город: %s, Количество повторений: %d%n", entry.getKey(), entry.getValue());
                    }
                }

                // 2. Этажность
                Map<String, int[]> floorStats = statsService.countBuildingsByFloors(cities);
                System.out.println("\n--- Количество зданий по этажам ---");
                for (Map.Entry<String, int[]> entry : floorStats.entrySet()) {
                    System.out.printf("Город: %s%n", entry.getKey());
                    int[] data = entry.getValue();
                    for (int i = 1; i <= 5; i++) {
                        System.out.printf("  %d этажей: %d%n", i, data[i]);
                    }
                }
                System.out.println("\nОбработка завершена. Введите путь к следующему файлу или 'exit'.");

            } catch (IOException e) {
                System.out.println("Ошибка при чтении или обработке файла: " + e.getMessage());
                System.out.println("Приложение ожидает ввод следующего файла.");
            } catch (Exception e) {
                // Глобальный отлов непредвиденных ошибок, чтобы приложение не упало
                System.out.println("Произошла непредвиденная ошибка: " + e.getMessage());
                System.out.println("Приложение ожидает ввод следующего файла.");
            }
        }
        scanner.close();
    }
}
