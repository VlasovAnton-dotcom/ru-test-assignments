package ru.citystats.stats;

import ru.citystats.model.City;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class StatisticsService {

    // 1) Поиск дублирующихся записей (городов)
    public Map<String, Integer> findDuplicateCities(List<City> cities) {
        Map<String, Integer> counts = new HashMap<>();
        for (City city : cities) {
            String name = city.getName().toLowerCase();
            counts.put(name, counts.getOrDefault(name, 0) + 1);
        }
        
        // Оставляем только те, что встречаются более одного раза
        Map<String, Integer> duplicates = new HashMap<>();
        for (Map.Entry<String, Integer> entry : counts.entrySet()) {
            if (entry.getValue() > 1) {
                duplicates.put(entry.getKey(), entry.getValue());
            }
        }
        return duplicates;
    }

    // 2) Подсчет этажности
    public Map<String, int[]> countBuildingsByFloors(List<City> cities) {
        Map<String, int[]> stats = new HashMap<>();
        for (City city : cities) {
            int[] floorsCount = new int[6]; // Индексы 1-5 для этажей, 0 не используем
            for (Building building : city.getBuildings()) {
                int f = building.getFloors();
                if (f >= 1 && f <= 5) {
                    floorsCount[f]++;
                }
            }
            stats.put(city.getName(), floorsCount);
        }
        return stats;
    }
}
