2. Фоновый воркер (Sidekiq)
Для больших файлов (100 000 строк) критически важно читать файл потоково, а не загружать его в память целиком.

ruby
Копировать
# app/workers/csv_import_worker.rb
require 'csv'

class CsvImportWorker
  include Sidekiq::Job

  def perform(import_id)
    import = InsuranceImport.find(import_id)
    
    # Сброс счетчиков перед повторным запуском
    import.update!(success_count: 0, failure_count: 0, progress: 0)
    
    total_lines = 0
    created = 0
    failed = 0

    # Определяем общее количество строк для расчета прогресса
    File.foreach(import.file.download.path) { total_lines += 1 }
    total_lines -= 1 # вычитаем заголовок

    CSV.foreach(import.file.download.path, headers: true, header_converters: :symbol) do |row|
      client = Client.new(
        first_name: row[:first_name],
        last_name: row[:last_name],
        email: row[:email],
        date_of_birth: row[:date_of_birth],
        insurance_import: import
      )

      if client.save
        created += 1
      else
        failed += 1
        import.import_errors.create!(
          row_number: row.line,
          raw_data: row.to_h,
          error_messages: client.errors.full_messages.join(', ')
        )
      end

      # Обновляем прогресс каждые 100 строк, чтобы не перегружать БД
      if row.line % 100 == 0
        import.update(
          progress: ((row.line - 1).to_f / total_lines * 100).to_i,
          success_count: created,
          failure_count: failed
        )
      end
    end

    import.update!(
      status: :completed,
      completed_at: Time.current,
      progress: 100,
      success_count: created,
      failure_count: failed
    )
  rescue StandardError => e
    import.update!(status: :failed, completed_at: Time.current)
    Rails.logger.error "Import ##{import_id} failed: #{e.message}"
  end
end

3. Валидации модели Client

