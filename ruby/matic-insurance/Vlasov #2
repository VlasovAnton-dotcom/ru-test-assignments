# app/controllers/insurance_imports_controller.rb
class InsuranceImportsController < ApplicationController
  def index
    @imports = InsuranceImport.order(created_at: :desc)
  end

  def new
    @import = InsuranceImport.new
  end

  def create
    @import = InsuranceImport.new(import_params)
    if @import.save
      redirect_to @import, notice: 'Import was successfully created. Press "Start" to begin processing.'
    else
      render :new, status: :unprocessable_entity
    end
  end

  def show
    @import = InsuranceImport.includes(:clients, :import_errors).find(params[:id])
  end

  def start
    @import = InsuranceImport.find(params[:id])
    @import.start_processing
    redirect_to @import, notice: 'Import has started. This may take a while.'
  end

  def destroy
    InsuranceImport.find(params[:id]).destroy
    redirect_to insurance_imports_url, notice: 'Import was successfully destroyed.'
  end

  private

  def import_params
    params.require(:insurance_import).permit(:title, :file)
  end
end
