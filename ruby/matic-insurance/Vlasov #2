# spec/workers/csv_import_worker_spec.rb
require 'rails_helper'

RSpec.describe CsvImportWorker, type: :worker do
  let(:import) { create(:insurance_import, :with_small_csv) } # FactoryBot trait, который прикрепляет тестовый CSV

  it 'processes the file and creates clients' do
    expect { described_class.new.perform(import.id) }
      .to change(Client, :count).by(5) # исходя из файла на 5 строк
      .and change(import.import_errors, :count).by(0)

    import.reload
    expect(import.status).to eq('completed')
    expect(import.success_count).to eq(5)
    expect(import.progress).to eq(100)
  end

  context 'when file contains invalid data' do
    let(:import) { create(:insurance_import, :with_invalid_csv) }

    it 'counts failures and logs errors' do
      described_class.new.perform(import.id)
      import.reload
      expect(import.success_count).to eq(4)
      expect(import.failure_count).to eq(1)
      expect(import.import_errors.first.error_messages).to include('Email is invalid')
    end
  end
end
Работа с большими файлами (100 000 строк)

Для файла на 100 000 записей реализация через CSV.foreach (потоковое чтение) гарантирует, что потребление памяти Ruby-процессом останется на уровне нескольких мегабайт, а не гигабайт. Прогресс-бар в интерфейсе будет обновляться за счет периодического вызова update! внутри воркера. Администратор увидит актуальный процент и количество созданных/ошибочных записей без перезагрузки страницы, если добавить легкий polling (опрос) эндпоинта /insurance_imports/:id.json через JS на странице импорта, либо использовать ActionCable для пуш-уведомлений.
