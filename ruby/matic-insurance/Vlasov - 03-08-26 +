# frozen_string_literal: true

require_relative 'http_client'
require_relative '../domain/cat'
require_relative '../errors/api_error'

class CatsUnlimitedAdapter < AdapterBase
  BASE_URL = ENV.fetch('CATS_UNLIMITED_API', 'https://nh7b1g9g23.execute-api.us-west-2.amazonaws.com/dev')

  def fetch_available_cats
    response = HttpClient.connection(base_url: BASE_URL).get('/cats/json')
    body = JSON.parse(response.body)
    map_response(body['cats'])
  rescue Faraday::TimeoutError, Faraday::ConnectionFailed => e
    raise NetworkError.new("Cats Unlimited", e.message)
  rescue JSON::ParserError => e
    raise ParseError.new("Cats Unlimited", e.message)
  end

  private

  def map_response(cats_data)
    cats_data.map do |cat_hash|
      Cat.new(
        id: cat_hash['id'],
        name: cat_hash['name'],
        breed: cat_hash['breed'],
        price: cat_hash['price'].to_f,
        shop_name: 'Cats Unlimited'
      )
    end
  end
end

app/infrastructure/happy_cats_adapter.rb (New Implementation)
Handles XML namespaces gracefully.

ruby
Копировать
# frozen_string_literal: true

require_relative 'http_client'
require_relative '../domain/cat'
require 'nokogiri'
require_relative '../errors/api_error'

class HappyCatsAdapter < AdapterBase
  BASE_URL = ENV.fetch('HAPPY_CATS_API', 'https://nh7b1g9g23.execute-api.us-west-2.amazonaws.com/dev')

  def fetch_available_cats
    response = HttpClient.connection(base_url: BASE_URL).get('/cats/xml')
    doc = Nokogiri::XML(response.body)
    cats_nodes = doc.xpath('//catalog/cat') # Adjust XPath based on actual XML structure
    map_response(cats_nodes)
  rescue Faraday::TimeoutError, Faraday::ConnectionFailed => e
    raise NetworkError.new("Happy Cats", e.message)
  rescue Nokogiri::XML::SyntaxError => e
    raise ParseError.new("Happy Cats", e.message)
  end

  private

  def map_response(nodes)
    nodes.map do |node|
      Cat.new(
        id: node.at_xpath('id')&.text,
        name: node.at_xpath('name')&.text,
        breed: node.at_xpath('breed')&.text,
        price: node.at_xpath('price')&.text.to_f,
        shop_name: 'Happy Cats'
      )
    end
  end
end

