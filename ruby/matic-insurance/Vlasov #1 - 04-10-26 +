RSpec.describe CatFinderService do
  describe '.call' do
    it 'returns the cheapest cat from both shops' do
      allow(CatsUnlimitedShop).to receive(:new).and_return(double(fetch_cats: ParseResult.new(success: true, offers: [CatOffer.new(price: 100)])))
      allow(HappyCatsShop).to receive(:new).and_return(double(fetch_cats: ParseResult.new(success: true, offers: [CatOffer.new(price: 90)])))

      result = CatFinderService.call(location: 'NY')
      expect(result.success?).to be true
      expect(result.data.price).to eq(90)
    end
  end
end
