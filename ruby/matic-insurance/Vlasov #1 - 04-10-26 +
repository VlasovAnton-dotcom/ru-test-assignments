2. Сервис поиска (Бизнес-логика)

ruby
Копировать
# app/services/cat_finder_service.rb
class CatFinderService
  def self.call(location:)
    new(location).call
  end

  def initialize(location)
    @location = location
    @shops = [CatsUnlimitedShop.new, HappyCatsShop.new]
  end

  def call
    offers = []
    @shops.each do |shop|
      # Параллелизация (например, через Concurrent::Future) рекомендуется здесь
      response = shop.fetch_cats(@location)
      offers.concat(response.offers) if response.success?
    end

    return Result.error('No offers found from any shop') if offers.empty?

    best_offer = PriceComparatorService.find_best(offers)
    Result.success(best_offer, shop_name: best_offer.shop_name)
  rescue StandardError => e
    Rails.logger.error "CatFinderService failed: #{e.message}"
    Result.error('Internal service error')
  end
end

