Копировать
# app/adapters/xml_adapter.rb
require 'nokogiri'

class XmlAdapter < BaseAdapter
  def parse(body)
    doc = Nokogiri::XML(body)
    offers = []
    doc.css('cat').each do |node|
      offers << CatOffer.new(
        id: node.at_css('id')&.text,
        name: node.at_css('name')&.text,
        price: node.at_css('price')&.text.to_f,
        shop_name: 'Happy Cats'
      )
    end
    ParseResult.new(success: true, offers: offers)
  rescue Nokogiri::XML::SyntaxError
    ParseResult.new(success: false, error: 'Invalid XML from Happy Cats')
  end
end

