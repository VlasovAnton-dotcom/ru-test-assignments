class Program < ApplicationRecord
  has_many :subscriptions, dependent: :destroy
  has_many :users, through: :subscriptions

  # Сортировка программ по количеству подписчиков (популярности)
  scope :by_popularity, -> { 
    left_joins(:subscriptions)
      .group('programs.id')
      .order('COUNT(subscriptions.id) DESC') 
  }

  scope :search_by_title, ->(term) {
    where("LOWER(title) LIKE ?", "%#{term.downcase}%")
  }
end

