class Api::V1::UserProgramsController < ApplicationController
  def index
    user = User.includes(:programs => :subscriptions).find(params[:user_id])
    # Выбираем только активные подписки через SQL JOIN, чтобы не грузить лишние данные
    programs = user.programs.joins(:subscriptions)
                           .where(subscriptions: { user_id: user.id, status: 'active' })
    render json: programs
  rescue ActiveRecord::RecordNotFound
    render json: { error: 'User not found' }, status: :not_found
  end
end
4. Бонусные задания

Блокировка подписки:
Реализована через поле status в модели Subscription. При создании записи она получает статус active. Чтобы заблокировать пользователя в программе, нужно обновить запись:
PATCH /api/v1/subscriptions/:id со статусом "banned" или добавить отдельный эндпоинт. В методе вывода подписок пользователя (UserProgramsController) применяется фильтр .where(status: 'active'), поэтому заблокированные программы исключаются из ответа автоматически.

Тесты (RSpec):
Проект должен быть покрыт тестами. Пример спецификации для автокомплита:

spec/requests/api/v1/programs_spec.rb

ruby
Копировать
require 'rails_helper'

RSpec.describe "Programs", type: :request do
  describe "GET /autocomplete" do
    let!(:prog1) { Program.create!(title: "Alpha Travel", description: "") }
    let!(:prog2) { Program.create!(title: "Beta Flights", description: "") }
    let!(:prog3) { Program.create!(title: "Super Alpha Tours", description: "") }
    
    before do
      prog1.subscribe(User.first_or_create(email: 'a@test.com'))
      prog1.subscribe(User.first_or_create(email: 'b@test.com')) # Популярность 2
      prog2.subscribe(User.first_or_create(email: 'c@test.com')) # Популярность 1
      prog3.subscribe(User.first_or_create(email: 'd@test.com')) # Популярность 1
    end

    it "returns matching programs sorted by popularity" do
      get "/api/v1/programs/autocomplete?term=alpha"
      expect(response).to have_http_status(:ok)
      body = JSON.parse(response.body)
      
      # Сначала идет самая популярная (Alpha Travel - 2 подписчика),
      # затем остальные сортируются по ID как фолбэк сортировки внутри одинаковой популярности
      expect(body.map { |p| p['id'] }).to eq([prog1.id, prog3.id])
    end
  end
end

В моделях добавляются методы-хелперы для тестов, например subscribe(user) в Program.

