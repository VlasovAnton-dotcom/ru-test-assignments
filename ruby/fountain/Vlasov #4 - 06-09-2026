import React from "react";
import ControlsPanel from "./ControlsPanel";
import PreviewPanel from "./PreviewPanel";
import { useFormBuilder } from "../../hooks/useFormBuilder";

function FormBuilder() {
  const {
    fields, errors,
    addField, deleteField, updateField,
    addOption, deleteOption, updateOption,
    dragStart, dragOver, drop, dragIndex,
    runValidation,
  } = useFormBuilder();

  const handleValidate = () => {
    const isValid = runValidation();
    if (isValid) {
      alert("Form is valid!");
    } else {
      alert("Form has errors. Please fix them.");
    }
  };

  return (
    <div>
      <div className="form-builder__title">Simple Form Builder</div>
      <div className="form-builder">
        <ControlsPanel onAddField={addField} />
        <PreviewPanel
          fields={fields}
          errors={errors}
          dragIndex={dragIndex}
          onDragStart={dragStart}
          onDragOver={dragOver}
          onDrop={drop}
          onUpdate={updateField}
          onDelete={deleteField}
          onAddOption={addOption}
          onDeleteOption={deleteOption}
          onUpdateOption={updateOption}
        />
      </div>
      <div style={{ textAlign: "center", marginTop: "20px" }}>
        <button
          onClick={handleValidate}
          style={{
            padding: "10px 28px",
            fontSize: "15px",
            fontWeight: "600",
            border: "none",
            borderRadius: "8px",
            background: "#4a6cf7",
            color: "#fff",
            cursor: "pointer",
          }}
        >
          Validate Form
        </button>
      </div>
    </div>
  );
}

export default FormBuilder;
```

