### `src/components/FormBuilder/Field/FieldPreview.jsx`

```jsx
import React from "react";

function FieldPreview({ field }) {
  const requiredMark = field.required ? (
    <span className="field__preview-required-mark">*</span>
  ) : null;
  const label = field.name || "Untitled field";

  switch (field.type) {
    case "input":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          <input type="text" className="field__preview-input" placeholder="Enter text..." disabled />
        </div>
      );
    case "textarea":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          <textarea className="field__preview-textarea" placeholder="Enter text..." disabled />
        </div>
      );
    case "checkbox":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          {field.options.map((opt) => (
            <div key={opt.id} className="field__preview-option">
              <input type="checkbox" disabled />
              <span>{opt.value || "Option"}</span>
            </div>
          ))}
        </div>
      );
    case "radio":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          {field.options.map((opt) => (
            <div key={opt.id} className="field__preview-option">
              <input type="radio" name={field.id} disabled />
              <span>{opt.value || "Option"}</span>
            </div>
          ))}
        </div>
      );
    case "select":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          <select className="field__preview-select" disabled>
            {field.options.map((opt) => (
              <option key={opt.id}>{opt.value || "Option"}</option>
            ))}
          </select>
        </div>
      );
    case "file":
      return (
        <div className="field__preview">
          <label className="field__preview-label">{label}{requiredMark}</label>
          <input type="file" className="field__preview-file" disabled />
        </div>
      );
    default:
      return null;
  }
}

export default FieldPreview;
```

### `src/components/FormBuilder/Field/FieldEditor.jsx`

```jsx
import React from "react";
import { FIELD_TYPES } from "../../utils/constants";
import FieldPreview from "./FieldPreview";

function FieldEditor({
  field, index, errors, dragIndex,
  onDragStart, onDragOver, onDrop,
  onUpdate, onDelete,
  onAddOption, onDeleteOption, onUpdateOption,
}) {
  const def = FIELD_TYPES.find((f) => f.type === field.type);
  const fieldErrors = errors[field.id] || [];
  const isDragging = dragIndex === index;

  return (
    <div
      className={`field${isDragging ? " field--dragging" : ""}${
        fieldErrors.length > 0 ? " field--error" : ""
      }`}
      draggable
      onDragStart={() => onDragStart(index)}
      onDragOver={(e) => onDragOver(e, index)}
      onDrop={() => onDrop(index)}
    >
      <div className="field__header">
        <span className="field__drag-handle">⠿</span>
        <span className="field__type-badge">{def ? def.label : field.type}</span>
        <input
          type="text"
          className={`field__name-input${
            fieldErrors.some((e) => e.includes("name")) ? " field__name-input--error" : ""
          }`}
          placeholder="Field name"
          value={field.name}
          onChange={(e) => onUpdate(field.id, { name: e.target.value })}
        />
        <label className="field__required-toggle">
          <input
            type="checkbox"
            className="field__required-checkbox"
            checked={field.required}
            onChange={(e) => onUpdate(field.id, { required: e.target.checked })}
          />
          Required
        </label>
        <button className="field__delete-btn" onClick={() => onDelete(field.id)}>
          ✕ Delete
        </button>
      </div>

      {def && def.hasOptions && (
        <div className="field__options">
          <div className="field__options-label">Options:</div>
          {field.options.map((opt) => (
            <div key={opt.id} className="field__option-row">
              <input
                type="text"
                className="field__option-input"
                placeholder="Option value"
                value={opt.value}
                onChange={(e) => onUpdateOption(field.id, opt.id, e.target.value)}
              />
              <button className="field__option-delete" onClick={() => onDeleteOption(field.id, opt.id)}>
                ✕
              </button>
            </div>
          ))}
          <button className="field__add-option-btn" onClick={() => onAddOption(field.id)}>
            + Add option
          </button>
        </div>
      )}

      {fieldErrors.map((err, i) => (
        <div key={i} className="field__error">⚠ {err}</div>
      ))}

      <FieldPreview field={field} />
    </div>
  );
}

export default FieldEditor;
```

