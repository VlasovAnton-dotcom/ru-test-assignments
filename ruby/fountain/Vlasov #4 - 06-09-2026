### `src/utils/constants.js`

```jsx
// Field type definitions for the form builder
export const FIELD_TYPES = [
  { type: "input",    label: "Text Input",  icon: "📝", hasOptions: false },
  { type: "textarea", label: "Text Area",   icon: "📄", hasOptions: false },
  { type: "checkbox", label: "Checkbox",    icon: "☑️", hasOptions: true  },
  { type: "radio",    label: "Radio",       icon: "🔘", hasOptions: true  },
  { type: "select",   label: "Select",      icon: "📋", hasOptions: true  },
  { type: "file",     label: "File Upload", icon: "📎", hasOptions: false },
];

// Create a new field object with defaults
let fieldCounter = 0;

export function createField(type) {
  const def = FIELD_TYPES.find((f) => f.type === type);
  fieldCounter += 1;
  return {
    id: `field_${Date.now()}_${fieldCounter}`,
    type: type,
    name: "",
    required: false,
    options: def.hasOptions ? [{ id: `opt_${Date.now()}_0`, value: "" }] : [],
  };
}

// Validation
export function validateFields(fields) {
  const errors = {};

  fields.forEach((field) => {
    const fieldErrors = [];

    // Name should not be blank
    if (!field.name || !field.name.trim()) {
      fieldErrors.push("Field name is required");
    }

    // Name should be unique
    const sameNameCount = fields.filter(
      (f) => f.name && f.name.trim() && f.name.trim() === field.name.trim()
    ).length;
    if (sameNameCount > 1) {
      fieldErrors.push("Field name must be unique");
    }

    // Fields with options should have at least one non-empty option
    const def = FIELD_TYPES.find((f) => f.type === field.type);
    if (def && def.hasOptions) {
      const validOptions = field.options.filter((o) => o.value && o.value.trim());
      if (validOptions.length === 0) {
        fieldErrors.push("At least one option is required");
      }
    }

    if (fieldErrors.length > 0) {
      errors[field.id] = fieldErrors;
    }
  });

  return errors;
}
```

### `src/hooks/useFormBuilder.js`

```jsx
import { useState, useCallback } from "react";
import { createField, validateFields } from "../utils/constants";

export function useFormBuilder() {
  const [fields, setFields] = useState([]);
  const [dragIndex, setDragIndex] = useState(null);
  const [errors, setErrors] = useState({});

  const addField = useCallback((type) => {
    setFields((prev) => [...prev, createField(type)]);
  }, []);

  const deleteField = useCallback((id) => {
    setFields((prev) => prev.filter((f) => f.id !== id));
    setErrors((prev) => {
      const next = { ...prev };
      delete next[id];
      return next;
    });
  }, []);

  const updateField = useCallback((id, updates) => {
    setFields((prev) =>
      prev.map((f) => (f.id === id ? { ...f, ...updates } : f))
    );
  }, []);

  const addOption = useCallback((fieldId) => {
    setFields((prev) =>
      prev.map((f) => {
        if (f.id !== fieldId) return f;
        const newOption = {
          id: `opt_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
          value: "",
        };
        return { ...f, options: [...f.options, newOption] };
      })
    );
  }, []);

  const deleteOption = useCallback((fieldId, optionId) => {
    setFields((prev) =>
      prev.map((f) => {
        if (f.id !== fieldId) return f;
        return { ...f, options: f.options.filter((o) => o.id !== optionId) };
      })
    );
  }, []);

  const updateOption = useCallback((fieldId, optionId, value) => {
    setFields((prev) =>
      prev.map((f) => {
        if (f.id !== fieldId) return f;
        return {
          ...f,
          options: f.options.map((o) =>
            o.id === optionId ? { ...o, value } : o
          ),
        };
      })
    );
  }, []);

  // Drag-n-drop reorder
  const dragStart = useCallback((index) => { setDragIndex(index); }, []);
  const dragOver = useCallback((e) => { e.preventDefault(); }, []);

  const drop = useCallback((index) => {
    if (dragIndex === null || dragIndex === index) return;
    setFields((prev) => {
      const next = [...prev];
      const [moved] = next.splice(dragIndex, 1);
      next.splice(index, 0, moved);
      return next;
    });
    setDragIndex(null);
  }, [dragIndex]);

  // Validation
  const runValidation = useCallback(() => {
    const errs = validateFields(fields);
    setErrors(errs);
    return Object.keys(errs).length === 0;
  }, [fields]);

  return {
    fields, errors,
    addField, deleteField, updateField,
    addOption, deleteOption, updateOption,
    dragStart, dragOver, drop, dragIndex,
    runValidation,
  };
}
```

