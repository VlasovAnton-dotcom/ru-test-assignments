app/models/money_transfer.rb
ruby
class MoneyTransfer < ApplicationRecord
  belongs_to :sender, class_name: 'User', foreign_key: :sender_id
  belongs_to :receiver, class_name: 'User', foreign_key: :receiver_id

  validates :amount, numericality: { greater_than: 0 }
  validate :sender_has_sufficient_balance, on: :create

  private

  def sender_has_sufficient_balance
    return if sender.balance >= amount
    errors.add(:base, 'Недостаточно средств на балансе')
  end
end
3. Контроллеры
app/controllers/money_transfers_controller.rb
ruby
class MoneyTransfersController < ApplicationController
  before_action :authenticate_user! # если есть auth

  def create
    @transfer = MoneyTransfer.new(transfer_params)

    ActiveRecord::Base.transaction do
      if @transfer.valid? && @transfer.sender.balance >= @transfer.amount
        @transfer.sender.update!(balance: @transfer.sender.balance - @transfer.amount)
        @transfer.receiver.update!(balance: @transfer.receiver.balance + @transfer.amount)
        @transfer.save!
        render json: { status: 'success', transfer: @transfer }, status: :created
      else
        render json: { status: 'error', errors: @transfer.errors.full_messages }, status: :unprocessable_entity
      end
    rescue ActiveRecord::RecordInvalid => e
      render json: { status: 'error', errors: e.record.errors.full_messages }, status: :unprocessable_entity
    end
  end

  def index
    @transfers = MoneyTransfer.includes(:sender, :receiver).order(created_at: :desc)
    render json: @transfers
  end

  private

  def transfer_params
    params.require(:money_transfer).permit(:sender_id, :receiver_id, :amount)
  end
end
