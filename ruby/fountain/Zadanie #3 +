5. RSpec тесты (базовый набор)
Модель: spec/models/money_transfer_spec.rb
ruby
require 'rails_helper'

RSpec.describe MoneyTransfer, type: :model do
  let(:sender) { create(:user, balance: 1000) }
  let(:receiver) { create(:user, balance: 0) }

  it 'is valid with sufficient balance' do
    transfer = MoneyTransfer.new(sender: sender, receiver: receiver, amount: 500)
    expect(transfer).to be_valid
  end

  it 'is invalid with insufficient balance' do
    transfer = MoneyTransfer.new(sender: sender, receiver: receiver, amount: 2000)
    expect(transfer).not_to be_valid
    expect(transfer.errors[:base]).to include('Недостаточно средств на балансе')
  end
end
Контроллер: spec/controllers/money_transfers_controller_spec.rb
ruby
require 'rails_helper'

RSpec.describe MoneyTransfersController, type: :controller do
  let(:user) { create(:user, balance: 1000) }
  let(:other_user) { create(:user, balance: 0) }

  before { sign_in user } # если используется devise

  describe 'POST #create' do
    it 'creates a transfer and updates balances' do
      expect {
        post :create, params: { money_transfer: { sender_id: user.id, receiver_id: other_user.id, amount: 500 } }
      }.to change { user.reload.balance }.from(1000).to(500)
      expect(other_user.reload.balance).to eq(500)
      expect(response).to have_http_status(:created)
    end

    it 'returns error when insufficient balance' do
      post :create, params: { money_transfer: { sender_id: user.id, receiver_id: other_user.id, amount: 2000 } }
      expect(response).to have_http_status(:unprocessable_entity)
    end
  end
end
