# frozen_string_literal: true

module LookAndSay
  # Генератор одного члена последовательности за шаг.
  class Generator
    def initialize(seed = '1')
      raise ArgumentError, 'Seed must be a non-empty string of digits' unless seed.match?(/\A\d+\z/)

      @current = seed
    end

    # Возвращает следующий член и обновляет внутреннее состояние.
    def next
      @current = describe(@current)
    end

    # Генерирует n элементов, начиная со следующего.
    def take(n)
      Array.new(n) { next }
    end

    # Сброс к начальному или новому значению.
    def reset(seed = '1')
      @current = seed
      self
    end

    private

    # "111" → "31" (три единицы)
    def describe(input)
      input
        .chars
        .chunk_while { |a, b| a == b }
        .map { |group| "#{group.size}#{group.first}" }
        .join
    end
  end

  # Ленивая бесконечная последовательность с кэшированием.
  class Sequence
    include Enumerable

    def initialize(seed = '1')
      @generator = Generator.new(seed)
      @cache = []
    end

    def each
      return enum_for(:each) unless block_given?

      i = 0
      loop do
        yield fetch(i)
        i += 1
      end
    end

    def [](index)
      fetch(index)
    end

    private

    def fetch(index)
      while @cache.size <= index
        @cache << @generator.next
      end
      @cache[index]
    end
  end
end
