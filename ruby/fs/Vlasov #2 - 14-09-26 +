# frozen_string_literal: true

module LookAndSay
  # Генератор членa последовательности на основе строки цифр.
  class Generator
    def initialize(seed = '1')
      raise ArgumentError, 'Seed must be a non-empty string of digits' unless seed.match?(/\A\d+\z/)

      @current = seed
    end

    # Возвращает следующий член последовательности.
    def next
      @current = describe(@current)
    end

    # Генерирует n членов, начиная с текущего.
    # Возвращает массив строк.
    def take(n)
      Array.new(n) { next }
    end

    # Сброс к начальному значению.
    def reset(seed = '1')
      @current = seed
      self
    end

    private

    # Описание строки: "111" → "31" (три единицы)
    def describe(input)
      input
        .chars
        .chunk_while { |a, b| a == b }
        .map { |group| "#{group.size}#{group.first}" }
        .join
    end
  end

  # Итератор, ведущий себя как Enumerable.
  class Sequence
    include Enumerable

    def initialize(seed = '1')
      @generator = Generator.new(seed)
      @cache = []
    end

    def each
      return enum_for(:each) unless block_given?

      i = 0
      loop do
        yield fetch(i)
        i += 1
      end
    end

    def [](index)
      fetch(index)
    end

    private

    def fetch(index)
      while @cache.size <= index
        @cache << @generator.next
      end
      @cache[index]
    end
  end
end
spec/look_and_say_spec.rb
ruby
# frozen_string_literal: true

require 'look_and_say'

RSpec.describe LookAndSay::Generator do
  let(:generator) { described_class.new }

  describe '#next' do
    it 'generates the correct sequence' do
      expected = %w[1 11 21 1211 111221 312211 13112221]
      values = ['1']
      6.times { values << generator.next }
      expect(values).to eq(expected)
    end

    it 'starts from custom seed' do
      gen = described_class.new('22')
      expect(gen.next).to eq('22')
      expect(gen.next).to eq('2222')
      expect(gen.next).to eq('44')
    end
  end

  describe '#take' do
    it 'returns n consecutive elements' do
      gen = described_class.new
      expect(gen.take(5)).to eq(%w[11 21 1211 111221 312211])
    end
  end

  describe '#reset' do
    it 'resets to initial seed' do
      gen = described_class.new
      3.times { gen.next }
      gen.reset
      expect(gen.next).to eq('11')
    end
  end

  describe 'invalid seed' do
    it 'raises ArgumentError for non-digit input' do
      expect { described_class.new('abc') }.to raise_error(ArgumentError)
    end

    it 'raises ArgumentError for empty input' do
      expect { described_class.new('') }.to raise_error(ArgumentError)
    end
  end
end

RSpec.describe LookAndSay::Sequence do
  let(:sequence) { described_class.new }

  it 'returns elements by index' do
    expect(sequence[0]).to eq('11')
    expect(sequence[1]).to eq('21')
    expect(sequence[5]).to eq('13112221')
  end

  it 'caches computed values' do
    expect(sequence[2]).to eq('1211')
    expect(sequence[0]).to eq('11')
  end

  it 'is enumerable' do
    first_five = sequence.first(5)
    expect(first_five).to eq(%w[11 21 1211 111221 312211])
  end
end
