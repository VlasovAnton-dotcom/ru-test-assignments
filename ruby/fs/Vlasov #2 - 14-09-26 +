ruby
# frozen_string_literal: true

class Event < ApplicationRecord
  enum recurrence: { none: 0, daily: 1, weekly: 2, monthly: 3, yearly: 4 }

  belongs_to :user

  validates :title, presence: true
  validates :date, presence: true

  scope :for_user, ->(user) { where(user: user) }
  scope :ordered, -> { order(date: :asc) }

  # Раскрытие повторяющихся событий для диапазона дат календаря.
  # Возвращает массив хешей { event:, date: }.
  def self.expand_for_range(events, start_date, end_date)
    result = []
    events.each do |event|
      if event.none?
        result << { event: event, date: event.date } if event.date.between?(start_date, end_date)
      else
        event.occurrences_between(start_date, end_date).each do |occ_date|
          result << { event: event, date: occ_date }
        end
      end
    end
    result.sort_by { |h| h[:date] }
  end

  def occurrences_between(start_date, end_date)
    dates = []
    current = date
    while current <= end_date
      dates << current if current >= start_date
      current = next_occurrence(current)
    end
    dates
  end

  private

  def next_occurrence(current)
    case recurrence
    when 'daily'   then current + 1.day
    when 'weekly'  then current + 1.week
    when 'monthly' then current >> 1
    when 'yearly'  then current >> 12
    else current + 1.day
    end
  end
end
