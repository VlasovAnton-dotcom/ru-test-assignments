      visit feedbacks_path
      expect(page).to have_css('.pagination')
    end
  end

  describe 'As Admin User I want to search through feedbacks' do
    before do
      create(:feedback, name: 'John Smith', email: 'john@example.com', text: 'Hello')
      create(:feedback, name: 'Michael Brown', email: 'misha@example.com', text: 'Help')
      sign_in admin
    end

    it 'filters by name' do
      visit feedbacks_path
      fill_in 'q', with: 'john'
      click_button 'Search'

      expect(page).to have_content('John Smith')
      expect(page).not_to have_content('Michael Brown')
    end

    it 'filters by text' do
      visit feedbacks_path
      fill_in 'q', with: 'Help'
      click_button 'Search'

      expect(page).to have_content('Michael Brown')
      expect(page).not_to have_content('John Smith')
    end
  end
end
