      expect(gen.next).to eq('22')
      expect(gen.next).to eq('2222')
    end
  end

  describe '#take' do
    it 'returns the requested number of elements' do
      gen = described_class.new
      result = gen.take(3)
      expect(result).to eq(%w[11 21 1211])
    end
  end

  describe '#reset' do
    it 'resets to the seed value' do
      gen = described_class.new
      3.times { gen.next }
      gen.reset
      expect(gen.next).to eq('11')
    end
  end

  describe 'invalid seed' do
    it 'raises ArgumentError for non-digit string' do
      expect { described_class.new('abc') }.to raise_error(ArgumentError)
    end

    it 'raises ArgumentError for empty string' do
      expect { described_class.new('') }.to raise_error(ArgumentError)
    end
  end
