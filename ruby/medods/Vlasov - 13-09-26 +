### `test_github_api.py`
```python
import os
import sys
import requests
from dotenv import load_dotenv

load_dotenv()

GITHUB_USER = os.getenv("GITHUB_USERNAME")
GITHUB_TOKEN = os.getenv("GITHUB_TOKEN")
REPO_NAME = os.getenv("REPO_NAME")

if not all([GITHUB_USER, GITHUB_TOKEN, REPO_NAME]):
    sys.exit("Переменные GITHUB_USERNAME, GITHUB_TOKEN, REPO_NAME обязательны")

BASE = "[https://api.github.com](https://api.github.com)"
HEADERS = {"Authorization": f"token {GITHUB_TOKEN}", "Accept": "application/vnd.github+json"}

def create_repo():
    url = f"{BASE}/user/repos"
    data = {"name": REPO_NAME, "private": False}
    r = requests.post(url, json=data, headers=HEADERS)
    assert r.status_code == 201, f"Create failed: {r.text}"
    print(f"✅ Репозиторий {REPO_NAME} создан")

def list_repos():
    url = f"{BASE}/user/repos?per_page=100"
    r = requests.get(url, headers=HEADERS)
    assert r.status_code == 200
    repos = [repo["name"] for repo in r.json()]
    assert REPO_NAME in repos, f"Репозиторий {REPO_NAME} не найден в списке"
    print(f"✅ {REPO_NAME} присутствует в списке репозиториев")

def delete_repo():
    url = f"{BASE}/repos/{GITHUB_USER}/{REPO_NAME}"
    r = requests.delete(url, headers=HEADERS)
    assert r.status_code in (204, 200), f"Delete failed: {r.text}"
    print(f"✅ Репозиторий {REPO_NAME} удалён")

if __name__ == "__main__":
    create_repo()
    list_repos()
    delete_repo()
    print("Все проверки пройдены.")
