## Модели

```ruby
# app/models/task.rb
class Task < ApplicationRecord
  has_many :task_tags, dependent: :destroy
  has_many :tags, through: :task_tags

  has_many :occurrences, dependent: :destroy

  validates :title, presence: true
  validates :due_date, presence: true
  validates :status, inclusion: { in: %w[pending in_progress completed cancelled] }

  validate :validate_recurrence

  private

  def validate_recurrence
    case recurrence_type
    when "daily"
      errors.add(:recurrence_interval, "должен быть положительным") unless recurrence_interval&.positive?
    when "monthly_day"
      errors.add(:monthly_day, "должно быть от 1 до 31") unless monthly_day.present? && monthly_day.between?(1, 31)
    when "even_odd"
      errors.add(:even_odd, "должно быть even или odd") unless %w[even odd].include?(even_odd)
    when "specific_dates"
      errors.add(:specific_dates, "должен содержать даты") if specific_dates.blank? || specific_dates.any? { |d| !d.is_a?(Date) }
    end
  end
end

# app/models/tag.rb
class Tag < ApplicationRecord
  has_many :task_tags, dependent: :restrict_with_error
  has_many :tasks, through: :task_tags

  before_destroy :prevent_locked_deletion
  before_update :prevent_locked_update

  private

  def prevent_locked_deletion
    throw(:abort) if locked?
  end

  def prevent_locked_update
    throw(:abort) if locked? && (name_changed? || locked_changed?)
  end
end

