## Логика генерации экземпляров (проблема бесконечности)

Идея: не создавать миллионы строк. Для запроса списка задач в окне `[from_date, to_date]`:

1. Берём все задачи, которые могут попадать в окно (по `due_date` и `recurrence_end_on`).
2. Для каждой задачи генерируем «виртуальные» экземпляры в окне.
3. Подтягиваем сохранённые состояния из `task_occurrences` по `(task_id, occurred_on)`.
4. Если есть запись в `task_occurrences`, берём её статус; иначе — статус шаблона задачи.

Пример сервиса:

```ruby
# app/services/task_occurrence_generator.rb
class TaskOccurrenceGenerator
  def self.generate_for_window(tasks, from_date, to_date)
    results = []

    tasks.each do |task|
      dates = recurrence_dates(task, from_date, to_date)
      dates.each do |d|
        results << {
          task: task,
          occurred_on: d,
          status: status_for_occurrence(task, d)
        }
      end
    end

    results
  end

  def self.status_for_occurrence(task, date)
    occ = TaskOccurrence.find_by(task_id: task.id, occurred_on: date)
    occ ? occ.status : task.status
  end

  private_class_method def self.recurrence_dates(task, from, to)
    dates = []
    start = task.due_date

    return [] unless start

    case task.recurrence_type
    when "daily"
      interval = task.recurrence_interval || 1
      current = start
      while current <= to && (task.recurrence_end_on.nil? || current <= task.recurrence_end_on)
        dates << current if current >= from
        current += interval.days
      end
    when "monthly_day"
      day = task.monthly_day
      current_month = start.beginning_of_month
      while current_month <= to
        candidate = current_month + (day - 1).days
        if candidate.month == current_month.month && candidate >= from && candidate <= to
          dates << candidate if (task.recurrence_end_on.nil? || candidate <= task.recurrence_end_on)
        end
        current_month += 1.month
      end
    when "even_odd"
      mode = task.even_odd # even/odd
      current = start
      while current <= to && (task.recurrence_end_on.nil? || current <= task.recurrence_end_on)
        if current >= from
          day = current.day
          if (mode == "even" && day.even?) || (mode == "odd" && day.odd?)
            dates << current
          end
        end
        current += 1.day
      end
    when "specific_dates"
      dates = (task.specific_dates || []).select { |d| d.between?(from, to) }
    else
      # одиночная задача
      dates << start if start.between?(from, to)
    end

    dates
  end
end
```

В контроллере:

```ruby
# app/controllers/api/v1/tasks_controller.rb
module Api
  module V1
    class TasksController < ApplicationController
      before_action :set_date_range

      def index
        tasks = Task.all
        occurrences = TaskOccurrenceGenerator.generate_for_window(tasks, @from, @to)

        # фильтрация по статусам
        statuses = params[:statuses]&.split(",")
        if statuses
          occurrences.select! { |o| statuses.include?(o[:status]) }
        end

        render json: occurrences.map do |o|
          {
            id: o[:task].id,
            title: o[:task].title,
            description: o[:task].description,
            due_date: o[:occurred_on],
            status: o[:status],
            recurrence_type: o[:task].recurrence_type,
            tags: o[:task].tags.pluck(:name)
          }
        end
      end

      def show
        task = Task.find(params[:id])
        render json: {
          id: task.id,
          title: task.title,
          description: task.description,
          due_date: task.due_date,
          status: task.status,
          recurrence_type: task.recurrence_type,
          tags: task.tags.pluck(:name)
        }
      end

      def create
        task = Task.new(task_params)
        if task.save
          # можно сразу создать теги через join-таблицу
          tag_names = params[:tags] || []
          tag_names.each do |name|
            tag = Tag.find_or_create_by!(name: name)
            TaskTag.create!(task: task, tag: tag)
          end
          render json: task, status: :created
        else
          render json: { errors: task.errors.full_messages }, status: :unprocessable_entity
        end
      end

      private

      def set_date_range
        @from = Date.parse(params[:from] || 30.days.ago.to_s) rescue 30.days.ago.to_date
        @to = Date.parse(params[:to] || 30.days.from_now.to_s) rescue 30.days.from_now.to_date
      end

      def task_params
        params.require(:task).permit(
          :title, :description, :due_date, :status,
          :recurrence_type, :recurrence_interval, :monthly_day, :even_odd,
          :specific_dates, :recurrence_end_on
        )
      end
    end
  end
end
```

Для изменения статуса конкретного экземпляра:

```ruby
# POST /api/v1/task_occurrences
def create_occurrence_override
  task = Task.find(params[:task_id])
  date = Date.parse(params[:occurred_on])
  occ, created = TaskOccurrence.find_or_initialize_by(task_id: task.id, occurred_on: date)
  occ.status = params[:status]
  occ.override_reason = params[:override_reason]
  if occ.save
    render json: occ
  else
    render json: { errors: occ.errors.full_messages }, status: :unprocessable_entity
  end
end
```

Это решает проблему «состояния конкретного экземпляра» и «исключений из правил» (бонусная часть): отдельный `TaskOccurrence` с собственным статусом и причиной изменения.

