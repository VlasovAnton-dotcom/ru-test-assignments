import re
from collections import Counter, defaultdict

# 1. Подготовка данных
text = """
Во глубине сибирских руд
Храните гордое терпенье,
Не пропадет ваш скорбный труд
И дум высокое стремленье.
"""

# Очистка текста: убираем знаки препинания, приводим к нижнему регистру, разбиваем на слова
words = [word.lower() for word in re.findall(r'[a-zа-яё]+', text)]

# Список уникальных слов (заказ может поступить на любое из них)
unique_words = list(set(words))
num_words = len(unique_words)

# 2. Подсчет частот букв в словах
# letter_in_word_count[буква] = в скольких уникальных словах эта буква встречается хотя бы раз
letter_in_word_count = defaultdict(int)
# word_letter_freq[слово][буква] = сколько раз буква встречается в конкретном слове
word_letter_freq = {}

for word in unique_words:
    freq = Counter(word)
    word_letter_freq[word] = freq
    for letter in freq.keys():
        letter_in_word_count[letter] += 1

# 3. Расчет оптимального склада
optimal_stock = {}
total_profit_with_stock = 0

for letter in letter_in_word_count.keys():
    # Вероятность того, что буква встретится в заказе (хотя бы 1 раз)
    p_letter_present = letter_in_word_count[letter] / num_words
    
    # Вероятность того, что буква НЕ встретится
    p_letter_absent = 1 - p_letter_present
    
    # Рассчитаем ожидаемую маржинальную прибыль от хранения одной такой буквы.
    # Мы ищем сценарии, где наличие этой буквы на складе меняет исход с "убытка" на "прибыль".
    
    # Сценарий 1: Слово не содержит эту букву. 
    # Нам эта буква не нужна. Прибыль от ее наличия = 0. (Хранение -1 руб учтем в конце).
    
    # Сценарий 2: Слово содержит букву.
    # Внутри этого сценария (с вероятностью p_letter_present) проверяем, сколько РАЗ буква встречается в слове.
    # Если она встречается > 1 раза, одной буквы на складе не хватит, будет неустойка 10 руб. 
    # Наличие одной буквы на складе не спасает. Прибыль от ее наличия = 0.
    
    profit_from_letter = 0.0
    
    for word in unique_words:
        if letter in word_letter_freq[word]:
            freq_in_word = word_letter_freq[word][letter]
            
            # Если буква нужна в количестве 1 шт.
            if freq_in_word == 1:
                # Считаем, сколько других букв в этом слове не хватает на пустом складе (0 штук каждой)
                # Если не хватает только этой буквы (т.е. все остальные буквы слова есть на складе),
                # мы экономим на экспрессе. Но мы ищем выгоду ОТ ХРАНЕНИЯ ИМЕННО ЭТОЙ БУКВЫ.
                
                # Чтобы нехватка составила РОВНО 1 букву (и мы применили экспресс), 
                # все остальные буквы слова должны быть на складе.
                # Если мы храним эту букву, мы превращаем сценарий "Экспресс (40-2=38)" в "Продажа (40)".
                # Выгода = 2 рубля.
                
                # Проверим, выполнимо ли условие "все остальные буквы на складе" в рамках нашей будущей стратегии.
                # *Важное допущение для локального расчета:* мы проверяем, является ли эта буква 
                # "узким горлышком" (единственной отсутствующей) в самом слове.
                other_letters = [l for l in word_letter_freq[word] if l != letter]
                is_unique_missing = True
                for ol in other_letters:
                    # Если в слове другая буква встречается > 1 раза, одной штуки на складе не хватит.
                    # Значит, нехватка будет > 1, будет неустойка. Наша буква не спасет.
                    if word_letter_freq[word][ol] > 1:
                        is_unique_missing = False
                        break
                
                if is_unique_missing:
                    # В этом слове, если хранить эту букву, мы экономим 2 рубля (не везем экспресс).
                    # Взвешиваем по вероятности выпадения этого слова.
                    profit_from_letter += (1 / num_words) * 2
            
            # Если буква нужна в количестве > 1 шт (например, "глубине" -> 'е' нужно 2 раза).
            # Одной буквы на складе не хватит. Будет неустойка 10 руб. 
            # Хранение одной буквы не меняет исход (все равно -10). Выгода = 0.

    # Итоговая ожидаемая прибыль от хранения одной такой буквы в день
    expected_daily_profit = profit_from_letter - 1.0  # Минус 1 рубль за хранение
    
    if expected_daily_profit > 0:
        # Чтобы максимизировать прибыль, нужно держать максимально возможное количество.
        # Какое максимальное количество нужно? 
        # Смотрим на самое "требовательное" слово из тех, где эта буква встречается 1 раз.
        max_needed = 1
        for word in unique_words:
            if word_letter_freq[word].get(letter, 0) == 1:
                # Проверяем, не требует ли слово этой же буквы больше 1 раза (уже отфильтровано)
                # и не требует ли другие буквы > 1 раза (это не влияет на количество *этой* буквы)
                max_needed = max(max_needed, 1)
        
        # В данной задаче ни одно слово не требует одну и ту же букву более 1 раза.
        # Поэтому оптимально держать ровно 1 штуку.
        optimal_stock[letter] = 1
        total_profit_with_stock += expected_daily_profit

# 4. Проверка: а не выгоднее ли вообще ничего не хранить?
# Если на складе 0 букв:
# - Если слово можно собрать экспрессом (не хватает <= 1 буквы на пустом складе): 40 - 2 = 38 руб.
# - Если не хватает >= 2 букв: 40 - 10 = 30 руб.

profit_no_stock = 0
for word in unique_words:
    # Считаем количество уникальных букв в слове
    unique_letters = len(word_letter_freq[word])
    # Считаем общее количество букв в слове
    total_letters = sum(word_letter_freq[word].values())
    
    # Если общее число букв > числа уникальных, значит есть дубликаты.
    # На пустом складе не хватит как минимум (total_letters - unique_letters + 1) букв?
    # Нет, проще: на пустом складе не хватает ВСЕХ букв слова.
    # Если в слове 1 буква -> не хватает 1 -> экспресс (38)
    # Если в слове 2 одинаковые буквы ("аа") -> не хватает 2 -> неустойка (30)
    # Если в слове 2 разные буквы ("аб") -> не хватает 2 -> неустойка (30)
    
    if total_letters == 1:
        profit_no_stock += 38 / num_words
    else:
        # Если в слове больше 1 буквы, на пустом складе мы не сможем его собрать
        # (не будет хватать как минимум 2 букв из 0).
        # Исключение: если фабрика магическим образом имеет бесконечный запас всех букв, 
        # кроме одной. Но по условию "запасы возобновляются" обычно означает сброс к начальному.
        # При начальном запасе 0, любое слово длиной > 1 буквы дает неустойку.
        profit_no_stock += 30 / num_words

print(f"Ожидаемая прибыль без хранения букв: {profit_no_stock:.2f} руб.")
print(f"Ожидаемая прибыль с оптимальным складом: {total_profit_with_stock:.2f} руб.")
print("\nОптимальный набор букв на складе (словарь):")
print(optimal_stock)

# Для удобства визуализации отсортируем словарь
sorted_stock = dict(sorted(optimal_stock.items()))
print(f"\nИтоговый файл (JSON/YAML совместимый вид):\n{sorted_stock}")
