import re
from collections import Counter

# Текст четверостишия Пушкина
text = """
Во глубине сибирских руд
Храните гордое терпенье,
Не пропадёт ваш скорбный труд
И дум высокое стремленье.
"""

def normalize(text_str):
    """Приведение к нижнему регистру и удаление всего, кроме русских букв."""
    text_str = text_str.lower()
    return re.sub(r'[^а-яё]', ' ', text_str)

words = [w for w in normalize(text).split() if w]
word_counters = [Counter(w) for w in words]

# Параметры экономики фабрики
PRICE = 40       # доход за собранное слово
PENALTY = -10    # штраф за невозможность сборки
EXPRESS = 2      # доплата за доставку одной недостающей буквы
STORAGE = 1      # стоимость хранения одной буквы в сутки

def calculate_profit(stock: dict[str, int]) -> float:
    """Расчет чистой прибыли за день при заданном составе склада."""
    revenue = 0
    for wc in word_counters:
        missing = sum(max(0, need - stock.get(letter, 0)) for letter, need in wc.items())
        
        if missing == 0:
            revenue += PRICE
        elif missing == 1:
            revenue += PRICE - EXPRESS
        else:
            revenue += PENALTY
            
    storage_cost = sum(stock.values()) * STORAGE
    return revenue - storage_cost

# 1. Базовый вариант: хранить строго под самое требовательное слово
max_need = Counter()
for wc in word_counters:
    for l, c in wc.items():
        max_need[l] = max(max_need[l], c)
profit_exact = calculate_profit(dict(max_need))

# 2. Оптимизация: жадный алгоритм добавления самых частых букв
total_freq = Counter(''.join(words))
sorted_letters = [l for l, _ in total_freq.most_common()]

current_stock = {}
current_profit = calculate_profit(current_stock)

while True:
    best_delta = float('-inf')
    best_letter = None
    
    # Проверяем эффект от добавления каждой возможной буквы
    for letter in sorted_letters:
        trial_stock = current_stock.copy()
        trial_stock[letter] = trial_stock.get(letter, 0) + 1
        delta = calculate_profit(trial_stock) - current_profit
        
        if delta > best_delta:
            best_delta = delta
            best_letter = letter
            
    if best_delta > 0 and best_letter is not None:
        current_stock[best_letter] = current_stock.get(best_letter, 0) + 1
        current_profit += best_delta
    else:
        break

# Итоговые результаты
optimal_profit = calculate_profit(current_stock)
empty_profit = calculate_profit({})
full_alpha_profit = calculate_profit({chr(c): max_need.get(chr(c), 0) for c in range(ord('а'), ord('я')+1)})

print("Оптимальная стратегия найдена.")
print(f"Набор букв на складе: {dict(sorted(current_stock.items()))}")
print(f"Ожидаемая чистая прибыль: {optimal_profit} руб./день")
print(f"Для сравнения — хранение полного алфавита: {full_alpha_profit} руб./день")
print(f"Для сравнения — пустой склад: {empty_profit} руб./день")
