import re
from collections import Counter

# Текст четверостишия
text = """
Во глубине сибирских руд
Храните гордое терпенье,
Не пропадёт ваш скорбный труд
И дум высокое стремленье.
"""

# Нормализация: нижний регистр, удаление знаков препинания, оставляем только буквы
text = text.lower()
text = re.sub(r'[^а-яё]', ' ', text)
words = [w for w in text.split() if w]

# Подсчет частот букв в каждом слове
word_counters = [Counter(w) for w in words]

# Общая потребность в буквах (максимум по каждому слову)
total_need = Counter()
for wc in word_counters:
    for letter, cnt in wc.items():
        total_need[letter] = max(total_need[letter], cnt)

# Общая частота букв во всех словах (для оценки спроса)
total_freq = Counter()
for w in words:
    total_freq.update(w)

# Сортировка букв по убыванию общей частоты (приоритет хранения)
sorted_letters = [l for l, _ in total_freq.most_common()]

# Параметры
price = 40
penalty = 10
express = 2
storage = 1

# Функция расчета прибыли для заданного набора запасов
def calc_profit(stock_counts):
    profit = 0
    for wc in word_counters:
        # сколько букв не хватает
        missing = 0
        for letter, need in wc.items():
            have = stock_counts.get(letter, 0)
            if need > have:
                missing += need - have
        if missing == 0:
            profit += price
        elif missing == 1:
            profit += price - express
        else:
            profit -= penalty
    # вычитаем стоимость хранения
    total_letters = sum(stock_counts.values())
    profit -= total_letters * storage
    return profit

