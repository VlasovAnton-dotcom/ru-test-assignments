🖥️ 4. Контроллеры и шаблоны (Thymeleaf)

VoteController.java Контролирует процесс голосования. Мы храним состояние сессии в куках браузера, чтобы приложение было stateless (без сохранения состояний на сервере между запросами).

java
Копировать
@RestController
@RequestMapping("/")
public class VoteController {

    private final MimiService service;

    public VoteController(MimiService mimiService) {
        this.service = mimiService;
    }

    @GetMapping
    public ModelAndView start(Model model, HttpServletRequest req) {
        // Извлекаем сессию из cookie или создаём новую
        UserSession session = extractOrCreateSession(req);

        var nextPairOpt = service.getNextPair(session);
        if (nextPairOpt.isEmpty()) {
            // Если пар больше нет, переадресуем на топ
            return new ModelAndView("redirect:/top");
        }

        Pair<Cat> pair = nextPairOpt.get();
        model.addAttribute("left", pair.left());
        model.addAttribute("right", pair.right());
        return new ModelAndView("vote");
    }

    @PostMapping("/vote/{winner}")
    public String processVote(@PathVariable Long winner,
                             @RequestParam Long opponent,
                             HttpServletResponse resp,
                             HttpServletRequest req) {
        UserSession session = extractOrCreateSession(req);
        service.vote(winner, opponent, session);
        saveSessionToCookie(resp, session);
        return "redirect:/";
    }

    // Вспомогательные методы для работы с куками
    private UserSession extractOrCreateSession(HttpServletRequest req) {
        Cookie[] cookies = req.getCookies();
        if (cookies != null) {
            for (Cookie c : cookies) {
                if ("mimi_session".equals(c.getName())) {
                    try {
                        return objectMapper.readValue(c.getValue(), UserSession.class);
                    } catch (IOException e) {
                        // Игнорируем ошибку десериализации, создадим новый сеанс
                    }
                }
            }
        }
        return new UserSession();
    }

    private void saveSessionToCookie(HttpServletResponse resp, UserSession session) throws IOException {
        Cookie cookie = new Cookie("mimi_session", objectMapper.writeValueAsString(session));
        cookie.setMaxAge(60 * 60 * 24 * 7); // Срок жизни недели
        cookie.setHttpOnly(true);
        resp.addCookie(cookie);
    }

    // Объектомаппер для сериализации UserSession
    private ObjectMapper objectMapper = new ObjectMapper()
            .registerModule(new JavaTimeModule())
            .disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);
}

