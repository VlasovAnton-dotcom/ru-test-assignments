⚙️ 3. Логика голосования (Service Layer)

Здесь происходит вся магия: формирование уникальных пар, подсчёт голосов и проверка сессий.

MimiService.java Ключевой метод getNextPair работает так:

Генерирует все возможные уникальные комбинации из списка котов (n * (n - 1) вариантов). Для этого используется простой перебор индексов массива.
Преобразует каждую пару в хеш-строку вида "id_меньшего;id_большего". Это нужно для того, чтобы не учитывать порядок (пары (1,2) и (2,1) считаются одинаковыми).
Сравнивает этот список со списком уже проголосованных пар текущего пользователя.
Возвращает первую непосещённую пару.

Если таких пар нет — голосование завершено.

java
Копировать
@Service
public class MimiService {

    private final CatRepository catRepo;

    public MimiService(CatRepository repo) { this.catRepo = repo; }

    /**
     * Получение следующей уникальной пары для голосования.
     */
    public Optional<Pair<Cat>> getNextPair(UserSession session) {
        List<Cat> cats = catRepo.findAll();
        if (cats.size() < 2) return Optional.empty(); // Недостаточно котов

        // Генерация всех возможных уникальных пар без учёта порядка
        List<String> allPossiblePairs = generateUniquePairs(cats);

        // Находим первую пару, за которую пользователь ещё не голосовал
        for (String pairHash : allPossiblePairs) {
            if (!session.getVotedPairs().contains(pairHash)) {
                long[] ids = parseIdsFromHash(pairHash);
                return Optional.of(new Pair<>(
                        findById(ids[0]),
                        findById(ids[1])
                ));
            }
        }
        return Optional.empty(); // Голосование закончено
    }

    /**
     * Регистрация голоса пользователя.
     * Записывает результат в БД и помечает эту пару как проголосованную.
     */
    public void vote(Long winnerId, Long loserId, UserSession session) {
        Cat winner = findById(winnerId);
        winner.setVotes(winner.getVotes() + 1); // Прибавляем голос победителю
        catRepo.save(winner);

        // Сохраняем факт голосования этой пары для текущей сессии
        String hash = createPairHash(winnerId, loserId);
        session.getVotedPairs().add(hash);
    }

    // Вспомогательные методы для работы с парами
    private List<String> generateUniquePairs(List<Cat> cats) {
        List<String> pairs = new ArrayList<>();
        for (int i = 0; i < cats.size(); i++) {
            for (int j = i + 1; j < cats.size(); j++) {
                pairs.add(createPairHash(cats.get(i).getId(), cats.get(j).getId()));
            }
        }
        return pairs;
    }

    private String createPairHash(long a, long b) {
        return Math.min(a, b) + ";" + Math.max(a, b);
    }

    private long[] parseIdsFromHash(String hash) {
        String[] parts = hash.split(";");
        return new long[]{Long.parseLong(parts[0]), Long.parseLong(parts[1])};
    }

    private Cat findById(long id) {
        return catRepo.findById(id).orElseThrow(() -> new IllegalArgumentException("Кот не найден"));
    }
}

