Копировать
@RestController
@RequestMapping("/top")
public class TopController {

    private final CatRepository repository;

    public TopController(CatRepository repository) {
        this.repository = repository;
    }

    @GetMapping
    public ModelAndView show(Model model) {
        // Сортируем котов по убыванию количества голосов
        List<Cat> topCats = repository.findAll()
                .stream()
                .sorted(Comparator.comparingInt(Cat::getVotes).reversed())
                .limit(10) // Топ-10
                .toList();

        model.addAttribute("ranking", topCats);
        return new ModelAndView("top");
    }
}

