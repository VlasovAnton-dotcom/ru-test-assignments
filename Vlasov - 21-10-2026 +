<script setup>
import { ref, reactive } from 'vue';
import { Search, Refresh } from '@element-plus/icons-vue';
import { HouseTable, Loading } from '@element-plus/icons-vue';
import { ElMessage } from 'element-plus';

const filters = reactive({
    name: '',
    bedrooms: '',
    bathrooms: '',
    storeys: '',
    garages: '',
    price_from: '',
    price_to: ''
});

const results = ref([]);
const loading = ref(false);
const noResults = ref(false);

const search = async () => {
    loading.value = true;
    noResults.value = false;
    
    try {
        const query = new URLSearchParams();
        Object.entries(filters).forEach(([key, value]) => {
            if (value !== '' && value !== null) {
                query.append(key, value);
            }
        });

        const response = await fetch(`/api/houses?${query.toString()}`);
        const data = await response.json();

        if (data.length === 0) {
            noResults.value = true;
            results.value = [];
        } else {
            results.value = data;
        }
    } catch (error) {
        ElMessage.error('Ошибка при запросе к серверу');
        results.value = [];
    } finally {
        loading.value = false;
    }
};

const reset = () => {
    Object.keys(filters).forEach(key => filters[key] = '');
    results.value = [];
    noResults.value = false;
};
</script>

