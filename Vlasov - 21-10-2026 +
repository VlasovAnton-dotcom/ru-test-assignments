use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;

class HousesSeeder extends Seeder
{
    public function run(): void
    {
        DB::table('houses')->truncate();
        
        $csvPath = database_path('data/houses.csv');
        if (!file_exists($csvPath)) {
            $this->command->error("CSV file not found at {$csvPath}");
            return;
        }

        $handle = fopen($csvPath, 'r');
        $header = fgetcsv($handle); // Пропускаем заголовок

        while (($data = fgetcsv($handle)) !== false) {
            DB::table('houses')->insert([
                'name' => $data[0],
                'bedrooms' => (int)$data[1],
                'bathrooms' => (int)$data[2],
                'storeys' => (int)$data[3],
                'garages' => (int)$data[4],
                'price' => (int)$data[5],
                'created_at' => now(),
                'updated_at' => now(),
            ]);
        }
        fclose($handle);
    }
}

(CSV-файл houses.csv должен лежать в database/data/)

2. Модель и Контроллер (Eloquent & Controller)
Логика поиска вынесена в скоуп модели для чистоты контроллера.

app/Models/House.php:

php
Копировать
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Model;

class House extends Model
{
    protected $fillable = ['name', 'bedrooms', 'bathrooms', 'storeys', 'garages', 'price'];

    public function scopeFilter(Builder $query, array $filters): Builder
    {
        return $query
            ->when($filters['name'] ?? false, fn($q, $name) => $q->where('name', 'LIKE', "%{$name}%"))
            ->when($filters['bedrooms'] ?? false, fn($q, $val) => $q->where('bedrooms', $val))
            ->when($filters['bathrooms'] ?? false, fn($q, $val) => $q->where('bathrooms', $val))
            ->when($filters['storeys'] ?? false, fn($q, $val) => $q->where('storeys', $val))
            ->when($filters['garages'] ?? false, fn($q, $val) => $q->where('garages', $val))
            ->when(isset($filters['price_from']) && isset($filters['price_to']), 
                fn($q) => $q->whereBetween('price', [(int)$filters['price_from'], (int)$filters['price_to']])
            );
    }
}

