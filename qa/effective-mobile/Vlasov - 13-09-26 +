import os
import pytest
from playwright.sync_api import sync_playwright
from dotenv import load_dotenv

load_dotenv()

URL = os.getenv("SAUCEDEMO_URL", "https://www.saucedemo.com")
USER = os.getenv("SAUCE_USER", "standard_user")
PASS = os.getenv("SAUCE_PASS", "secret_sauce")

@pytest.fixture(scope="session")
def browser():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False)  # headless=True для CI
        yield browser
        browser.close()

def test_full_purchase(browser):
    page = browser.new_page()
    page.goto(URL)

    # --- Авторизация ---
    page.fill("#user-standard_user", USER)
    page.fill("#password", PASS)
    page.click("#login-button")
    assert page.url == "https://www.saucedemo.com/inventory.html"

    # --- Добавить рюкзак в корзину ---
    page.click("button:has-text('Add to Cart')")
    assert page.locator(".shopping_cart_badge").text_content() == "1"

    # --- Перейти в корзину ---
    page.click(".shopping_cart_link")
    assert "Cart" in page.title()
    assert page.locator("div.cart_item").count() == 1

    # --- Оформить покупку ---
    page.click("#checkout")
    page.fill("#first-name", "Test")
    page.fill("#last-name", "User")
    page.fill("#postal-code", "12345")
    page.click("#continue")

    # --- Проверка завершения ---
    assert "THANK YOU FOR YOUR ORDER" in page.locator(".complete-header").text_content()
    page.click("#back-to-products")
    assert page.url == "https://www.saucedemo.com/inventory.html"
