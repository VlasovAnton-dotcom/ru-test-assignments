def calculate_revenue_fast(N: int, M: int, X: int) -> int:
    full_blocks = N // M          # Количество полностью заполненных блоков по M этажей
    remainder = N % M             # Количество этажей в последнем неполном блоке
    
    total_revenue = 0
    
    # Суммируем выручку от полных блоков
    for i in range(full_blocks):
        price_in_block = X + i * 1000
        count_in_block = M if not (i == full_blocks - 1 and remainder == 0) else N
        # Если дом заканчивается ровно на границе блока, количество этажей в нем может быть меньше M
        # Однако проще считать всегда по M, а остаток обработать отдельно ниже.
        total_revenue += price_in_block * M
        
    # Добавляем выручку от последнего неполного блока
    last_block_price = X + full_blocks * 1000
    total_revenue += last_block_price * remainder
    
    return total_revenue

