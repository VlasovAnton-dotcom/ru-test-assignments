Модель Import с перечислением (enum) статусов:
ruby
# app/models/import.rb
class Import < ApplicationRecord
  has_many :import_errors, dependent: :destroy
  has_one_attached :csv_file

  validates :name, presence: true
  validates :csv_file, attached: true, content_type: ['text/csv', 'application/vnd.ms-excel']

  enum status: { created: 0, started: 1, completed: 2, failed: 3 }

  scope :recent, -> { order(created_at: :desc) }
end
Валидация клиента (через сервис или PORO — Plain Old Ruby Object): Поскольку клиенты не сохраняются как отдельная таблица в рамках этого задания (важно только количество созданных), логика валидации выносится в отдельный класс:
ruby
# app/services/client_validator.rb
class ClientValidator
  attr_reader :errors

  REQUIRED_FIELDS = %w[first_name last_name email date_of_birth].freeze

  def initialize(row)
    @data = row.to_h.transform_keys(&:strip).transform_values(&:strip)
    @errors = []
  end

  def valid?
    check_required_fields
    validate_names
    validate_email
    validate_age
    errors.empty?
  end

  private

  def check_required_fields
    REQUIRED_FIELDS.each do |field|
      errors << "#{field.humanize} is missing" if @data[field].blank?
    end
  end

  def validate_names
    %w[first_name last_name].each do |name_field|
      next if @data[name_field].blank?
      errors << "#{name_field.humanize} must be at least 2 characters long" if @data[name_field].length < 2
    end
  end

  def validate_email
    return if @data['email'].blank?
    unless URI::MailTo::EMAIL_REGEXP.match?(@data['email'])
      errors << "Email format is invalid"
    end
  end

  def validate_age
    return if @data['date_of_birth'].blank?
    
    dob = Date.parse(@data['date_of_birth']) rescue nil
    if dob.nil?
      errors << "Date of birth is invalid"
    else
      age = ((Time.current - dob.to_time) / 1.year.seconds).floor
      errors << "Client must be older than 18 and younger than 100" unless age.between?(18, 99)
    end
  end
end
2. Бизнес-логика (Service Objects)
Обработка больших файлов (до 100 000 строк) блокирующими методами приведет к таймауту веб-процесса. Поэтому обработка должна быть вынесена в фоновый Job.
Сервис создания импорта:
ruby
# app/services/imports/create_service.rb
class Imports::CreateService
  def initialize(import_params)
    @params = import_params
  end

  def call
    import = Import.new(name: @params[:name])
    import.csv_file.attach(@params[:csv_file])
    import.save ? import : raise(ActiveRecord::RecordInvalid, import)
  end
end
Фоновый обработчик (Background Job): Для обработки огромных CSV-файлов используется гем smarter_csv (для потокового чтения без загрузки всей памяти) и Sidekiq.
ruby
# app/jobs/process_import_job.rb
require 'smarter_csv'

class ProcessImportJob < ApplicationJob
  queue_as :default

  def perform(import_id)
    import = Import.find(import_id)
    import.update!(status: :started, started_at: Time.current)

    file_path = ActiveStorage::Blob.service.path_for(import.csv_file.key)
    
    options = {
      chunk_size: 500,
      user_provided_headers: %w[first_name last_name email date_of_birth],
      downcase_header: true
    }

    SmarterCSV.process(file_path, options) do |chunk|
      process_chunk(chunk, import)
      
      # Обновляем прогресс каждые N строк
      percentage = (import.success_count + import.failure_count).to_f / import.total_rows * 100
      import.update(progress_percentage: percentage)
    end

    import.update!(
      status: :completed,
      completed_at: Time.current,
      progress_percentage: 100.0
    )
  rescue StandardError => e
    import.update(status: :failed, completed_at: Time.current)
    Rails.logger.error "Import ##{import.id} failed: #{e.message}"
  end

  private

  def process_chunk(chunk, import)
    chunk.each_with_index do |row, index|
      validator = ClientValidator.new(row)
      global_row_number = import.success_count + import.failure_count + index + 1

      if validator.valid?
        # Здесь может быть создание реальной записи Customer.create!
        import.increment!(:success_count)
      else
        import.increment!(:failure_count)
        import.import_errors.create(
          row_number: global_row_number,
          error_messages: validator.errors.join(', '),
          raw_data: row
        )
      end
    end
  end
end
Примечание по обработке: Если файл содержит миллионные строки, вместо обновления БД на каждой итерации можно использовать Redis-счетчики для прогресса, а итоговые числа записывать в базу раз в несколько секунд, чтобы избежать блокировки таблицы.
3. Контроллеры
ImportsController:
ruby
# app/controllers/imports_controller.rb
class ImportsController < ApplicationController
  before_action :set_import, only: %i[show destroy start]

  def index
    @imports = Import.recent.page(params[:page])
  end

  def new
    @import = Import.new
  end

  def create
    service = Imports::CreateService.new(import_params)
    @import = service.call
    redirect_to @import, notice: 'Import was successfully created.'
  rescue ActiveRecord::RecordInvalid
    render :new, status: :unprocessable_entity
  end

  def show; end

  def destroy
    @import.destroy
    redirect_to imports_url, notice: 'Import was successfully destroyed.'
  end

  def start
    ProcessImportJob.perform_later(@import.id)
    redirect_to @import, notice: 'Import processing has been started.'
  end

  private

  def set_import
    @import = Import.find(params[:id])
  end

  def import_params
    params.require(:import).permit(:name, :csv_file)
  end
end
