5. Тесты (RSpec)
Требуется покрыть тестами сценарии работы с маленькими (500 строк) и большими (100 000 строк) файлами.
Спецификация сервиса создания:
ruby
# spec/services/imports/create_service_spec.rb
require 'rails_helper'

RSpec.describe Imports::CreateService do
  subject { described_class.new(params) }
  let(:file) { fixture_file_upload('files/small_test.csv', 'text/csv') }
  let(:params) { { name: 'Test Import', csv_file: file } }

  it 'creates a new import record' do
    result = subject.call
    expect(result).to be_persisted
    expect(result.name).to eq('Test Import')
    expect(result.csv_file).to be_attached
  end

  context 'when file is missing' do
    let(:params) { { name: 'Test Import' } }
    it { expect { subject.call }.to raise_error(ActiveRecord::RecordInvalid) }
  end
end
Спецификация фонового джоба (ключевой тест производительности):
ruby
# spec/jobs/process_import_job_spec.rb
require 'rails_helper'

RSpec.describe ProcessImportJob, type: :job do
  include ActiveJob::TestHelper

  let(:import) { create(:import, :with_small_csv) } # FactoryBot trait attaching test file

  around do |example|
    perform_enqueued_jobs { example.run }
  end

  it 'processes the file and updates counts' do
    expect { 
      described_class.perform_now(import.id) 
    }.to change { import.reload.success_count }.by(500) # Ожидаемое кол-во валидных строк
     .and change { import.reload.failure_count }.by(0)
     .and change { import.reload.status }.from('created').to('completed')
  end

  context 'with validation errors' do
    let(:import) { create(:import, :with_invalid_csv) }
    it 'counts failures correctly' do
      described_class.perform_now(import.id)
      expect(import.reload.failure_count).to be > 0
      expect(import.import_errors.count).to be > 0
    end
  end

  context 'performance with large files' do
    let(:import) { create(:import, :with_large_csv) } # Файл на 100_000 строк
    
    it 'completes within reasonable memory limits' do
      initial_memory = `ps -o rss= -p #{Process.pid}`.to_i
      described_class.perform_now(import.id)
      final_memory = `ps -o rss= -p #{Process.pid}`.to_i
      
      expect(import.reload.status).to eq('completed')
      # Проверка, что процесс не съел всю память (например, рост менее 200 МБ)
      expect(final_memory - initial_memory).to be < 200_000 
    end
  end
end
Рекомендация по настройке окружения: Для локальной разработки и тестирования таких сценариев обязательно используйте адаптер асинхронной очереди: config.active_job.queue_adapter = :async А для production-развертывания потребуется установка Redis и воркеров Sidekiq, так как обработка файла на 100 000 записей займет значительное время и точно превысит лимит времени ответа HTTP-запроса. Также необходимо настроить жизненный цикл прикрепленных файлов (Active Storage), например, политику удаления через 30 дней после завершения импорта.
