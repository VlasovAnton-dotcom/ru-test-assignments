[ApiController]
[Route("api/[controller]")]
public class AuthController : ControllerBase
{
    private readonly IEmailCodeService _codeService;
    private readonly IPublishEndpoint _publishEndpoint; // MassTransit

    public AuthController(IEmailCodeService codeService, IPublishEndpoint publishEndpoint)
    {
        _codeService = codeService;
        _publishEndpoint = publishEndpoint;
    }

    [HttpPost("register/start")]
    [ProducesResponseType(StatusCodes.Status202Accepted)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> StartRegistration([FromBody] RegisterStartRequest request)
    {
        var code = await _codeService.GenerateAndStoreAsync(request.Email);
        
        // Отправляем задание в очередь
        await _publishEndpoint.Publish(new SendEmailCommand(request.Email, code));
        
        return Accepted(new { Message = "Код отправлен" });
    }

    [HttpPost("register/verify")]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> VerifyRegistration([FromBody] RegisterVerifyRequest request)
    {
        if (await _codeService.VerifyAsync(request.Email, request.Code))
        {
            // Здесь можно создать пользователя в БД, выдать токен и т.д.
            return Ok(new { Success = true, Message = "Регистрация успешна" });
        }
        
        return BadRequest(new { Success = false, Message = "Неверный код" });
    }
}

