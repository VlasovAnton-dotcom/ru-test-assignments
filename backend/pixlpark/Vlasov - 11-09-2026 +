import React, { useState } from 'react';
import { Input, Button, message } from 'antd';

export default function EmailRegistrationForm() {
  const [step, setStep] = useState('email'); // 'email' | 'code' | 'success'
  const [email, setEmail] = useState('');
  const [code, setCode] = useState('');
  const [loading, setLoading] = useState(false);
  const [timer, setTimer] = useState(null);

  const startRegistration = async () => {
    if (!email) return message.error('Введите почту');
    setLoading(true);
    try {
      const res = await fetch('/api/auth/register/start', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ email })
      });
      if (res.ok) {
        setStep('code');
        // Блокируем повторную отправку на 60 сек (защита от ДДОС на клиенте)
        let secondsLeft = 60;
        setTimer(secondsLeft);
        const interval = setInterval(() => {
          secondsLeft--;
          setTimer(secondsLeft);
          if (secondsLeft <= 0) clearInterval(interval);
        }, 1000);
      } else {
        const data = await res.json();
        message.error(data.message || 'Ошибка запроса');
      }
    } catch (e) {
      message.error('Сетевая ошибка');
    } finally {
      setLoading(false);
    }
  };

  const verifyCode = async () => {
    if (!code) return message.error('Введите код');
    setLoading(true);
    try {
      const res = await fetch('/api/auth/register/verify', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ email, code })
      });
      const data = await res.json();
      if (data.success) {
        setStep('success');
      } else {
        message.error(data.message || 'Неверный код');
      }
    } catch (e) {
      message.error('Сетевая ошибка');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ maxWidth: 400, margin: '0 auto' }}>
      {step === 'email' && (
        <>
          <Input placeholder="Электронная почта" value={email} onChange={e => setEmail(e.target.value)} />
          <Button type="primary" loading={loading} disabled={!email || timer > 0} onClick={startRegistration}>
            {timer > 0 ? `Повтор через ${timer}s` : 'Продолжить'}
          </Button>
        </>
      )}
      
      {step === 'code' && (
        <>
          <p>На адрес {email} отправлен код.</p>
          <Input placeholder="Введите код" value={code} onChange={e => setCode(e.target.value)} />
          <Button type="primary" loading={loading} onClick={verifyCode}>Подтвердить</Button>
        </>
      )}

      {step === 'success' && (
        <div>
          <h2>Успешно!</h2>
          <p>Аккаунт зарегистрирован.</p>
        </div>
      )}
    </div>
  );
}
Локализуемость (I18n)
Сервер: Используется встроенный механизм ASP.NET Core Localization. Строки ошибок и уведомлений оборачиваются в IStringLocalizer<T>. Фразы хранятся в ресурсах Resources/Controllers.AuthController.en.resx и ...ru.resx.
Клиент: Рекомендуется библиотека i18next. Тексты кнопок («Продолжить», «Подтвердить») берутся из её словарей. Язык может переключаться либо вручную пользователем, либо автоматически на основе заголовка Accept-Language, который React передает в каждом запросе к API.
Защита от дудоса и типичные ошибки реализации
Уровень	Мера защиты
Frontend	Таймер на кнопку отправки (60 секунд), отключение кнопки до ввода данных, индикация загрузки.
Backend (Rate Limiting)	Middleware (например, AspNetCoreRateLimit), ограничивающий количество запросов к /register/start по IP-адресу (например, не более 5 раз в минуту).
Backend (Validation)	Проверка синтаксиса email перед генерацией кода. Использование капчи (reCAPTCHA v3 невидимо для пользователя, но отсекает ботов) на первом шаге.
Backend (Storage)	Использование TTL (Redis — 5 минут, SQL — фоновый Job-очиститель) для удаления просроченных кодов, чтобы таблица не росла бесконечно.
Backend (Security)	Приведение email к нижнему регистру перед сохранением ключа, чтобы избежать дублирования User@Mail.com и user@mail.com.
Backend (Race conditions)	Использование атомарных операций при записи в базу (UPSERT / INSERT ... ON CONFLICT UPDATE) или команд SETNX в Redis, чтобы параллельные запросы не перезаписали актуальный код новым.
Разбор вопросов для собеседования на основе этого задания
Алгоритмы и структуры данных:
Как эффективно хранить коды подтверждения для миллионов пользователей? Ответ: In-memory хранилище с TTL (Redis). Хеш-таблица обеспечивает O(1) для вставки и проверки. Ключ — нормализованный email, значение — код. TTL решает проблему очистки мусора.
Какой алгоритм генерации случайного кода безопасен? Ответ: Не Math.random() (детерминирован и предсказуем), а криптографически стойкий генератор (RandomNumberGenerator.GetInt32 в .NET или аналоги).
Платформа .NET:
Жизненный цикл сервисов в DI-контейнере ASP.NET Core. Почему IMessageProducer стоит регистрировать как Singleton, а обработчики RabbitMQ — как Transient?
Чем отличается BackgroundService от использования IHostedService напрямую? Зачем нужен IApplicationLifetime или IHostApplicationLifetime для корректной остановки воркера при получении SIGTERM?
Как работает middleware pipeline в Minimal APIs vs классический MVC?
Протокол HTTP:
Какие статусы ответа вы использовали и почему? 202 Accepted для старта (запрос принят, но обработка асинхронная — письмо еще не ушло физически), 200 OK для успеха, 400 Bad Request для неверного кода или формата.
Что такое идемпотентность? Является ли метод POST /register/verify идемпотентным? Да, так как многократный вызов с одними и теми же данными вернет один и тот же результат (успех или неудача) без побочных эффектов изменения состояния на стороне сервера сверх первого раза.
Роль заголовков Cache-Control, ETag (в данном задании не критично, но важно понимать теорию) и Retry-After (можно вернуть при превышении лимита запросов).
