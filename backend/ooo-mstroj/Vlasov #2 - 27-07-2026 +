class TreeStore:
    def __init__(self, items):
        # Сохраняем ссылку на исходный массив для getAll()
        self._items = items
        
        # Словарь для O(1) доступа к элементу по id: {id: object}
        self._id_to_item = {}
        
        # Словарь для хранения детей: {parent_id: [child_object_1, child_object_2, ...]}
        self._children_map = {}
        
        for item in items:
            item_id = item['id']
            parent_id = item['parent']
            
            self._id_to_item[item_id] = item
            
            if parent_id not in self._children_map:
                self._children_map[parent_id] = []
            self._children_map[parent_id].append(item)

    def getAll(self):
        """Возвращает изначальный массив элементов."""
        return self._items

    def getItem(self, id):
        """Возвращает сам объект элемента или None, если он не найден."""
        return self._id_to_item.get(id)

    def getChildren(self, id):
        """
        Возвращает массив прямых дочерних элементов.
        Если у элемента нет детей, возвращает пустой список.
        """
        # Используем .get() чтобы избежать KeyError, 
        # но ищем именно среди детей текущего ID, а не "root"
        return self._children_map.get(id, [])

    def getAllParents(self, id):
        """
        Возвращает массив из цепочки родительских элементов,
        начиная от непосредственного родителя переданного элемента
        и заканчивая корневым элементом.
        Порядок важен: ближайший родитель идет первым.
        """
        path = []
        current_item = self._id_to_item.get(id)
        
        # Поднимаемся вверх по дереву, пока есть текущий узел и у него определен родитель
        while current_item is not None and current_item['parent'] != 'root':
            parent_id = current_item['parent']
            parent_item = self._id_to_item.get(parent_id)
            
            # Защита от разорванных ссылок (если родителя физически нет в массиве)
            if parent_item is None:
                break
                
            path.append(parent_item)
            current_item = parent_item
            
        return path


