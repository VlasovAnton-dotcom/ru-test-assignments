import rq
from django.conf import settings
from django.core.files.base import ContentFile
from .models import Check

@rq.job
def render_pdf(check_id):
    from weasyprint import HTML
    check = Check.objects.get(id=check_id)
    template_name = f'checks/{check.type}_check.html'
    html_content = render_to_string(template_name, {'order': check.order})
    pdf_file = HTML(string=html_content).write_pdf()
    filename = check.generate_filename()
    check.pdf_file.save(filename, ContentFile(pdf_file))
    check.status = 'rendered'
    check.save()
