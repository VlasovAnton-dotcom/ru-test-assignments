import uuid
from django.db import models

class Check(models.Model):
    printer_id = models.ForeignKey(Printer, on_delete=models.CASCADE)
    TYPE_CHOICES = [
        ('kitchen', 'Kitchen'),
        ('client', 'Client')
    ]
    type = models.CharField(choices=TYPE_CHOICES, default='kitchen')
    order = models.JSONField()
    STATUS_CHOICES = [
        ('new', 'New'),
        ('rendered', 'Rendered'),
        ('printed', 'Printed')
    ]
    status = models.CharField(choices=STATUS_CHOICES, default='new')
    pdf_file = models.FileField(upload_to='media/pdf/')
    
    def generate_filename(self):
        return f"{uuid.uuid4()}_{self.type}.pdf"

