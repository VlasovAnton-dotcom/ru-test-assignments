from fastapi import FastAPI, HTTPException, Depends
from app.utils import encrypt, decrypt
from app.schemas import SecretCreate, SecretResponse
from pydantic import BaseModel
import time

app = FastAPI()

class SecretDB:
    def __init__(self):
        # Initialize database connection
        pass

    async def generate(self, secret: str, passphrase: str):
        # Encrypt secret and create key
        encrypted_secret = encrypt(secret)
        secret_key = str(time.time()) + str(encrypted_secret)
        return secret_key

    async def get_secret(self, secret_key: str, passphrase: str):
        # Decrypt and validate
        try:
            decrypted_secret = decrypt(secret_key)
            if decrypted_secret == passphrase:
                return decrypted_secret
            else:
                raise HTTPException(status_code=400, detail="Invalid passphrase")
        except Exception as e:
            raise HTTPException(status_code=500, detail=f"Error: {e}")

# Dependency
def get_secret_db():
    return SecretDB()

@app.post("/generate", response_model=SecretResponse)
async def create_secret(secret: SecretCreate, db: SecretDB):
    secret_key = await db.generate(secret.secret, secret.passphrase)
    return {"secret_key": secret_key}

@app.get("/secrets/{secret_key}", response_model=SecretResponse)
async def get_secret(secret_key: str, passphrase: str, db: SecretDB):
    secret = await db.get_secret(secret_key, passphrase)
    return secret
