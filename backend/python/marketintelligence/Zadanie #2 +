utils.py:

python
import os
from cryptography.fernet import Fernet

def encrypt(secret):
    key = Fernet(os.environ.get('SECRET_KEY'))
    return key.encrypt(secret.encode())

def decrypt(secret_key):
    key = Fernet(os.environ.get('SECRET_KEY'))
    return key.decrypt(secret_key.encode()).decode()
