import json
import aiohttp
from typing import List
from .core import traverse_spiral_counterclockwise, MatrixFormatError

async def get_matrix(url: str) -> List[int]:
    """
    Asynchronously fetches a square matrix from a remote URL and returns its 
    counter-clockwise spiral traversal.

    :param url: HTTP(S) URL or file URL pointing to the matrix data.
    :return: List of integers representing the spiral traversal.
    :raises aiohttp.ClientError: For network-related issues (timeout, connection refused).
    :raises aiohttp.ClientResponseError: For HTTP 4xx/5xx status codes.
    :raises MatrixFormatError: If the fetched data is not a valid square matrix.
    :raises ValueError: If the response body is empty.
    """
    timeout = aiohttp.ClientTimeout(total=10)
    
    async with aiohttp.ClientSession(timeout=timeout) as session:
        try:
            async with session.get(url) as response:
                response.raise_for_status()
                
                # Attempt to parse as JSON first
                content_type = response.headers.get('Content-Type', '')
                if 'application/json' in content_type:
                    data = await response.json()
                else:
                    # Fallback to plain text parsing
                    text = await response.text()
                    if not text.strip():
                        raise ValueError("Response body is empty.")
                    
                    # Robust parsing: try JSON array, then line-by-line split
                    try:
                        data = json.loads(text)
                    except json.JSONDecodeError:
                        data = [line.strip().split() for line in text.strip().split('\n') if line.strip()]

                # Validate and convert to List[List[int]]
                if not isinstance(data, list) or not data:
                    raise MatrixFormatError("Matrix data must be a non-empty list.")
                
                matrix: List[List[int]] = []
                for row in data:
                    if isinstance(row, list):
                        matrix.append([int(x) for x in row])
                    else:
                        # Handle case where matrix was parsed as List[str] from text split
                        matrix.append([int(x) for x in str(row).split()])

                return traverse_spiral_counterclockwise(matrix)

        except (aiohttp.ClientError, asyncio.TimeoutError) as e:
            raise aiohttp.ClientError(f"Network or server error occurred while fetching {url}: {e}") from e
        except (ValueError, TypeError) as e:
            raise MatrixFormatError(f"Failed to parse matrix data from {url}: {e}") from e
