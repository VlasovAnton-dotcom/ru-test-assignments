from typing import List

class MatrixFormatError(ValueError):
    """Raised when the input matrix is not square or is malformed."""
    pass

def traverse_spiral_counterclockwise(matrix: List[List[int]]) -> List[int]:
    """
    Traverses a square matrix in a counter-clockwise spiral starting from the top-left corner.
    
    :param matrix: Square matrix of integers.
    :return: List of integers in traversal order.
    """
    if not matrix or not matrix[0]:
        return []

    n = len(matrix)
    for row in matrix:
        if len(row) != n:
            raise MatrixFormatError("Input matrix must be square (NxN).")

    result: List[int] = []
    top, bottom = 0, n - 1
    left, right = 0, n - 1

    while top <= bottom and left <= right:
        # 1. Down along the left column
        for i in range(top, bottom + 1):
            result.append(matrix[i][left])
        
        # 2. Right along the bottom row
        for j in range(left + 1, right + 1):
            result.append(matrix[bottom][j])

        # 3. Up along the right column (if not a single row remaining)
        if top < bottom:
            for i in range(bottom - 1, top - 1, -1):
                result.append(matrix[i][right])

        # 4. Left along the top row (if not a single column remaining)
        if left < right:
            for j in range(right - 1, left, -1):
                result.append(matrix[top][j])

        top += 1
        bottom -= 1
        left += 1
        right -= 1

    return result
