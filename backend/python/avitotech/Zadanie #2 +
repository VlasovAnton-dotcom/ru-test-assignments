import asyncio
import pytest
from async_spiral_matrix import get_matrix, MatrixFormatError

SOURCE_URL = './backend/Python/AvitoTech/matrix.txt'
TRAVERSAL = [
    10, 50, 90, 130,
    140, 150, 160, 120,
    80, 40, 30, 20,
    60, 100, 110, 70,
]

INVALID_MATRIX_URL = "https://example.com/invalid.json"
TIMEOUT_URL = "http://10.255.255.1" # Non-routable IP for timeout simulation

@pytest.mark.asyncio
async def test_get_matrix_success():
    result = await get_matrix(SOURCE_URL)
    assert result == TRAVERSAL

@pytest.mark.asyncio
async def test_get_matrix_empty():
    # Assuming empty.txt exists and is empty
    with pytest.raises(ValueError):
        await get_matrix("file://./tests/fixtures/empty.txt")

@pytest.mark.asyncio
async def test_get_matrix_non_square():
    # Assuming non_square.json exists: [[1, 2], [3, 4], [5, 6]]
    with pytest.raises(MatrixFormatError):
        await get_matrix("file://./tests/fixtures/non_square.json")

@pytest.mark.asyncio 
async def test_get_matrix_http_error():
    with pytest.raises(Exception):
        await get_matrix(INVALID_MATRIX_URL)

@pytest.mark.asyncio
async def test_get_matrix_timeout():
    with pytest.raises(Exception):
        await get_matrix(TIMEOUT_URL)
