]
Реализуем асинхронный обработчик в views.py:
from rest_framework.response import Response
from rest_framework.views import APIView
from channels.db import database_sync_to_async
import aiohttp

class GetEmployeesView(APIView):
    async def get(self, request, *args, **kwargs):
        try:
            employees = await fetch_employees_from_1c()
            return Response({'employees': employees})
        except Exception as e:
            return Response({'error': str(e)}, status=500)

async def fetch_employees_from_1c():
    payload = {
        "Request_id": REQUEST_ID,
        "ClubId": CLUB_ID,
        "Method": "GetSpecialistList",
        "Parameters": {"ServiceId": ""},
    }

    headers = {'Content-Type': 'application/json'}
    auth = aiohttp.BasicAuth(login=EXTERNAL_SYSTEM_AUTH[0], password=EXTERNAL_SYSTEM_AUTH[1])

    async with aiohttp.ClientSession(auth=auth) as session:
        async with session.post(EXTERNAL_SYSTEM_URL, json=payload, headers=headers) as response:
            if response.status != 200:
                raise ValueError(f"Ошибка при получении данных: {response.status}")
            data = await response.json()
            employees = transform_employee_data(data.get('Result'))
            return employees

def transform_employee_data(raw_data):
    transformed_employees = []
    for emp in raw_data['Items']:
        employee = {
            'id': emp.get('Id', ''),
            'name': emp.get('Name', ''),
            'last_name': emp.get('LastName', ''),
            'phone': emp.get('Phone', ''),
            'image_url': emp.get('ImageUrl', '')
        }
        transformed_employees.append(employee)
    return transformed_employees
3. Деплой и предоставление ссылок
Для деплоя можно использовать Heroku или аналогичный облачный хостинг. После деплоя предоставляется:
•	Адрес админки: <адрес>/admin
•	Логин и пароль к админке
•	Ссылка на API-запрос: <адрес>/api/team/get_employees/
•	Репозиторий с кодом: <репозиторий>
4. Документация и рекомендации
•	Используйте .env файл для хранения секретных данных (пароли, ключи API и т.д.).
•	Настройте CI/CD пайплайн для автоматического деплоя новых версий.
•	Следите за производительностью и масштабируемостью, особенно при увеличении нагрузки.
