3. Реализация REST API

3.1 Метод /api/find-bus
Метод принимает два параметра: начальную и конечную остановки. На основании этих данных возвращается три ближайших рейса автобусов, следующих по данному маршруту.
Алгоритм обработки запроса:
1.	Проверяется наличие указанных остановок в базе данных.
2.	Определяются возможные маршруты, проходящие через обе остановки.
3.	Извлекаются ближайшие отправки автобусов по найденным маршрутам.
4.	Данные возвращаются клиенту в формате JSON.
php
Копировать
// Пример реализации контроллера
class BusController extends Controller
{
    public function findBus(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'from' => ['required'],
            'to' => ['required']
        ]);
    
        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }
        
        $fromStopId = Stop::where('name', $request->input('from'))->firstOrFail()->id;
        $toStopId = Stop::where('name', $request->input('to'))->firstOrFail()->id;
    
        $routes = Route::with('schedules')
                      ->whereHas('stops', function ($query) use ($fromStopId, $toStopId) {
                          $query->whereIn('id', [$fromStopId, $toStopId]);
                      })
                      ->get();
    
        $result = [];
        foreach ($routes as $route) {
            $schedule = Schedule::where('route_id', $route->id)
                               ->orderBy('departure_time')
                               ->limit(3)
                               ->get();
            
            $result[] = [
                'route' => $route->number . ' (' . $route->direction . ')',
                'next_arrivals' => $schedule->pluck('departure_time')->values()->toArray(),
            ];
        }
    
        return response()->json([
            'from' => $request->input('from'),
            'to' => $request->input('to'),
            'buses' => $result
        ], 200);
    }
} ([Laravel](https://laravel.com/docs))

